[Unit]
Description=SignalK Updater Server
Wants=network-online.target
After=network-online.target

[Container]
Image=ghcr.io/dirkwa/signalk-updater-server:latest
ContainerName=signalk-updater-server
# PublishPort host is templated by install.sh: defaults to 127.0.0.1
# (localhost only). Set SIGNALK_LAN_EXPOSE=true on the installer command
# line to bind 0.0.0.0 and expose the Updater Console on the LAN.
# Bearer-token auth (CC-2) still applies; any LAN client must read
# ~/.signalk-updater/token to make mutating calls.
PublishPort=__PUBLISH_HOST__:3003:3003

Volume=%h/.signalk-updater:/data:Z
Volume=%h/.config/containers/systemd:/quadlets:Z
Volume=%t/podman/podman.sock:/var/run/docker.sock
Volume=%t/bus:/host/dbus:ro
Volume=%h/.signalk-doctor:/doctor-data:rw,Z
# Optional read-only view of backup snapshots metadata
# Volume=%h/.signalk-backup:/backup:ro,Z

Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/host/dbus
Environment=QUADLET_DIR=/quadlets
Environment=DOCTOR_DATA=/doctor-data
Environment=NODE_ENV=production
Environment=LOG_LEVEL=info

Label=io.signalk.persistent=true
Label=io.signalk.role=updater

[Service]
Restart=on-failure
RestartSec=10
TimeoutStartSec=120
StartLimitIntervalSec=300
StartLimitBurst=5

[Install]
WantedBy=default.target
