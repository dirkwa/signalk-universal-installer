[Unit]
Description=SignalK Updater Server
# podman.socket is bind-mounted at %t/podman/podman.sock; without
# Wants/After, systemd may start this unit before the socket exists
# and `podman run -v ...` exits 125 with `statfs: no such file or
# directory`. The installer enables podman.socket once; this keeps
# ordering correct across reboots and manual socket-unit cycles.
Wants=podman.socket
After=podman.socket
# Crashloop guard. Belongs in [Unit] — systemd silently ignores these
# keys when placed in [Service]. After 5 starts in 5 minutes the unit
# goes to `failed` instead of looping forever.
StartLimitIntervalSec=300
StartLimitBurst=5

# Suppress Quadlet's implicit network-readiness dependency. podman 5.x
# adds a Wants/After on its user-session network-wait shim to EVERY
# generated user unit unconditionally. That shim loops
# `until systemctl is-active <net target>; sleep 0.5; done`, and because a
# user session never activates that target it blocks unit start until its
# 90s timeout while flooding the journal with `sh[NNNN]: inactive` on any
# host where the system network hasn't settled yet (fresh VMs especially).
# DefaultDependencies=false (the [Quadlet]-section key, per
# podman-systemd.unit(5)) is the documented suppression. NOTE: do NOT name
# the shim service verbatim anywhere in this file — the generator scans the
# source text and re-injects the dependency if it sees that string, undoing
# this. This container reaches signalk-server over pasta's
# host.containers.internal and retries its health probe on its own, so the
# wait buys nothing here.
[Quadlet]
DefaultDependencies=false

[Container]
Image=__UPDATER_IMAGE__
ContainerName=signalk-updater-server
# PublishPort host is templated by install.sh: defaults to 0.0.0.0
# (LAN-reachable; most users install headless and reach the console
# from another machine). Set SIGNALK_LOCALHOST_ONLY=true on the
# installer command line to bind 127.0.0.1 only. Bearer-token auth
# (CC-2) gates mutating endpoints regardless of bind address; any
# LAN client must read ~/.signalk-updater/token.
PublishPort=__PUBLISH_HOST__:3003:3003

Volume=%h/.signalk-updater:/data:Z
Volume=%h/.config/containers/systemd:/quadlets:Z
Volume=%t/podman/podman.sock:/var/run/docker.sock
Volume=%t/bus:/host/dbus:ro
Volume=%h/.signalk-doctor:/doctor-data:rw,Z
# Optional read-only view of backup snapshots metadata
# Volume=%h/.signalk-backup:/backup:ro,Z

Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/host/dbus
Environment=QUADLET_DIR=/quadlets
Environment=DOCTOR_DATA=/doctor-data
Environment=NODE_ENV=production
Environment=LOG_LEVEL=info
# signalk-server runs with Network=host, so it listens on the host's
# 127.0.0.1:__SK_HTTP_PORT__ (80 or 3000, chosen at install time). This
# container runs on pasta networking where 127.0.0.1 is its own
# loopback, not the host's — making the engine's previous default
# unreachable. `host.containers.internal` is podman's host alias and
# resolves correctly under pasta. signalk-updater-server 0.6.9+ has a
# runtime fallback that auto-detects this; pinning the port here (sed'd
# by the installer) makes the boundary explicit and survives any future
# code-default churn.
Environment=SIGNALK_HEALTH_URL=http://host.containers.internal:__SK_HTTP_PORT__/signalk
Environment=SIGNALK_URL=http://host.containers.internal:__SK_HTTP_PORT__
# signalk-doctor-server runs its own pasta network and publishes
# 0.0.0.0:3004. From this container, 127.0.0.1:3004 is OUR loopback,
# not the host's :3004 — same pasta-net trap that hit signalk-server.
# Pin the doctor's health endpoint to the explicit host alias so the
# post-doctor-switch health-poll, the update-checker's RuntimeIdentity
# probe, and /api/state's doctor read all reach the right place.
# Engine 0.6.12+ has the runtime fallback; pinning here is the
# explicit form for fresh installs.
Environment=DOCTOR_HEALTH_URL=http://host.containers.internal:3004/api/health

Label=io.signalk.persistent=true
Label=io.signalk.role=updater

[Service]
Restart=on-failure
RestartSec=10
TimeoutStartSec=120

[Install]
WantedBy=default.target
