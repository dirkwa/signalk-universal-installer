[Unit]
Description=SignalK Server
# podman.socket is bind-mounted at %t/podman/podman.sock so consumer
# plugins (signalk-container) can reach the host daemon. Without
# Wants/After=podman.socket, systemd may start this unit before the
# socket exists and `podman run -v ...` exits 125 with `statfs: no
# such file or directory`. The installer enables podman.socket once;
# this keeps ordering correct across reboots and manual socket-unit
# cycles.
Wants=network-online.target podman.socket signalk-updater-server.service signalk-doctor-server.service
After=network-online.target podman.socket signalk-updater-server.service signalk-doctor-server.service
# Crashloop guard. Belongs in [Unit] — systemd silently ignores these
# keys when placed in [Service], which is how they got dropped on the
# 0.5.x installs (journal logged `Unknown key 'StartLimitIntervalSec'
# in section [Service], ignoring.` and the unit retried forever).
# After 5 starts in 5 minutes the unit goes to `failed`.
StartLimitIntervalSec=300
StartLimitBurst=5

[Container]
Image=ghcr.io/dirkwa/signalk-server:dirkwa
ContainerName=signalk-server
Network=host

# Map the host invoking user to in-container UID 1000 (the `node`
# user the signalk-server image runs as) so the ~/.signalk bind mount
# is owned by `node` from inside the container.
#
# Bare `keep-id` only works when the host user is also UID 1000. On
# hosts where the user was created after `pi` already claimed 1000
# (so the SignalK user is 1001 or higher), bare keep-id leaves the
# in-container `node` mapped to some unrelated subuid that can't
# write to host-UID-1001's ~/.signalk (mode 0700). That manifests as
# silent enableSecurity / plugin-install failures on the admin UI.
#
# The explicit form maps the host user → in-container UID 1000
# regardless of the host UID; on a host where the user already is
# UID 1000 it's an identity mapping (no-op).
UserNS=keep-id:uid=1000,gid=1000

Volume=%h/.signalk:/home/node/.signalk:Z
Volume=%t/podman/podman.sock:/var/run/docker.sock

Environment=SIGNALK_NODE_CONF_DIR=/home/node/.signalk

# Cut podman's SIGTERM → SIGKILL grace from the default 10s to 5s.
# signalk-server doesn't trap SIGTERM (no handler in bin/signalk-server
# upstream), so the full grace is dead time on every version switch
# regardless. Until upstream lands a graceful shutdown handler, 5s is
# enough for the kernel to deliver SIGTERM, Node to ignore it, and
# podman to follow up with SIGKILL — without making the user wait
# the full 10s. Maps to podman's --stop-timeout flag.
StopTimeout=5

Label=io.signalk.managed-by=updater
Label=io.signalk.role=server

# === BEGIN USER ADDITIONS ===
# Hand-edits below this line are preserved across version switches and
# hardware-apply rewrites. Add custom mounts, capabilities, or environment
# variables here. The updater preserves everything between the BEGIN/END
# markers verbatim.
# === END USER ADDITIONS ===

# === BEGIN HARDWARE (managed by signalk-universal-installer) ===
# AddDevice= lines below this block are rendered from
# ~/.signalk-updater/hardware.json by render-server-quadlet.sh and
# /api/hardware/apply. Do not edit by hand.
# === END HARDWARE ===

[Service]
# Restart=always rather than on-failure: the SignalK admin UI's "Restart"
# button calls process.exit(0) on the server, which is a CLEAN exit
# (status=0/SUCCESS). Restart=on-failure would not bring it back, and
# the user would be stranded with a stopped unit. The crashloop guard
# (StartLimitIntervalSec/StartLimitBurst, in [Unit] above) still kicks
# in for genuine failure loops — after 5 starts in 5 minutes the unit
# goes to `failed` state and stays there.
Restart=always
RestartSec=10
TimeoutStartSec=180

[Install]
WantedBy=default.target
