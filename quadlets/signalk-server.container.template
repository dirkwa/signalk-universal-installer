[Unit]
Description=SignalK Server
# podman.socket is bind-mounted at %t/podman/podman.sock so consumer
# plugins (signalk-container) can reach the host daemon. Without
# Wants/After=podman.socket, systemd may start this unit before the
# socket exists and `podman run -v ...` exits 125 with `statfs: no
# such file or directory`. The installer enables podman.socket once;
# this keeps ordering correct across reboots and manual socket-unit
# cycles.
Wants=podman.socket signalk-updater-server.service signalk-doctor-server.service
After=podman.socket signalk-updater-server.service signalk-doctor-server.service
# Crashloop guard. Belongs in [Unit] — systemd silently ignores these
# keys when placed in [Service], which is how they got dropped on the
# 0.5.x installs (journal logged `Unknown key 'StartLimitIntervalSec'
# in section [Service], ignoring.` and the unit retried forever).
#
# Interval widened to 1800s to match TimeoutStartSec=300 below. On an
# SD-card host `podman run --replace` can take the full start timeout to
# create the container under I/O contention; a failed attempt then costs
# up to TimeoutStartSec + RestartSec = 310s. For the guard to allow all
# BURST=5 genuine (slow-but-eventually-good) attempts before declaring
# `failed`, the window must exceed (5-1)×310 = 1240s — rounded to 1800s
# (30 min). A real crashloop exits in seconds, so it still trips the
# guard long before 30 min; the wider window only stops penalizing a
# slow-but-recovering start, it does not weaken genuine-failure detection.
StartLimitIntervalSec=1800
StartLimitBurst=5

# Suppress Quadlet's implicit network-readiness dependency. podman 5.x
# adds a Wants/After on its user-session network-wait shim to EVERY
# generated user unit unconditionally. That shim loops
# `until systemctl is-active <net target>; sleep 0.5; done`, and because a
# user session never activates that target it blocks unit start until its
# 90s timeout while flooding the journal with `sh[NNNN]: inactive` on any
# host where the system network hasn't settled yet (fresh VMs especially).
# DefaultDependencies=false (the [Quadlet]-section key, per
# podman-systemd.unit(5)) is the documented suppression. NOTE: do NOT name
# the shim service verbatim anywhere in this file — the generator scans the
# source text and re-injects the dependency if it sees that string, undoing
# this. This unit runs Network=host and binds the host's already-up
# interfaces directly, so the wait buys nothing here.
[Quadlet]
DefaultDependencies=false

[Container]
Image=ghcr.io/dirkwa/signalk-server:dirkwa
ContainerName=signalk-server
Network=host

# Map the host invoking user to in-container UID 1000 (the `node`
# user the signalk-server image runs as) so the ~/.signalk bind mount
# is owned by `node` from inside the container.
#
# Bare `keep-id` only works when the host user is also UID 1000. On
# hosts where the user was created after `pi` already claimed 1000
# (so the SignalK user is 1001 or higher), bare keep-id leaves the
# in-container `node` mapped to some unrelated subuid that can't
# write to host-UID-1001's ~/.signalk (mode 0700). That manifests as
# silent enableSecurity / plugin-install failures on the admin UI.
#
# The explicit form maps the host user → in-container UID 1000
# regardless of the host UID; on a host where the user already is
# UID 1000 it's an identity mapping (no-op).
UserNS=keep-id:uid=1000,gid=1000

Volume=%h/.signalk:/home/node/.signalk:Z
Volume=%t/podman/podman.sock:/var/run/docker.sock

# Read-only view of the host's linger registry so signalk-container's
# Deployment Doctor can warn when linger gets disabled after install
# (without it, rootless podman — and every container with a restart
# policy — stays down after a headless reboot). The directory is
# guaranteed to exist before this unit ever starts: the installer's
# enable-linger step creates it, and systemd never removes it. No :Z —
# never relabel a host system directory.
Volume=/var/lib/systemd/linger:/var/lib/systemd/linger:ro

Environment=SIGNALK_NODE_CONF_DIR=/home/node/.signalk

# HTTP listen port. Rendered by the installer: 80 when the operator
# accepts standard web ports, else 3000. signalk-server reads the PORT
# env var ahead of settings.json (src/ports.ts). Binding a port < 1024
# works because the installer lowers the HOST's
# net.ipv4.ip_unprivileged_port_start to 80 — the container shares the
# host network namespace (Network=host) and runs as a non-root user, so
# a Quadlet capability alone (CAP_NET_BIND_SERVICE) does NOT suffice:
# the cap lands in the bounding set but isn't effective for a non-root
# process, and a network sysctl can't be set from inside a host-netns
# container. The host sysctl is the only lever that works for this
# topology. HTTPS uses `sslport` from settings.json (seeded to 443 by
# the installer) — deliberately NOT the SSLPORT env var, because that
# force-enables TLS before a certificate exists.
Environment=PORT=__SK_HTTP_PORT__

# Cut podman's SIGTERM → SIGKILL grace from the default 10s to 5s.
# signalk-server doesn't trap SIGTERM (no handler in bin/signalk-server
# upstream), so the full grace is dead time on every version switch
# regardless. Until upstream lands a graceful shutdown handler, 5s is
# enough for the kernel to deliver SIGTERM, Node to ignore it, and
# podman to follow up with SIGKILL — without making the user wait
# the full 10s. Maps to podman's --stop-timeout flag.
StopTimeout=5

Label=io.signalk.managed-by=updater
Label=io.signalk.role=server

# === BEGIN USER ADDITIONS ===
# Hand-edits below this line are preserved across version switches and
# hardware-apply rewrites. Add custom mounts, capabilities, or environment
# variables here. The updater preserves everything between the BEGIN/END
# markers verbatim.
# === END USER ADDITIONS ===

# === BEGIN HARDWARE (managed by signalk-universal-installer) ===
# AddDevice= lines below this block are rendered from
# ~/.signalk-updater/hardware.json by render-server-quadlet.sh and
# /api/hardware/apply. Do not edit by hand.
# === END HARDWARE ===

[Service]
# Restart=always rather than on-failure: the SignalK admin UI's "Restart"
# button calls process.exit(0) on the server, which is a CLEAN exit
# (status=0/SUCCESS). Restart=on-failure would not bring it back, and
# the user would be stranded with a stopped unit. The crashloop guard
# (StartLimitIntervalSec/StartLimitBurst, in [Unit] above) still kicks
# in for genuine failure loops — after 5 starts in 30 minutes the unit
# goes to `failed` state and stays there.
Restart=always
RestartSec=10
# 300s (was 180): on an SD-card host `podman run --replace --rm` can take
# minutes just to CREATE the container under concurrent I/O (the cold plugin
# `npm install` runs in the same window) — observed timing out at 180s, getting
# SIGKILLed, then succeeding in ~3s on a calmer retry. 300s gives the create
# room to finish on the first attempt so a healthy install usually needs no
# retry at all. Not raised further — the `systemctl restart` blocks up to this
# long, so it's also a ceiling on how long the install can stall here.
TimeoutStartSec=300
# QuestDB (managed inside signalk-server) asks for 1048576 open files and
# risks WAL corruption with less. This unit-level request is the effective
# limit only because the installer raises the parent user@.service bounding
# limit to match (user@.service.d/nofile.conf); without that drop-in systemd
# silently clamps this to DefaultLimitNOFILE (524288).
LimitNOFILE=1048576

# Make signalk-server the preferred OOM victim so memory pressure spares the
# recovery surface (the doctor + updater consoles). On a low-RAM Pi a cold
# first boot can pin RAM — observed signalk-server peaking ~1.1G and getting
# OOM-killed (exit 137) while the doctor's probe/bug-report calls, proxied
# THROUGH the dying server, returned a storm of 502s. signalk-server carries
# Restart=always (above) and self-recovers in seconds; the doctor and updater
# do not, and losing them is losing the recovery surface exactly when it is
# needed. A HIGHER oom_score_adj means killed FIRST, so floating this unit
# above its siblings (which stay at whatever the user manager hands down) lets
# the kernel sacrifice the self-healing server instead of the recovery consoles.
#
# This is a plain systemd [Service] property, NOT a Quadlet [Container] key:
# podman 5.4.2's Quadlet generator has no OOMScoreAdjust → --oom-score-adj
# mapping, but systemd applies the [Service] value to the unit cgroup and the
# conmon → crun → container PID 1 chain inherits it (verified: a unit showing
# OOMScoreAdjust=N has its container payload at /proc/<pid>/oom_score_adj=N).
# Positive-only by necessity: under rootless podman a process can only RAISE
# its oom_score_adj, never lower it, so protecting the doctor/updater with a
# negative score would be silently clamped back up — raising the server is the
# only direction that actually reorders the kill preference.
OOMScoreAdjust=500

[Install]
WantedBy=default.target
