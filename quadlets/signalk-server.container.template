[Unit]
Description=SignalK Server
Wants=network-online.target signalk-updater-server.service signalk-doctor-server.service
After=network-online.target signalk-updater-server.service signalk-doctor-server.service

[Container]
Image=ghcr.io/dirkwa/signalk-server:latest
ContainerName=signalk-server
Network=host

# Keep the host user's uid/gid inside the container rather than mapping
# them through subuids. The signalk-server image runs as `node` (uid
# 1000); on the typical host the invoking user is also uid 1000. With
# keep-id, container uid 1000 == host uid 1000, so the ~/.signalk
# bind-mount is writable from inside (otherwise the userns remap puts
# the in-container `node` user in a subuid range that can't write to
# host-uid-1000-owned files, and `enableSecurity` etc. fail with 500).
UserNS=keep-id

Volume=%h/.signalk:/home/node/.signalk:Z
Volume=%t/podman/podman.sock:/var/run/docker.sock

Environment=SIGNALK_NODE_CONF_DIR=/home/node/.signalk

Label=io.signalk.managed-by=updater
Label=io.signalk.role=server

# === BEGIN USER ADDITIONS ===
# Hand-edits below this line are preserved across version switches and
# hardware-apply rewrites. Add custom mounts, capabilities, or environment
# variables here. The updater preserves everything between the BEGIN/END
# markers verbatim.
# === END USER ADDITIONS ===

# === BEGIN HARDWARE (managed by signalk-universal-installer) ===
# AddDevice= lines below this block are rendered from
# ~/.signalk-updater/hardware.json by render-server-quadlet.sh and
# /api/hardware/apply. Do not edit by hand.
# === END HARDWARE ===

[Service]
# Restart=always rather than on-failure: the SignalK admin UI's "Restart"
# button calls process.exit(0) on the server, which is a CLEAN exit
# (status=0/SUCCESS). Restart=on-failure would not bring it back, and
# the user would be stranded with a stopped unit. The crashloop guard
# below (StartLimitIntervalSec + StartLimitBurst) still kicks in for
# genuine failure loops — after 5 starts in 5 minutes the unit goes to
# `failed` state and stays there.
Restart=always
RestartSec=10
TimeoutStartSec=180
StartLimitIntervalSec=300
StartLimitBurst=5

[Install]
WantedBy=default.target
