[Unit]
Description=SignalK Doctor Server
# podman.socket is bind-mounted at %t/podman/podman.sock; without
# Wants/After, systemd may start this unit before the socket exists
# and `podman run -v ...` exits 125 with `statfs: no such file or
# directory`. The installer enables podman.socket once; this keeps
# ordering correct across reboots and manual socket-unit cycles.
Wants=network-online.target podman.socket
After=network-online.target podman.socket
# Crashloop guard. Belongs in [Unit] — systemd silently ignores these
# keys when placed in [Service]. After 5 starts in 5 minutes the unit
# goes to `failed` instead of looping forever.
StartLimitIntervalSec=300
StartLimitBurst=5

[Container]
Image=ghcr.io/dirkwa/signalk-doctor-server:latest
ContainerName=signalk-doctor-server
# PublishPort host is templated by install.sh: defaults to 127.0.0.1
# (localhost only). Set SIGNALK_LAN_EXPOSE=true on the installer command
# line to bind 0.0.0.0 and expose the Doctor Console on the LAN.
# Doctor's read-only probes are unauthenticated; only the /api/recover
# endpoints require the bearer token (~/.signalk-doctor/token).
PublishPort=__PUBLISH_HOST__:3004:3004

Volume=%h/.signalk-doctor:/data:Z
Volume=%h/.config/containers/systemd:/quadlets:Z
Volume=%t/podman/podman.sock:/var/run/docker.sock
Volume=%t/bus:/host/dbus:ro
# Read access to the updater's data dir for the shared operation.lock
Volume=%h/.signalk-updater:/updater-data:rw,Z

Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/host/dbus
Environment=QUADLET_DIR=/quadlets
Environment=DATA_DIR=/data
Environment=LOCK_DIR=/updater-data
Environment=NODE_ENV=production
Environment=LOG_LEVEL=info

Label=io.signalk.persistent=true
Label=io.signalk.role=doctor

[Service]
Restart=on-failure
RestartSec=10
TimeoutStartSec=120

[Install]
WantedBy=default.target
