#!/usr/bin/env bash
# signalk-recovery — host-resident SignalK safety net.
# Installed by signalk-universal-installer. Does not depend on any
# container being running; talks only to ~/.config/containers/systemd/
# and `systemctl --user`. Usage:
#
#   signalk-recovery status            — show current and last-good tags
#   signalk-recovery rollback-server   — restore signalk-server quadlet
#   signalk-recovery rollback-updater  — restore updater quadlet
#   signalk-recovery rollback-doctor   — restore doctor quadlet
#   signalk-recovery rollback-all      — restore all three
#   signalk-recovery doctor            — print diagnostics dump
#   signalk-recovery unwedge-podman    — clear a stuck c/storage lock

set -euo pipefail

QUADLET_DIR="${HOME}/.config/containers/systemd"
SNAP_DIR="${HOME}/.signalk-doctor/snapshots"
LAST_GOOD="${HOME}/.signalk-doctor/last-good.json"

QUADLETS=(signalk-server signalk-updater-server signalk-doctor-server)

# Seconds to wait for any podman command before calling it wedged. Every podman
# invocation in this script is guarded: the failure mode below blocks them
# forever, and a recovery tool that hangs is worse than useless.
PODMAN_TIMEOUT=${PODMAN_TIMEOUT:-15}

# How long to wait after SIGTERM before sending SIGKILL. This is NOT belt and
# braces: a podman wedged on the c/storage lock is spinning in kernel space and
# does NOT respond to SIGTERM — plain `timeout` returns while the process keeps
# burning a core. Without the follow-up kill, every guarded probe (and every
# re-run of this script) leaks another spinning podman onto an already-sick box.
PODMAN_KILL_AFTER=${PODMAN_KILL_AFTER:-5}

# How far back to scan the journal for podman's incomplete-layer marker. The
# wedge is live *now*, so the line is recent, and an unbounded read of a busy
# journal costs minutes on an SD card — the opposite of what a recovery tool
# should do. Widen it for a host that sat wedged longer than this. The layer
# store (jq path below) carries no time bound at all.
UNWEDGE_SINCE=${UNWEDGE_SINCE:--7 days}

# Read one TOML key out of a storage.conf. Values are quoted strings per the
# format; last assignment in the file wins.
storage_conf_value() {
    local file=$1 key=$2
    [[ -r "$file" ]] || return 1
    sed -n "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$file" \
        | tail -1
}

# Expand the couple of variables podman itself expands inside a config value,
# and supply the rootless default when nothing was configured.
expand_store_path() {
    local root=$1
    root=${root//\$HOME/$HOME}
    root=${root//\$UID/$(id -u)}
    printf '%s' "${root:-${XDG_DATA_HOME:-$HOME/.local/share}/containers/storage}"
}

# Resolve podman's EFFECTIVE ROOTLESS store. Getting this wrong makes every
# unmount below a silent no-op, and this is the tool of last resort — so follow
# containers-storage.conf(5) rather than guessing. Asking `podman info` is not
# an option: by the time this runs, podman is the wedged thing.
#
# The trap, and why `graphroot` is NOT read from the system files: stock Debian
# and Pi OS ship /usr/share/containers/storage.conf carrying
# `graphroot = "/var/lib/containers/storage"`. That is the ROOTFUL store. A
# rootless podman ignores it — verified on a stock Pi 4, where podman reports
# ~/.local/share/containers/storage while that file says /var/lib. Honouring a
# system-level graphroot here would send this tool at the wrong store on a
# DEFAULT install, which is the exact silent failure the resolver exists to
# avoid.
#
# So: `rootless_storage_path` is the only key that carries from a system config
# (that is precisely what it is for). `graphroot` counts only from a user-level
# config — the user's own file, or one pinned via CONTAINERS_STORAGE_CONF —
# because there it really is this user's store. A user-level file replaces the
# system ones wholesale rather than merging with them.
default_storage_root() {
    local user_files=() sys_files=() f root=''
    if [[ -n "${CONTAINERS_STORAGE_CONF:-}" ]]; then
        user_files=("$CONTAINERS_STORAGE_CONF")
    else
        user_files=("${XDG_CONFIG_HOME:-$HOME/.config}/containers/storage.conf")
        sys_files=(/etc/containers/storage.conf /usr/share/containers/storage.conf)
    fi

    for f in "${user_files[@]}"; do
        [[ -r "$f" ]] || continue
        root=$(storage_conf_value "$f" rootless_storage_path || true)
        [[ -n "$root" ]] || root=$(storage_conf_value "$f" graphroot || true)
        # Present but silent on both keys still means "use the default" — it
        # replaced the system files, it did not defer to them.
        expand_store_path "$root"
        return
    done

    for f in "${sys_files[@]}"; do
        [[ -r "$f" ]] || continue
        root=$(storage_conf_value "$f" rootless_storage_path || true)
        [[ -n "$root" ]] && break
    done
    expand_store_path "$root"
}
STORAGE_ROOT=${STORAGE_ROOT:-$(default_storage_root)}

usage() {
    cat <<EOF
signalk-recovery — SignalK out-of-band recovery (no containers required).

Commands:
  status                   show current tags and last-known-good state
  rollback-server          restore signalk-server.container from last-known-good
  rollback-updater         restore signalk-updater-server.container from last-known-good
  rollback-doctor          restore signalk-doctor-server.container from last-known-good
  rollback-all             restore all three quadlets
  doctor                   dump systemd, podman, and last-error diagnostics
  unwedge-podman           clear a stuck c/storage lock (podman hangs forever);
                           accepts --dry-run to report without acting

Snapshots live under: $SNAP_DIR
Last-known-good index:  $LAST_GOOD
EOF
}

newest_snapshot() {
    local quadlet=$1
    # find + sort handles non-alphanumeric filenames safely (shellcheck SC2012).
    # %T@ %p prints mtime-since-epoch + path; sort -nr picks the newest first.
    find "$SNAP_DIR" -maxdepth 1 -type f -name "*-${quadlet}.container" \
        -printf '%T@ %p\n' 2>/dev/null \
        | sort -nr | head -1 | cut -d' ' -f2-
}

show_status() {
    echo "Quadlet directory:  $QUADLET_DIR"
    echo "Snapshot directory: $SNAP_DIR"
    echo "Last-good index:    $LAST_GOOD"
    echo
    for q in "${QUADLETS[@]}"; do
        local file="$QUADLET_DIR/${q}.container"
        local active
        active=$(systemctl --user is-active "${q}.service" 2>/dev/null || true)
        active=${active%%$'\n'*}
        [[ -z "$active" ]] && active="unknown"
        local image
        image=""
        if [[ -f "$file" ]]; then
            image=$(awk -F= '/^Image=/{print $2; exit}' "$file")
        fi
        local newest
        newest=$(newest_snapshot "$q" || true)
        printf '  %-28s active=%-12s image=%s\n' "$q" "$active" "${image:-<no quadlet>}"
        if [[ -n "$newest" ]]; then
            printf '  %-28s newest-snapshot=%s\n' "" "$newest"
        fi
    done
}

restore_one() {
    local quadlet=$1
    local src
    src=$(newest_snapshot "$quadlet" || true)
    if [[ -z "$src" ]]; then
        echo "no snapshot found for $quadlet" >&2
        return 1
    fi
    local target="$QUADLET_DIR/${quadlet}.container"
    local tmp="${target}.recover.$$"
    cp -p "$src" "$tmp"
    mv -f "$tmp" "$target"
    echo "restored: $quadlet (from $src)"
}

reload_and_restart() {
    local services=("$@")
    systemctl --user daemon-reload
    for s in "${services[@]}"; do
        systemctl --user try-restart "${s}.service" || true
    done
}

cmd_rollback_server() {
    restore_one signalk-server
    reload_and_restart signalk-server
}
cmd_rollback_updater() {
    restore_one signalk-updater-server
    reload_and_restart signalk-updater-server
}
cmd_rollback_doctor() {
    restore_one signalk-doctor-server
    reload_and_restart signalk-doctor-server
}
cmd_rollback_all() {
    local svcs=()
    for q in "${QUADLETS[@]}"; do
        # Plain if-then so a successful restore_one followed by a failing
        # svcs+= doesn't trip the C branch (shellcheck SC2015).
        if restore_one "$q"; then
            svcs+=("$q")
        fi
    done
    reload_and_restart "${svcs[@]}"
}

# --- podman unwedge --------------------------------------------------------
# Recovers a failure mode nothing else in the stack can, because everything else
# depends on the thing that is broken.
#
# A SIGKILL landing on `podman run` mid-container-create -- systemd's stop
# timeout firing during a version switch is the observed trigger -- leaves a
# layer flagged `incomplete` in c/storage with its overlayfs merged dir STILL
# MOUNTED. podman's own cleanup then recurses INTO that live mount; every unlink
# needs a whiteout, the orphaned workdir refuses (dmesg: `overlayfs: failed to
# lock workdir+upperdir`), and the cleanup spins forever holding c/storage's
# global lock. Every later podman command blocks behind it -- `podman ps`
# included -- so Restart=always cannot heal the host: the retry hangs too.
#
# Killing the API service alone is NOT enough. The stale mount lives in the
# podman-pause mount namespace that every conmon shares, so it outlives
# podman.service and the very next podman command re-enters the same spin.
# Dropping the mount is the actual fix; podman's own cleanup then completes on
# its next invocation and removes the layer.

podman_responds() {
    timeout -k "$PODMAN_KILL_AFTER" "$PODMAN_TIMEOUT" \
        podman ps --format '{{.Names}}' >/dev/null 2>&1
}

# Layer IDs podman itself has declared incomplete.
#
# SAFETY: this is the whole basis for unmounting anything. Both sources are
# written by podman at the moment it gives up on a layer, so neither can ever
# name the layer of a healthy running container -- which is what makes the
# unmount below safe to do unattended. Never widen this to "overlay mounts that
# look stale": unmounting a live container's merged dir breaks that container.
#
# The journal source stands alone on hosts without jq (it is optional per
# install.sh) and is sufficient by itself -- podman logs the ID immediately
# before the delete that wedges.
incomplete_layer_ids() {
    {
        # podman emits this in logfmt, so the ID's quotes arrive backslash-
        # escaped inside msg="...": `Found incomplete layer \"<id>\", deleting`.
        # Match the phrase, drop everything before it, then take the hex run --
        # matching a literal quote here silently finds nothing.
        journalctl --user --no-pager -o cat --since "$UNWEDGE_SINCE" 2>/dev/null \
            | grep -o 'Found incomplete layer.*' \
            | grep -oE '[0-9a-f]{12,}' || true
        if command -v jq >/dev/null 2>&1; then
            local f
            for f in "$STORAGE_ROOT/overlay-layers/layers.json" \
                     "$STORAGE_ROOT/overlay-layers/volatile-layers.json"; do
                [[ -r "$f" ]] || continue
                jq -r '.[]|select(.flags.incomplete)|.id' "$f" 2>/dev/null || true
            done
        fi
    } | sort -u
}

# Is this layer's merged dir mounted? It lives in the shared rootless namespace,
# so it is absent from our own /proc/self/mountinfo -- scan every readable
# process instead. -s swallows the races against processes that exit mid-scan.
layer_is_mounted() {
    grep -lsF "/overlay/${1}/merged" /proc/[0-9]*/mountinfo >/dev/null 2>&1
}

cmd_unwedge_podman() {
    # Validate rather than ignore. This command SIGKILLs a service and unmounts
    # filesystems; a typo ("--dryrun", "-n") silently falling through to the
    # real action is not an acceptable failure mode for a recovery tool.
    #
    # Count-based, not `case "${1:-}"`: that form cannot tell "no argument" from
    # an explicit empty one, and it says nothing about arguments past the first.
    # `signalk recover` execs this script with the user's whole argv, so trailing
    # arguments do reach here and must not be dropped in silence.
    local dry=0
    if [[ $# -gt 1 ]]; then
        echo "unwedge-podman: too many arguments (only --dry-run is accepted)" >&2
        return 1
    fi
    if [[ $# -eq 1 ]]; then
        case "$1" in
            --dry-run) dry=1 ;;
            *)
                echo "unwedge-podman: unknown argument '${1}' (expected --dry-run)" >&2
                return 1
                ;;
        esac
    fi

    echo "=== podman unwedge ==="
    if podman_responds; then
        echo "  podman answered within ${PODMAN_TIMEOUT}s — nothing to unwedge."
        return 0
    fi
    echo "  [!] podman did not answer in ${PODMAN_TIMEOUT}s — c/storage lock is held."

    local ids id
    local stale=()
    ids=$(incomplete_layer_ids)
    if [[ -z "$ids" ]]; then
        echo "  No incomplete layer in the journal or layer store — this is a"
        echo "  different fault and unwedge must not guess at it. Collect:"
        echo "    journalctl --user | grep -i 'incomplete layer'"
        echo "    dmesg | grep -i overlayfs"
        return 1
    fi

    while IFS= read -r id; do
        [[ -n "$id" ]] || continue
        if layer_is_mounted "$id"; then
            stale+=("$id")
            echo "  stale mount:   ${id:0:12}  (flagged incomplete, still mounted)"
        else
            echo "  already clear: ${id:0:12}"
        fi
    done <<< "$ids"

    if [[ ${#stale[@]} -eq 0 ]]; then
        echo "  No stale mounts remain, yet podman is still blocked. Try:"
        echo "    systemctl --user kill -s KILL podman.service"
        return 1
    fi

    if [[ $dry -eq 1 ]]; then
        echo "  --dry-run: would kill podman.service, then unmount ${#stale[@]} layer(s)."
        return 0
    fi

    # The spinning cleanup ignores SIGTERM -- it is looping in kernel space --
    # so SIGKILL is the only signal that lands. Running containers are
    # conmon-managed and independent of the API service; they survive this.
    echo "  killing the stuck API service (running containers are unaffected)"
    systemctl --user kill -s KILL podman.service 2>/dev/null || true

    for id in "${stale[@]}"; do
        echo "  unmounting ${id:0:12}"
        # Lazy: something may still hold a reference into the tree. `podman
        # unshare` joins the existing rootless namespace without taking the
        # storage lock, which is why it still works while podman is wedged.
        timeout -k "$PODMAN_KILL_AFTER" "$PODMAN_TIMEOUT" podman unshare \
            umount -l "$STORAGE_ROOT/overlay/${id}/merged" 2>/dev/null \
            || echo "  [WARN] could not unmount ${id:0:12}"
    done

    if podman_responds; then
        echo "  [OK] podman is responding again."
        echo "       Bring back anything left down:"
        echo "         systemctl --user reset-failed signalk-server.service"
        echo "         systemctl --user start signalk-server.service"
        return 0
    fi
    echo "  [FAIL] still blocked after unmounting. Escalate:"
    echo "         dmesg | grep -i overlayfs"
    echo "         a reboot clears every stale mount as the last resort."
    return 1
}

cmd_doctor() {
    echo "--- podman ps ---"
    # timeout-guarded: this is the SSH-only safety net, so it must still answer
    # when podman is the broken thing. An unguarded `podman ps` blocks forever
    # behind a stuck c/storage lock -- the exact fault an operator runs this
    # command to investigate -- and the dump never reaches the rest of its
    # sections. Name the condition and point at the fix instead.
    # -k is load-bearing, not defensive: a podman wedged on the storage lock
    # ignores SIGTERM, and timeout(1) then waits for the child anyway -- so a
    # plain `timeout` still hangs this dump for as long as podman feels like it.
    local rc=0
    timeout -k "$PODMAN_KILL_AFTER" "$PODMAN_TIMEOUT" podman ps -a \
        --format '{{.Names}}  {{.Status}}  {{.Image}}' 2>&1 || rc=$?
    if [[ $rc -eq 124 || $rc -eq 137 ]]; then
        echo "  [FAIL] podman did not answer within ${PODMAN_TIMEOUT}s —"
        echo "         c/storage lock held. Recover with:"
        echo "           signalk-recovery unwedge-podman"
    fi
    echo
    echo "--- systemd-user signalk-* units ---"
    systemctl --user list-units --all 'signalk-*' 2>&1 || true
    echo
    echo "--- journalctl --user signalk-* (last 30 lines each) ---"
    for s in "${QUADLETS[@]}"; do
        echo "[${s}]"
        journalctl --user -u "${s}.service" -n 30 --no-pager 2>&1 || true
        echo
    done
    echo "--- last-good.json ---"
    cat "$LAST_GOOD" 2>/dev/null || echo "(missing)"
}

main() {
    case "${1:-status}" in
        status)           show_status ;;
        rollback-server)  cmd_rollback_server ;;
        rollback-updater) cmd_rollback_updater ;;
        rollback-doctor)  cmd_rollback_doctor ;;
        rollback-all)     cmd_rollback_all ;;
        doctor)           cmd_doctor ;;
        unwedge-podman)   shift; cmd_unwedge_podman "$@" ;;
        -h|--help|help)   usage ;;
        *)                usage; exit 1 ;;
    esac
}

# Only dispatch when executed directly. When sourced (e.g. by the test harness
# to exercise incomplete_layer_ids against fixture journal output), define the
# functions but don't run anything. Same idiom as preflight.sh.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
