#!/usr/bin/env bash
# signalk — user-facing dispatcher for the SignalK container stack.
# Installed by signalk-universal-installer.
#
# Usage:
#   signalk health         show stack health (containers, services, URLs)
#   signalk recover [...]  delegate to ~/.local/bin/signalk-recovery
#   signalk socketcan [..] Pi CAN-HAT detection + setup recipe
#   signalk bluetooth [..] BLE / D-Bus passthrough (status | enable | disable)
#   signalk timesync [...] host clock + timezone from GPS (status | run)
#   signalk update [--no-render]        (SIGNALK_CHANNEL=master to track master)
#                          refresh installer scripts + Quadlet templates via the
#                          doctor, then re-render the live signalk-server Quadlet
#                          from the refreshed template (restarting the server only
#                          if the render changed). --no-render skips that last step.
#   signalk render-server [--no-restart]
#                          rebuild ~/.config/containers/systemd/signalk-server.container
#                          from the staged template + hardware.json and (unless
#                          --no-restart) restart signalk-server to apply it. Idempotent:
#                          no-ops when the live Quadlet already matches the render. Use
#                          it to pull in a template-only fix (e.g. Timezone=local) on an
#                          existing box without re-running the installer.
#   signalk resolv-watch [heal]
#                          no argument: (re)install the signalk-resolv-watch
#                          systemd user units — a path unit watching the host DNS
#                          configuration plus a oneshot that recreates
#                          signalk-server when DNS appeared only after the
#                          container started (boot beat DHCP). Idempotent;
#                          render-server runs it automatically. `heal` runs one
#                          probe-and-recover pass now (what the oneshot calls).
#   signalk resetadmin [user]
#                          reset (or create) an admin user's password for the
#                          Admin UI login (default user: admin). Prompts for the
#                          password, or reads SIGNALK_RESETADMIN_PASSWORD from the
#                          environment when set (used by the Windows shim, which
#                          has no TTY to prompt on inside the VM).
#   signalk bug-report [--to <dir>]
#                          bundle logs + state into <dir>/signalk-bug-report-*.tar.gz
#                          (default: /tmp)
#   signalk stop           stop signalk-server (the data plane) without
#                          uninstalling; the updater + doctor consoles stay up.
#                          Preserves all data/config/plugins and stays down
#                          across reboots until 'signalk start'. (On Windows this
#                          stops the whole VM instead.)
#   signalk start          start signalk-server again after 'signalk stop'
#   signalk restart        restart signalk-server (picks up config changes).
#                          Unlike stop/start this does not change whether the
#                          server comes back at boot.
#   signalk devpod [up|ssh|stop|delete|list]
#                          zero-setup dev environment (devcontainer, host
#                          networking). Browser IDE on http://<box>:10800,
#                          dev server on :4000 — both LAN-visible and
#                          UNAUTHENTICATED (docs/devcontainer.md for
#                          hardening via tailscale serve). Installs the
#                          pinned devpod CLI on first use.
#   signalk uninstall      stop services + remove Quadlets (preserves data)
#   signalk version        print installer version
#   signalk help           show this help

set -euo pipefail

SK_VERSION="__SK_VERSION__"

# Resolve signalk-server's HTTP port at RUN time from the rendered Quadlet
# (Environment=PORT=, written by the installer/doctor; 80 or 3000), rather
# than baking it in at install time. The doctor's installer-refresh rewrites
# this script byte-for-byte from GitHub Pages, where only __SK_VERSION__ is
# substituted — a baked __SK_HTTP_PORT__ placeholder would survive verbatim
# and break every URL built from it (the reason `signalk health` and
# `resetadmin` failed with "Port number was not a decimal number"). Reading
# the port live keeps the script self-correcting and tracks a later port
# change for free. Same lookup as scripts/doctor.sh::sk_http_port.
sk_http_port() {
    local q="${HOME}/.config/containers/systemd/signalk-server.container"
    local p
    # `|| true`: a missing Quadlet makes sed exit 2, which pipefail propagates.
    # Today both call sites wrap this in $(...) (where set -e is suspended), so
    # the ${p:-80} fallback applies; the guard keeps it correct even if called
    # bare as a statement.
    p=$(sed -n 's/^Environment=PORT=\([0-9][0-9]*\).*/\1/p' "$q" 2>/dev/null | head -1 || true)
    printf '%s' "${p:-80}"
}

UPDATER_URL=${UPDATER_URL:-http://127.0.0.1:3003}
DOCTOR_URL=${DOCTOR_URL:-http://127.0.0.1:3004}
SIGNALK_URL=${SIGNALK_URL:-http://127.0.0.1:$(sk_http_port)/signalk}
DOCTOR_DATA="${DOCTOR_DATA:-${HOME}/.signalk-doctor}"
QUADLET_DIR="${HOME}/.config/containers/systemd"
# signalk-dbus-proxy is conditional (written only on hosts with a system
# D-Bus); every UNITS consumer below tolerates a missing unit (`|| true`
# stops, journal/status captures, quadlet rm -f), so listing it
# unconditionally is safe and keeps uninstall + bug-report complete.
UNITS=(signalk-server signalk-updater-server signalk-doctor-server signalk-dbus-proxy)

# Turn an internal probe URL (always http://127.0.0.1:<port>...) into the URL
# we PRINT for the operator to open. Two transforms:
#   - host: when SIGNALK_PUBLIC_HOST is set (the Windows shim sets it to
#     "localhost", because the stack is reached from Windows over Podman
#     Machine's localhost port-forward and 127.0.0.1 is the VM's loopback, not
#     something the user should copy), swap 127.0.0.1 for it. Empty by default,
#     so Linux/macOS keep 127.0.0.1 (which works there for both probe and
#     display).
#   - port: drop a default :80 (http) / :443 (https) so the printed URL is the
#     clean "http://host/admin" the browser shows, not "http://host:80/admin".
# Probes themselves never go through this — they keep hitting 127.0.0.1:<port>
# inside the VM. Display only.
pub_url() {
    local u="$1"
    if [[ -n "${SIGNALK_PUBLIC_HOST:-}" ]]; then
        u="${u/\/\/127.0.0.1///${SIGNALK_PUBLIC_HOST}}"
    fi
    # Strip a default port that sits between the host and the path-or-end.
    u="${u/:80\//\/}"      # http://host:80/...  -> http://host/...
    u="${u%:80}"           # http://host:80      -> http://host
    u="${u/:443\//\/}"
    u="${u%:443}"
    printf '%s' "$u"
}

usage() {
    # Print the leading comment block (from line 2 up to the first non-comment
    # line — the `set -euo pipefail` that ends the header) as the help text.
    # Keying on "stop at the first non-# line" rather than a fixed line range
    # means adding a help entry never silently truncates the output. Under the
    # Windows shim (SIGNALK_WINDOWS_SHIM=1) drop the socketcan line — that
    # subcommand is a Pi CAN-HAT setup the Podman machine VM can't use, and the
    # Windows shim rejects it, so it shouldn't be advertised there. Keyed on the
    # dedicated shim flag, not SIGNALK_PUBLIC_HOST (a Linux/macOS user may set a
    # public host for URL display and must still see socketcan).
    local help
    help=$(sed -n '2,${/^#/!q;p}' "$0" | sed 's/^# \{0,1\}//')
    if [[ "${SIGNALK_WINDOWS_SHIM:-0}" == "1" ]]; then
        # bluetooth is filtered for the same reason as socketcan: host
        # bluez/D-Bus passthrough has no equivalent inside the Podman
        # machine VM. render-server too: there is no host signalk-server
        # Quadlet to render inside the VM.
        #
        # Some of these entries (render-server, update) span a header line
        # plus indented continuation lines, so a per-line `grep -v` on the
        # header would leave orphaned detail behind. Drop each matched entry
        # as a BLOCK: skip the "signalk <name>" header and every following
        # continuation line (a line that does NOT begin a new "signalk "
        # entry and is not the closing blank/plain line) until the next
        # top-level entry starts. Keyed on the leading-space indent the
        # continuation lines carry after the comment-prefix strip above.
        # Help lines are indented (a leading "  " after the comment-prefix
        # strip). A subcommand HEADER is "  signalk <name>"; CONTINUATION
        # lines are indented deeper and do not start a new "signalk" entry.
        printf '%s\n' "$help" | awk '
            /^[[:space:]]*signalk (socketcan|bluetooth|timesync|render-server|resolv-watch)( |$)/ { drop = 1; next }
            /^[[:space:]]*signalk / { drop = 0; print; next }
            drop { next }
            { print }
        '
    else
        printf '%s\n' "$help"
    fi
}

cmd_version() {
    echo "signalk $SK_VERSION"
}

# Probe a URL up to 3 times (5s each, ~2s apart) and report the last
# response time on stdout. Echoes "ok <seconds>" on a 2xx/3xx, or "fail".
# Retrying matters on a busy/SD-card host where a healthy engine can take a
# few seconds to answer — a single 5s one-shot mislabels that as down.
health_probe() {
    local url=$1 t
    local attempt
    for attempt in 1 2 3; do
        [[ $attempt -gt 1 ]] && sleep 2
        if t=$(curl -fsS -o /dev/null -m 5 -w '%{time_total}' "$url" 2>/dev/null); then
            echo "ok $t"
            return 0
        fi
    done
    echo "fail"
    return 1
}

cmd_health() {
    # Reachable but slower than this (seconds) reads as I/O contention, not a
    # clean bill of health — usually a microSD root (see 'signalk recover
    # doctor' → the Host root storage probe). An SSD removes it.
    local slow_secs=1.5
    local server_down=0
    echo "=== SignalK Stack Health ==="
    for entry in \
        "signalk-server  $SIGNALK_URL" \
        "updater (:3003) $UPDATER_URL/api/health" \
        "doctor (:3004)  $DOCTOR_URL/api/health"; do
        name=${entry% *}
        url=${entry##* }
        # Probe the internal URL (127.0.0.1 inside the VM); print the public one.
        disp=$(pub_url "$url")
        read -r status secs < <(health_probe "$url")
        if [[ "$status" != "ok" ]]; then
            printf '  [FAIL] %-20s %s\n' "$name" "$disp"
            [[ "$name" == signalk-server* ]] && server_down=1
        elif awk -v s="$secs" -v lim="$slow_secs" 'BEGIN{exit !(s>lim)}'; then
            printf '  [SLOW] %-20s %s  (%ss — likely disk I/O; an SSD helps)\n' "$name" "$disp" "$secs"
        else
            printf '  [OK]   %-20s %s\n' "$name" "$disp"
        fi
    done

    # Name the failure mode instead of leaving a bare [FAIL] (#235/#236).
    # The two states operators actually hit here and cannot see without
    # reading journals by hand: the start-limit latch (systemd refuses every
    # start; nothing else in the stack clears it) and an OOM kill (only
    # recorded in the KERNEL journal). Best-effort — `show` on a missing
    # unit just yields empty values and prints nothing.
    if (( server_down )); then
        local result main_status
        result=$(systemctl --user show signalk-server.service \
            -p Result --value 2>/dev/null || true)
        main_status=$(systemctl --user show signalk-server.service \
            -p ExecMainStatus --value 2>/dev/null || true)
        if [[ "$result" == "start-limit-hit" ]]; then
            echo
            echo "  signalk-server is LATCHED OFF by systemd's start rate limiter"
            echo "  (start-limit-hit): too many starts in a short window — plugin-dev"
            echo "  restarts and OOM kills count too. It will NOT come back on its own."
            echo "  Clear the latch and start it with:  signalk start"
        elif [[ -f "$QUADLET_DIR/signalk-server.container" ]] \
            && grep -qE '^[[:space:]]*#SK-PAUSED#' "$QUADLET_DIR/signalk-server.container"; then
            # Durably paused: the updater's /api/signalk/pause comments the
            # [Install] WantedBy= line out with its #SK-PAUSED# marker
            # (signalk-updater-server src/quadlet/rewriter.ts). Check this
            # BEFORE reading exit codes — a CLEAN stop also records
            # ExecMainStatus=137/Result=exit-code (the in-container PID 1
            # ignores untrapped SIGTERM, so podman's follow-up SIGKILL after
            # StopTimeout is how every stop ends; verified against systemd
            # 257), and reading that as an OOM kill would misdiagnose every
            # 'signalk stop'.
            echo
            echo "  signalk-server is durably stopped (via 'signalk stop'). Start it"
            echo "  again with:  signalk start"
        elif [[ "$result" == "exit-code" && "$main_status" == "137" ]] \
            || [[ "$result" == "signal" && "$main_status" == "9" ]]; then
            # Two SIGKILL shapes, both typical of the kernel OOM killer under
            # host memory pressure (#236): the container payload killed (podman
            # run exits carrying 128+9=137), or podman run itself killed
            # (Result=signal, SIGKILL). An operator stop is excluded by the
            # WantedBy branch above; a hand-rolled `systemctl --user stop` can
            # still land here, which is why this is phrased as a lead with a
            # confirmation step, not a verdict.
            echo
            echo "  signalk-server's last exit was a SIGKILL — commonly the kernel"
            echo "  OOM killer under host memory pressure. Confirm with:"
            echo "    journalctl -k | grep -i 'out of memory'"
        fi
    fi

    echo
    echo "=== systemd-user units ==="
    systemctl --user --no-pager list-units --all 'signalk-*' 2>/dev/null || true

    echo
    echo "=== Container snapshot ==="
    podman ps -a --filter 'name=signalk-' \
        --format '{{.Names}}  {{.Status}}  {{.Image}}' 2>/dev/null || true

    echo
    echo "For deeper diagnostics:"
    echo "  curl -fsS $(pub_url "$DOCTOR_URL")/api/probes | jq ."
    echo "  signalk recover doctor"
}

cmd_recover() {
    if [[ ! -x "$HOME/.local/bin/signalk-recovery" ]]; then
        echo "[ERR] ~/.local/bin/signalk-recovery is missing; reinstall the stack" >&2
        exit 1
    fi
    exec "$HOME/.local/bin/signalk-recovery" "$@"
}

cmd_socketcan() {
    # Thin delegate into the sibling helper installed by
    # install-socketcan-script.sh. Same pattern as cmd_recover so the
    # dispatcher doesn't carry the body. On older installs that don't
    # yet have the helper, point the operator at `signalk update` so
    # the doctor's installer-refresh endpoint pulls the new artifact
    # without re-running the bash bootstrap one-liner.
    if [[ ! -x "$HOME/.local/bin/signalk-socketcan" ]]; then
        echo "[ERR] ~/.local/bin/signalk-socketcan is missing." >&2
        echo "  Run 'signalk update' to refresh installer artifacts, or re-run" >&2
        echo "  the bash bootstrap one-liner." >&2
        exit 1
    fi
    exec "$HOME/.local/bin/signalk-socketcan" "$@"
}

cmd_bluetooth() {
    # Thin delegate into the sibling helper installed by
    # install-bluetooth-script.sh — same pattern as cmd_socketcan.
    if [[ ! -x "$HOME/.local/bin/signalk-bluetooth" ]]; then
        echo "[ERR] ~/.local/bin/signalk-bluetooth is missing." >&2
        echo "  Run 'signalk update' to refresh installer artifacts, or re-run" >&2
        echo "  the bash bootstrap one-liner." >&2
        exit 1
    fi
    exec "$HOME/.local/bin/signalk-bluetooth" "$@"
}

cmd_timesync() {
    # Root-owned host agent (see install.sh step 17b) — /usr/local/bin,
    # not ~/.local/bin: the systemd system timer executes it as root and
    # root must never run a user-writable file.
    if [[ ! -x /usr/local/bin/signalk-timesync ]]; then
        echo "[ERR] /usr/local/bin/signalk-timesync is missing." >&2
        echo "  Re-run the bash bootstrap one-liner (needs sudo) to install it." >&2
        exit 1
    fi
    exec /usr/local/bin/signalk-timesync "$@"
}

# Restart signalk-server through the updater's authenticated REST API (the
# sanctioned lifecycle path — see _signalk_lifecycle and install.sh), falling
# back to a direct `systemctl --user restart` only when the updater can't be
# reached. Mirrors the posture install.sh, `signalk bluetooth`, and the
# timesync host agent (#216) already use. Unlike _signalk_lifecycle's
# pause/resume this is a plain restart (no Quadlet WantedBy rewrite), so a
# direct systemctl fallback is a complete substitute — a restart is not a
# durable state the updater has to persist. Returns 0 on either path; non-zero
# only if both fail. Echoes which path was taken.
_signalk_restart_server() {
    local token_path="$HOME/.signalk-updater/token"
    local token=""
    [[ -f "$token_path" ]] && token=$(<"$token_path")
    if [[ -n "$token" ]] && curl -fsS -m 30 -X POST \
        -H "Authorization: Bearer $token" \
        "${UPDATER_URL}/api/signalk/restart" >/dev/null 2>&1; then
        echo "[OK] Restarted signalk-server via the updater."
        return 0
    fi
    echo "[i] Updater REST restart unavailable — using systemctl fallback." >&2
    if systemctl --user restart signalk-server.service; then
        echo "[OK] Restarted signalk-server via systemctl."
        return 0
    fi
    echo "[ERR] Failed to restart signalk-server (updater unreachable and" >&2
    echo "      systemctl --user restart signalk-server.service failed)." >&2
    echo "      Restart it yourself once the cause is clear:" >&2
    echo "        systemctl --user restart signalk-server" >&2
    return 1
}

# --- resolv-watch: container DNS self-heal --------------------------------
# podman copies the host's /etc/resolv.conf into signalk-server once per
# container CREATE. A boot that beats DHCP — Pi and router powered on
# together, and the router can take minutes to serve leases — freezes an
# EMPTY resolver list into the container: the app store and every other
# outbound lookup stay dead until the container is recreated ("app store
# offline after every reboot until I restart Signal K"). The server
# Quadlet's short ExecStartPre wait covers fast DHCP; this pair of user
# units covers the slow-router case: a path unit watches /etc/resolv.conf
# and a oneshot recreates signalk-server ONLY when the host has a
# nameserver and the running container has none. Self-limiting: after the
# restart the container has the nameserver, so later triggers (DHCP
# renews, VPN resolv rewrites) exit without touching the server.
#
# The unit content lives HERE as the single owner — same no-drift
# rationale as reusing render-server-quadlet.sh verbatim: install.sh
# calls `signalk resolv-watch` on a fresh install, and cmd_render_server
# calls the same helper so existing boxes pick the units up on `signalk
# update`. The oneshot delegates to `signalk resolv-watch heal` so the
# recovery goes through the sanctioned lifecycle path
# (_signalk_restart_server: updater REST first, systemctl --user only as
# the fallback — the same order the timesync agent uses); the unit text
# itself carries no podman or systemctl calls.
RESOLV_WATCH_PATH_UNIT='# Installed by signalk-universal-installer (signalk resolv-watch)
[Unit]
Description=Watch host DNS configuration for the SignalK container stack

[Path]
# Several watch points because resolver stacks differ in WHERE the file
# that finally carries the nameservers lives. /etc/resolv.conf covers
# the direct writers (dhcpcd, NetworkManager rc-manager=file), including
# atomic rename-into-place — that fires the parent-directory watch
# systemd keeps on /etc. The /run entries cover the symlink layouts
# (systemd-resolved, NetworkManager rc-manager=symlink, resolvconf):
# inotify follows the /etc/resolv.conf symlink at watch-setup time, so a
# target that is dangling at boot or later replaced by rename can escape
# that first watch entirely — watching the well-known runtime targets
# directly closes the gap, because systemd watches the nearest existing
# parent until the path appears. A path that never exists on a given
# host is harmless (the watch stays dormant), and spurious triggers are
# cheap — the oneshot guards exit without touching the server.
PathChanged=/etc/resolv.conf
PathChanged=/run/systemd/resolve/stub-resolv.conf
PathChanged=/run/systemd/resolve/resolv.conf
PathChanged=/run/NetworkManager/resolv.conf
PathChanged=/run/resolvconf/resolv.conf

[Install]
WantedBy=default.target'
RESOLV_WATCH_SERVICE_UNIT='# Installed by signalk-universal-installer (signalk resolv-watch)
[Unit]
Description=Recreate signalk-server when host DNS appeared after its start
# The probe + recovery logic lives in the CLI (`signalk resolv-watch
# heal`) so the restart follows the sanctioned lifecycle path: the
# updater REST API first, systemctl --user only as the fallback. The
# unit is inert when the CLI is missing.
ConditionPathExists=%h/.local/bin/signalk

[Service]
Type=oneshot
ExecStart=%h/.local/bin/signalk resolv-watch heal'

_signalk_ensure_resolv_watch() {
    local unit_dir="${HOME}/.config/systemd/user"
    local path_file="${unit_dir}/signalk-resolv-watch.path"
    local svc_file="${unit_dir}/signalk-resolv-watch.service"

    if [[ "$(cat "$path_file" 2>/dev/null)" == "$RESOLV_WATCH_PATH_UNIT" ]] \
        && [[ "$(cat "$svc_file" 2>/dev/null)" == "$RESOLV_WATCH_SERVICE_UNIT" ]] \
        && systemctl --user is-enabled signalk-resolv-watch.path >/dev/null 2>&1; then
        echo "[OK] signalk-resolv-watch units already installed."
        return 0
    fi

    mkdir -p "$unit_dir"
    # Atomic per-file (temp + mv), 0644 — same shape as the Quadlet writes.
    local f content tmp
    for f in "$path_file" "$svc_file"; do
        if [[ "$f" == "$path_file" ]]; then
            content="$RESOLV_WATCH_PATH_UNIT"
        else
            content="$RESOLV_WATCH_SERVICE_UNIT"
        fi
        tmp=$(mktemp "${f}.XXXXXX") || { echo "[ERR] mktemp failed for $f" >&2; return 1; }
        if ! printf '%s\n' "$content" >"$tmp" || ! chmod 0644 "$tmp" || ! mv -f "$tmp" "$f"; then
            echo "[ERR] Failed to install $f." >&2
            rm -f "$tmp"
            return 1
        fi
    done

    systemctl --user daemon-reload || {
        echo "[ERR] systemctl --user daemon-reload failed; the resolv-watch units are" >&2
        echo "      on disk but not parsed. Retry:  systemctl --user daemon-reload" >&2
        return 1
    }
    systemctl --user enable --now signalk-resolv-watch.path >/dev/null 2>&1 || {
        echo "[ERR] could not enable signalk-resolv-watch.path" >&2
        return 1
    }
    echo "[OK] signalk-resolv-watch units installed and watching /etc/resolv.conf."
}

# The oneshot's entry point. Ordered guards, each a clean no-op exit:
#   1. host has no nameserver     -> nothing to heal towards
#   2. container not running      -> its next start snapshots fresh; this
#                                    also gives try-restart semantics (never
#                                    start a unit the operator stopped)
#   3. container has a nameserver -> healthy, nothing to do
# Only then recreate the container: _signalk_restart_server (updater REST
# first, systemctl fallback) restarts the unit, whose `podman run
# --replace` re-copies the host resolv.conf. The podman probes here are
# read-only — lifecycle mutation stays on the sanctioned path.
# SIGNALK_RESOLV_CONF is a test seam; production uses the real file.
_signalk_resolv_heal() {
    local resolv="${SIGNALK_RESOLV_CONF:-/etc/resolv.conf}"
    grep -qs '^nameserver' "$resolv" || return 0
    podman exec signalk-server true 2>/dev/null || return 0
    podman exec signalk-server grep -qs '^nameserver' /etc/resolv.conf && return 0
    echo "[i] Host DNS is configured but the signalk-server container has no nameserver — recreating it."
    _signalk_restart_server
}

cmd_resolv_watch() {
    case "${1:-}" in
        '') _signalk_ensure_resolv_watch ;;
        heal) _signalk_resolv_heal ;;
        *) echo "[ERR] Unknown resolv-watch argument: $1" >&2; return 1 ;;
    esac
}

cmd_render_server() {
    # Rebuild the LIVE ~/.config/containers/systemd/signalk-server.container
    # from the staged template, so a template-only improvement (e.g.
    # Timezone=local, #212) reaches an already-deployed box without a full
    # installer re-run (#217). The bash installer renders this file only on a
    # fresh run; a plain `signalk update` stages the new template but never
    # applied it — this closes that gap.
    #
    # We reuse render-server-quadlet.sh VERBATIM (staged into installer-payload
    # by install.sh + refreshed by the doctor) rather than re-implementing its
    # jq/awk hardware-block logic here — one renderer, no drift. Inputs:
    #   - renderer:  ~/.signalk-doctor/installer-payload/render-server-quadlet.sh
    #   - template:  ~/.signalk-doctor/installer-payload/signalk-server.container.template
    #   - hardware:  ~/.signalk-updater/hardware.json (detected devices)
    # and the same __SK_HTTP_PORT__ substitution install.sh applies, with the
    # port read live from the current Quadlet (sk_http_port) so a re-render
    # preserves the operator's chosen port. The live Image= tag (the updater's
    # version-of-record) and the operator's USER ADDITIONS block are preserved
    # too, spliced from the live file — see below. Everything else is the fresh
    # template body, which is how a template-only fix (#217) actually lands.
    local no_restart=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --no-restart) no_restart=true; shift ;;
            *) echo "[ERR] Unknown render-server argument: $1" >&2; return 1 ;;
        esac
    done

    # The DNS self-heal units ride along with every render so existing
    # boxes pick them up on `signalk update` without a separate step.
    # Non-fatal: a failed unit install must not block a template render.
    _signalk_ensure_resolv_watch \
        || echo "[WARN] could not install the signalk-resolv-watch units (continuing)" >&2

    local payload_dir="${DOCTOR_DATA}/installer-payload"
    local renderer="${payload_dir}/render-server-quadlet.sh"
    local template="${payload_dir}/signalk-server.container.template"
    local hw_file="$HOME/.signalk-updater/hardware.json"
    local live="${QUADLET_DIR}/signalk-server.container"

    # The renderer + template are staged by a fresh install and refreshed by
    # `signalk update`. If they're absent this is an older install that never
    # staged them (or the doctor never ran a refresh) — point at `signalk
    # update` rather than failing cryptically.
    if [[ ! -f "$renderer" || ! -f "$template" ]]; then
        echo "[ERR] Staged server template/renderer not found under $payload_dir." >&2
        echo "      Run 'signalk update' first (it stages them), then retry —" >&2
        echo "      or re-run the bash bootstrap one-liner." >&2
        return 1
    fi
    if [[ ! -f "$hw_file" ]]; then
        echo "[ERR] hardware.json not found at $hw_file." >&2
        echo "      Re-run the bash bootstrap one-liner to (re)detect hardware." >&2
        return 1
    fi
    if [[ ! -f "$live" ]]; then
        echo "[ERR] Live Quadlet $live is missing — nothing to re-render onto." >&2
        echo "      Re-run the bash bootstrap one-liner to lay down the stack." >&2
        return 1
    fi

    # Render to a string, applying the same port substitution install.sh does.
    local port rendered
    port=$(sk_http_port)
    if ! rendered=$(bash "$renderer" "$hw_file" "$template" \
        | sed -e "s/__SK_HTTP_PORT__/${port}/g"); then
        echo "[ERR] render-server-quadlet.sh failed (see error above)." >&2
        return 1
    fi

    # Never overwrite a working Quadlet with junk. A renderer that exits 0 but
    # emits empty/truncated output (a malformed hardware.json, a future
    # renderer bug that short-circuits) would otherwise be snapshotted over the
    # live file and restarted — taking signalk-server down. Require the two
    # structural anchors every valid render has: the [Container] section and an
    # Image= line. Cheap, and it fails BEFORE the snapshot/write/restart path.
    if [[ -z "$rendered" ]] || ! grep -q '^\[Container\]' <<<"$rendered" \
        || ! grep -q '^Image=' <<<"$rendered"; then
        echo "[ERR] render-server-quadlet.sh produced empty or malformed output" >&2
        echo "      (no [Container]/Image= line) — refusing to touch the live Quadlet." >&2
        return 1
    fi

    # Preserve the running IMAGE tag. The template pins Image=…:dirkwa, but the
    # updater rewrites this line in the LIVE Quadlet on every version switch —
    # it is the operator's chosen version-of-record. Rendering from the pristine
    # template would silently revert that choice back to :dirkwa on every
    # `signalk update`. So carry the live Image= line into the render (there is
    # exactly one Image= in [Container]). Only when both sides have one; if the
    # live file somehow lacks it we keep the template's rather than drop it.
    local live_image
    live_image=$(grep -m1 '^Image=' "$live" || true)
    if [[ -n "$live_image" ]] && grep -q '^Image=' <<<"$rendered"; then
        # Replace only the FIRST Image= line in the render with the live one.
        # Env-passed so a tag with sed-special chars can't corrupt the program.
        rendered=$(LIVE_IMAGE="$live_image" awk '
            !done && /^Image=/ { print ENVIRON["LIVE_IMAGE"]; done = 1; next }
            { print }
        ' <<<"$rendered")
    fi

    # Preserve the operator's hand-edits. The template carries a
    #   # === BEGIN USER ADDITIONS ===  …  # === END USER ADDITIONS ===
    # block whose contents (custom mounts / capabilities / env) the updater
    # preserves verbatim across version switches and hardware-apply rewrites.
    # A fresh render comes from the pristine template, so — unlike the bash
    # installer's one-shot render — we must NOT let a routine `signalk update`
    # silently wipe those edits. Splice the LIVE block's contents into the
    # freshly rendered body (same idea as the updater's spliceHardwareBlock,
    # but for the USER ADDITIONS markers). If either side lacks the markers we
    # leave the render as-is: nothing to preserve, or a template that no longer
    # carries the block. `awk` extracts the inner lines from the live file and
    # re-emits the rendered body with its own inner lines swapped for them.
    local begin_marker='# === BEGIN USER ADDITIONS ==='
    local end_marker='# === END USER ADDITIONS ==='
    if grep -qF "$begin_marker" "$live" && grep -qF "$end_marker" "$live" \
        && grep -qF "$begin_marker" <<<"$rendered" && grep -qF "$end_marker" <<<"$rendered"; then
        local live_additions
        # Inner lines only (strictly between the markers), verbatim.
        live_additions=$(awk '
            /^# === BEGIN USER ADDITIONS ===/ { grab = 1; next }
            /^# === END USER ADDITIONS ===/   { grab = 0 }
            grab { print }
        ' "$live")
        # Rebuild the rendered body: keep everything except the rendered block
        # inner lines, and drop in the live inner lines right after BEGIN.
        # Passed via an env var so arbitrary operator content (quotes, %, etc.)
        # can't be reinterpreted by awk's program text.
        rendered=$(LIVE_ADDITIONS="$live_additions" awk '
            /^# === BEGIN USER ADDITIONS ===/ {
                print
                add = ENVIRON["LIVE_ADDITIONS"]
                if (add != "") print add
                skip = 1
                next
            }
            /^# === END USER ADDITIONS ===/ { skip = 0; print; next }
            skip { next }
            { print }
        ' <<<"$rendered")
    fi

    # Idempotent short-circuit: if the render matches the live file byte-for-
    # byte there is nothing to write and no reason to restart the data plane.
    # Compare the rendered string (no trailing newline) against the file with
    # its trailing newline trimmed, matching how atomic_write appends exactly
    # one newline below.
    if [[ "$rendered" == "$(cat "$live")" ]]; then
        echo "[OK] Live signalk-server Quadlet already matches the current template — nothing to do."
        return 0
    fi

    # It differs — snapshot the live file first (CC-1), then atomic-write the
    # new render. Snapshot dir + naming mirror install.sh::snapshot_existing
    # and the doctor's snapshots (~/.signalk-doctor/snapshots/<ts>-<name>).
    local snap_dir="${DOCTOR_DATA}/snapshots"
    mkdir -p "$snap_dir"
    local ts
    ts=$(date -u +"%Y%m%dT%H%M%SZ")
    if cp -p "$live" "${snap_dir}/${ts}-signalk-server.container"; then
        echo "[i] Snapshotted the current Quadlet to ${snap_dir}/${ts}-signalk-server.container"
    else
        echo "[ERR] Could not snapshot $live — refusing to overwrite without a backup." >&2
        return 1
    fi

    # Atomic write (temp + mv), 0644 — same as install.sh::atomic_write.
    local tmp
    tmp=$(mktemp "${live}.XXXXXX") || { echo "[ERR] mktemp failed for $live" >&2; return 1; }
    # Handle the write/chmod failing (ENOSPC, EDQUOT) explicitly: without this,
    # set -e would abort before the mv below and leave the temp file behind in
    # the live Quadlet dir. Clean it up on failure, same as the mv path.
    if ! printf '%s\n' "$rendered" >"$tmp" || ! chmod 0644 "$tmp"; then
        echo "[ERR] Failed to stage the rendered Quadlet at $tmp." >&2
        rm -f "$tmp"
        return 1
    fi
    if ! mv -f "$tmp" "$live"; then
        echo "[ERR] Failed to install rendered Quadlet to $live." >&2
        rm -f "$tmp"
        return 1
    fi
    echo "[OK] Rewrote $live from the current template."

    # systemd must re-parse the changed Quadlet before a restart recreates the
    # container from it.
    systemctl --user daemon-reload || {
        echo "[ERR] systemctl --user daemon-reload failed; the new Quadlet is on disk" >&2
        echo "      but not yet parsed. Retry:  systemctl --user daemon-reload" >&2
        return 1
    }

    if [[ "$no_restart" == true ]]; then
        echo "[i] --no-restart: the new Quadlet is in place but signalk-server is"
        echo "    still running the old one. Apply it with:  systemctl --user restart signalk-server"
        return 0
    fi

    echo "[i] Restarting signalk-server to apply the new Quadlet…"
    _signalk_restart_server
}

cmd_update() {
    # Refresh installer scripts + Quadlet templates by calling the
    # doctor's /api/installer/refresh endpoint. The doctor fetches the
    # latest payload from GitHub Pages and rewrites:
    #   ~/.local/bin/signalk           (this script)
    #   ~/.local/bin/signalk-recovery  (the host-resident safety net)
    #   ~/.signalk-doctor/installer-payload/*  (Quadlet templates + the
    #                                            render-server-quadlet.sh
    #                                            renderer — staged, not applied)
    #
    # The doctor refresh itself restarts nothing. But a template-only fix
    # (e.g. Timezone=local) staged into installer-payload never reaches the
    # LIVE signalk-server.container on its own (issue #217), so after a
    # successful refresh we chain into the render step, which rebuilds the
    # live Quadlet from the refreshed template and restarts signalk-server
    # ONLY when the render actually changed the file (idempotent — a refresh
    # that moved nothing on the server template is a no-op here). --no-render
    # skips that chained step for operators who want the pure old behavior.
    #
    # If the doctor is unreachable, fall back to the bash one-liner. Doctor
    # token lives at ~/.signalk-doctor/token (mode 0600); read it ourselves
    # rather than asking the user to copy/paste.
    local do_render=true
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --no-render) do_render=false; shift ;;
            *) echo "[ERR] Unknown update argument: $1" >&2; return 1 ;;
        esac
    done

    # Channel. The doctor's /api/installer/refresh always fetches the site
    # ROOT, which now carries the latest release -- so the default path already
    # follows releases with no doctor-side change. Tracking master means going
    # around the doctor and re-running the bootstrap against the /dev tree,
    # which is exactly what the existing fallback below does anyway.
    local channel="${SIGNALK_CHANNEL:-release}"
    case "$channel" in
        release) ;;
        master|dev)
            echo "[i] SIGNALK_CHANNEL=${channel}: refreshing from master, not the release."
            echo "[i] The doctor refresh only serves the release channel, so this"
            echo "[i] re-runs the bootstrap against the /dev tree instead."
            SIGNALK_CHANNEL="$channel" bash -c \
                'curl -fsSL "https://dirkwa.github.io/signalk-universal-installer/dev/installer/linux/install.sh" | bash'
            return $?
            ;;
        *)
            echo "[ERR] SIGNALK_CHANNEL must be 'release' or 'master' (got '${channel}')" >&2
            return 1
            ;;
    esac

    local token_path="${DOCTOR_DATA}/token"
    if [[ ! -f "$token_path" ]]; then
        echo "[ERR] doctor token not found at $token_path" >&2
        echo "      The doctor may not be installed. Re-run the bash one-liner:" >&2
        echo "      curl -fsSL https://dirkwa.github.io/signalk-universal-installer/installer/linux/install.sh | bash" >&2
        exit 1
    fi
    local token
    token=$(cat "$token_path")

    echo "[i] Refreshing installer via doctor ($(pub_url "$DOCTOR_URL"))…"
    local http_code
    local body_file
    body_file=$(mktemp -t signalk-update.XXXXXX)
    # -w writes the HTTP code separately so we can branch on it. -m 60
    # because the doctor fetches 6 artifacts from Pages and snapshots
    # each that changed — bounded but not instant.
    #
    # `|| http_code="000"` OUTSIDE the substitution, not `|| echo "000"` inside
    # it: on a connection failure curl still prints its own "000" via -w AND
    # exits non-zero, so an inner echo APPENDS and yields "000000" — which
    # matches no case arm below and skips the 000) branch that prints the
    # bash one-liner recovery floor, exactly when the doctor is unreachable.
    http_code=$(curl -sS -o "$body_file" -w '%{http_code}' \
        -m 60 \
        -X POST \
        -H "Authorization: Bearer $token" \
        "$DOCTOR_URL/api/installer/refresh") || http_code="000"

    case "$http_code" in
        000)
            echo "[ERR] doctor is unreachable at $(pub_url "$DOCTOR_URL")" >&2
            echo "      Use the bash one-liner as the floor:" >&2
            echo "      curl -fsSL https://dirkwa.github.io/signalk-universal-installer/installer/linux/install.sh | bash" >&2
            rm -f "$body_file"
            exit 1
            ;;
        200)
            # Summarize counts via jq when available; otherwise dump
            # the raw JSON so the user can read it.
            if command -v jq >/dev/null 2>&1; then
                echo "[OK] Doctor refresh complete:"
                jq -r '.counts | to_entries | map(select(.value > 0)) | .[] | "  \(.value) \(.key)"' "$body_file" 2>/dev/null \
                    || cat "$body_file"
                echo
                echo "Per-artifact result:"
                jq -r '.results[] | "  \(.id)\t\(.status)\(if .message then "  — " + .message else "" end)"' \
                    "$body_file" 2>/dev/null || true
            else
                cat "$body_file"
            fi
            ;;
        401|403)
            echo "[ERR] doctor rejected the request (HTTP $http_code) — token mismatch?" >&2
            cat "$body_file" >&2
            rm -f "$body_file"
            exit 1
            ;;
        409)
            echo "[ERR] another operation is in progress (HTTP 409). Try again in a few seconds." >&2
            cat "$body_file" >&2
            rm -f "$body_file"
            exit 1
            ;;
        *)
            echo "[ERR] doctor returned HTTP $http_code:" >&2
            cat "$body_file" >&2
            rm -f "$body_file"
            exit 1
            ;;
    esac
    rm -f "$body_file"

    # Only the 200 path reaches here (every other status exit'd above), so
    # the refresh succeeded. Apply the refreshed server template to the live
    # Quadlet unless the operator opted out, or we're inside the Windows
    # Podman-machine VM (no host signalk-server Quadlet to render there — the
    # render step is a Linux-host concern, same reasoning that hides
    # render-server from the shim's help). cmd_render_server is idempotent and
    # returns 0 when nothing changed, so this is safe to run every update.
    if [[ "$do_render" == true && "${SIGNALK_WINDOWS_SHIM:-0}" != "1" ]]; then
        echo
        cmd_render_server
    fi
}

cmd_resetadmin() {
    # Regain Admin UI access after a lost password — without the
    # documented delete-security.json recovery, which discards the JWT
    # secretKey and thereby invalidates every issued token (including
    # the doctor's ~/.signalk-doctor/signalk-token). This upserts one
    # admin user's bcrypt hash in place and leaves everything else —
    # secretKey, devices, acls, other users — untouched.
    #
    # The hash is computed inside the signalk-server container with the
    # server's own bcryptjs, so it is bit-compatible with what the
    # server writes itself and nothing needs to be installed on the host.
    local username="${1:-admin}"

    if ! podman exec signalk-server true 2>/dev/null; then
        echo "[ERR] signalk-server container is not running (resetadmin uses it to hash the password)." >&2
        echo "      Start it first:  systemctl --user start signalk-server" >&2
        exit 1
    fi

    # Is security actually on? Ask the RUNNING server, not the on-disk
    # settings.json. The server parses settings.json once at startup and
    # then serves from memory, so a file that no longer strict-parses as
    # JSON (a stray comment, trailing comma, BOM, half-written edit) can
    # sit on disk while the server runs perfectly secured. The old gate
    # re-read + JSON.parse'd that file here and treated a parse failure
    # the same as "no strategy configured" — printing "security is not
    # enabled" while login still worked. /skServer/loginStatus is
    # unauthenticated and returns authenticationRequired:true under the
    # token strategy, false under the dummy (no-security) strategy.
    # NOTE: no `curl -f`. With -f a reachable server that answers 4xx/5xx
    # (the loginStatus rate-limiter's 429, a transient 503 during
    # startup) exits non-zero and would look identical to "unreachable",
    # wrongly dropping to the disk path. Instead capture the body and the
    # HTTP status separately: only a genuine connect/timeout failure
    # (empty status, or 000) is "unreachable"; a reachable server whose
    # body matches neither true nor false is ambiguous and we fail
    # closed rather than guess.
    local sk_login_url login_resp login_http login_body
    sk_login_url="${SIGNALK_URL%/signalk*}/skServer/loginStatus"
    login_resp=$(curl -sS --max-time 5 -w '\n%{http_code}' "$sk_login_url" 2>/dev/null || true)
    login_http=${login_resp##*$'\n'}
    login_body=${login_resp%$'\n'*}
    if [ -n "$login_http" ] && [ "$login_http" != "000" ]; then
        # Server answered — trust it over the file.
        if printf '%s' "$login_body" | grep -Eq '"authenticationRequired"[[:space:]]*:[[:space:]]*false'; then
            echo "[ERR] Security is not enabled on this server — there is no admin login to reset." >&2
            echo "      On an unsecured server the Admin UI shows a 'create account' screen" >&2
            echo "      (not a Security > Users page). To enable security and create the first" >&2
            echo "      admin without a fresh reinstall, re-run the installer with credentials:" >&2
            echo "        SIGNALK_ADMIN_USER=admin SIGNALK_ADMIN_PASSWORD=yourpass \\" >&2
            echo "          curl -fsSL https://dirkwa.github.io/signalk-universal-installer/installer/linux/install.sh | bash" >&2
            exit 1
        elif ! printf '%s' "$login_body" | grep -Eq '"authenticationRequired"[[:space:]]*:[[:space:]]*true'; then
            echo "[ERR] Unexpected response from $sk_login_url (HTTP $login_http) — cannot confirm security state." >&2
            echo "      Retry in a moment; if it persists, check the server logs." >&2
            exit 1
        fi
    else
        # Server unreachable — fall back to the on-disk strategy, but
        # tell a parse failure apart from a genuinely absent strategy.
        local sk_settings_state
        sk_settings_state=$(podman exec signalk-server node -e '
            const fs = require("fs");
            const p = "/home/node/.signalk/settings.json";
            let raw;
            try { raw = fs.readFileSync(p, "utf8"); } catch (e) { console.log("missing"); process.exit(0); }
            try { const s = JSON.parse(raw); console.log(s.security && s.security.strategy ? "enabled" : "disabled"); }
            catch (e) { console.log("unparseable"); }
        ' 2>/dev/null || echo "execfail")
        case "$sk_settings_state" in
            enabled) : ;; # security configured on disk — proceed
            disabled | missing)
                echo "[ERR] settings.json has no security strategy and the server was unreachable," >&2
                echo "      so security looks disabled — but the RUNNING server may still be secured" >&2
                echo "      (it reads settings.json once at startup; disk can lag). First make sure" >&2
                echo "      signalk-server is up and retry — a reachable secured server lets this" >&2
                echo "      command proceed. If security really is off, enable it + create the first" >&2
                echo "      admin without a fresh reinstall by re-running the installer with creds:" >&2
                echo "        SIGNALK_ADMIN_USER=admin SIGNALK_ADMIN_PASSWORD=yourpass \\" >&2
                echo "          curl -fsSL https://dirkwa.github.io/signalk-universal-installer/installer/linux/install.sh | bash" >&2
                exit 1
                ;;
            unparseable)
                echo "[ERR] ~/.signalk/settings.json is not valid JSON — cannot determine security state." >&2
                echo "      The running server may still be fine (it parses settings once at startup)." >&2
                echo "      Fix the file, then retry. To see the error:" >&2
                echo "        podman exec signalk-server node -e 'JSON.parse(require(\"fs\").readFileSync(\"/home/node/.signalk/settings.json\",\"utf8\"))'" >&2
                exit 1
                ;;
            *)
                echo "[ERR] Could not determine security state (server unreachable and settings.json unreadable)." >&2
                exit 1
                ;;
        esac
    fi

    # Password source. Normally prompted interactively (read -rs, twice,
    # confirmed). But the Windows `signalk` shim runs this command over
    # `podman machine ssh`, which has no PTY and whose stdin is the piped
    # transport — so `read` returns EOF instantly and every reset failed
    # with "Password must not be empty". When SIGNALK_RESETADMIN_PASSWORD
    # is set (the Windows shim prompts on the Windows side, then passes it
    # in through the base64 payload so it never appears on any argv / in
    # `ps`), use it and skip the prompts. The confirm-match is the
    # prompter's job in that case; we only enforce non-empty here. Also
    # useful for Linux automation.
    local pw pw2
    if [[ -n "${SIGNALK_RESETADMIN_PASSWORD:-}" ]]; then
        pw="$SIGNALK_RESETADMIN_PASSWORD"
    else
        read -rs -p "New password for '${username}': " pw; echo
        read -rs -p "Confirm password: " pw2; echo
        if [[ "$pw" != "$pw2" ]]; then
            echo "[ERR] Passwords do not match." >&2
            exit 1
        fi
    fi
    if [[ -z "$pw" ]]; then
        echo "[ERR] Password must not be empty." >&2
        exit 1
    fi

    # Password travels via stdin (never argv/env, so it can't leak
    # through `ps`). security.json may legitimately be absent here (the
    # documented lost-credentials recovery deletes it); recreate it with
    # a fresh secretKey in that case — without one the server would
    # generate a new random key on every boot, logging everyone out on
    # each restart. Write atomically + 0600, matching the server's own
    # saveSecurityConfig.
    local result
    if ! result=$(printf '%s' "$pw" | podman exec -i -w /home/node/signalk signalk-server node -e '
        const fs = require("fs");
        const crypto = require("crypto");
        const bcrypt = require("bcryptjs");
        const path = "/home/node/.signalk/security.json";
        const username = process.argv[1];
        const password = fs.readFileSync(0, "utf8");
        const config = fs.existsSync(path) ? JSON.parse(fs.readFileSync(path, "utf8")) : {};
        if (!config.secretKey) config.secretKey = crypto.randomBytes(256).toString("hex");
        if (!Array.isArray(config.users)) config.users = [];
        const hash = bcrypt.hashSync(password, bcrypt.genSaltSync(10));
        const user = config.users.find((u) => u.username === username);
        if (user) {
            user.password = hash;
            user.type = "admin";
        } else {
            config.users.push({ username: username, type: "admin", password: hash });
        }
        fs.writeFileSync(path + ".tmp", JSON.stringify(config, null, 2), { mode: 0o600 });
        fs.renameSync(path + ".tmp", path);
        console.log(user ? "password reset" : "created");
    ' "$username"); then
        echo "[ERR] Failed to update ~/.signalk/security.json (see error above)." >&2
        exit 1
    fi

    # The running server keeps its security config in memory — restart
    # so the new credentials take effect (and before any in-memory save
    # could clobber the file we just wrote).
    echo "[i] Admin user '${username}' ${result}. Restarting signalk-server..."
    systemctl --user restart signalk-server
    echo "[OK] Done — log in at $(pub_url "${SIGNALK_URL%/signalk*}")/admin with username '${username}'."
    echo "     Existing API tokens (doctor, updater) remain valid: the secretKey was preserved."
}

# Clear a start-limit latch before asking for a start. Quadlets rendered
# before StartLimitIntervalSec=0 landed (#235) park the unit in
# `failed (start-limit-hit)` after 5 starts in 30 minutes — plugin-dev
# restarts and OOM kills count too — and systemd then refuses EVERY start
# request, including the updater's, until reset-failed. Safe to call
# unconditionally: reset-failed on a healthy unit is a no-op.
_clear_start_limit() {
    systemctl --user reset-failed signalk-server.service 2>/dev/null || true
}

# Wait for signalk-server.service to actually come up after a start request.
# The updater's 2xx on /api/signalk/resume means "request accepted", NOT
# "unit is up": when systemd refuses the start (start-limit latch on an old
# Quadlet) or the container fails to create, an unconditional [OK] lies to
# the operator (#235). Mirrors install.sh's unit_recovered_within():
# `is-active` is a non-blocking state query, so the loop never hangs.
#   returns 0 — unit reached `active`
#   returns 1 — unit reached `failed` (a refused or dead start; Restart=
#               always won't rescue `failed`, so stop waiting immediately)
#   returns 2 — window expired while still activating. On an SD-card host a
#               cold `podman run --replace` create can take minutes
#               (TimeoutStartSec=300), so this means "still starting", not
#               "down" — callers must not report it as a failure.
_wait_server_active() {
    local secs=${1:-60} start=$SECONDS active
    while (( SECONDS - start < secs )); do
        active=$(systemctl --user is-active signalk-server.service 2>/dev/null || true)
        case "$active" in
            active) return 0 ;;
            failed) return 1 ;;
        esac
        sleep 3
    done
    return 2
}

# Drive a DURABLE signalk-server lifecycle op through the updater's REST API,
# the sanctioned control path (the installer/CLI never start/stop signalk-server
# directly except as a documented fallback when the updater is unreachable).
#
# /api/signalk/{pause,resume} is durable: besides stopping/starting the unit
# now, the updater rewrites signalk-server.container's `[Install] WantedBy=` so
# the server stays down (or comes back) across a reboot. The CLI itself must NOT
# edit that Quadlet (and `disable` on a Quadlet-generated unit isn't durable
# anyway), which is exactly why durability lives behind this endpoint.
#
# $1 = pause|resume (the updater op). $2 = the systemctl verb (stop|start) for
# the unreachable-updater fallback. Echoes a short result; returns non-zero on
# hard failure. Exit codes the callers care about:
#   0   = durable op applied via the updater (survives reboot)
#   3   = updater UNREACHABLE; acted on the unit directly via systemctl as the
#         documented fallback - it took effect NOW but is NOT durable (only the
#         updater rewrites the Quadlet). Distinct from 0 so the caller doesn't
#         claim durability it didn't get.
#   2   = updater reachable but TOO OLD (no pause/resume route) - we refuse and
#         tell the user to update the updater, rather than silently doing a
#         non-durable stop and lying about durability
#   1   = any other hard failure
_signalk_lifecycle() {
    local op="$1"
    local fallback_verb="$2"
    local token_path="$HOME/.signalk-updater/token"
    local token=""
    [[ -f "$token_path" ]] && token=$(<"$token_path")
    local http
    if [[ -n "$token" ]]; then
        # `|| http="000"` OUTSIDE the substitution, not `|| echo "000"` inside
        # it: on a connection failure curl still prints its own "000" via -w AND
        # exits non-zero, so an inner echo APPENDS and yields "000000". That
        # matches no case arm below, so the updater-unreachable branch — the
        # documented systemctl fallback that returns rc 3 — was skipped and
        # stop/start died with "Updater returned HTTP 000000" instead, in
        # exactly the situation the fallback exists for.
        http=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 30 \
            -X POST -H "Authorization: Bearer $token" \
            "${UPDATER_URL}/api/signalk/${op}" 2>/dev/null) || http="000"
    else
        http="000"
    fi
    case "$http" in
        2??) return 0 ;;
        404)
            # Updater is reachable but predates pause/resume. Durability is
            # owned by the updater, so an old one cannot deliver it. Refuse
            # (require-new-updater) instead of a non-durable stop that would
            # silently come back at the next boot.
            echo "[ERR] This signalk-updater is too old to '${op}' durably (no /api/signalk/${op})." >&2
            echo "      Update the updater first: open the Updater console, Dashboard tab," >&2
            echo "      and click Self-update (or update the whole stack), then retry." >&2
            return 2
            ;;
        000)
            # Updater unreachable - documented fallback: act directly on the
            # unit. This stops/starts it NOW but is NOT durable (only the
            # updater rewrites the Quadlet). Signal that to the caller (rc 3) so
            # it reports the non-durable truth rather than claiming a reboot will
            # respect this.
            echo "[i] Updater API unreachable; using systemctl fallback for signalk-server." >&2
            if systemctl --user "$fallback_verb" signalk-server.service 2>/dev/null; then
                return 3
            fi
            echo "[ERR] systemctl --user $fallback_verb signalk-server.service failed." >&2
            return 1
            ;;
        *)
            echo "[ERR] Updater returned HTTP $http for /api/signalk/${op}." >&2
            return 1
            ;;
    esac
}

# Pause SignalK without uninstalling - stops signalk-server (the heavy data
# plane) AND keeps it down across reboots, via the updater's durable pause. The
# lightweight updater + doctor stay running (the doctor is the recovery surface,
# and the updater is how `signalk start` brings the server back). Nothing is
# removed. On Windows/macOS the `signalk` shim instead stops the whole Podman
# MACHINE + disables its boot task - same durable outcome by a different lever.
cmd_stop() {
    echo "Stopping SignalK (signalk-server)..."
    # Capture the status via `|| rc=$?` so `set -e` (set at the top of this
    # script) does not abort on the deliberate non-zero returns (2 = updater too
    # old, 3 = non-durable fallback) before the case can handle them.
    local rc=0
    _signalk_lifecycle pause stop || rc=$?
    case "$rc" in
        0)
            echo "[OK] SignalK stopped and will stay down across reboots."
            echo "     Nothing was removed - data, config and plugins are preserved."
            echo "     Resume with: signalk start"
            ;;
        3)
            # Non-durable fallback (updater was unreachable). Do NOT claim it
            # survives a reboot.
            echo "[OK] SignalK stopped NOW, but this may NOT survive a reboot (the updater was"
            echo "     unreachable, so boot-start could not be disabled). Re-run 'signalk stop'"
            echo "     once the updater is back to make it durable. Resume now with: signalk start"
            ;;
        2) exit 1 ;; # message already printed by _signalk_lifecycle
        *)
            echo "[ERR] Could not stop signalk-server (see above)." >&2
            exit 1
            ;;
    esac
}

# Resume after `signalk stop`: start signalk-server via the updater's durable
# resume, which also re-arms boot-start. Idempotent (the updater no-ops if
# already running and restores WantedBy only if it was removed).
cmd_start() {
    echo "Starting SignalK (signalk-server)..."
    # Clear any start-limit latch BEFORE the start request: while latched,
    # systemd refuses the start the updater is about to issue, the updater
    # still answers 2xx, and this command used to print [OK] over a server
    # that never came up (#235).
    _clear_start_limit
    # `|| rc=$?` so `set -e` does not abort on the non-zero returns before the
    # case runs (see cmd_stop).
    local rc=0
    _signalk_lifecycle resume start || rc=$?
    case "$rc" in
        0|3) : ;; # start issued — verified below before claiming anything
        2) exit 1 ;; # message already printed by _signalk_lifecycle
        *)
            echo "[ERR] Could not start signalk-server (see above)." >&2
            exit 1
            ;;
    esac
    # The updater's 2xx (or the systemctl fallback returning) only means the
    # request was issued. Verify the unit before reporting.
    local wait_rc=0
    _wait_server_active 60 || wait_rc=$?
    if (( wait_rc == 1 )); then
        echo "[ERR] The start was issued but signalk-server entered 'failed'." >&2
        echo "      Inspect it with: systemctl --user status signalk-server" >&2
        echo "                       journalctl --user -u signalk-server -n 50" >&2
        exit 1
    fi
    if (( wait_rc == 2 )); then
        # Still activating — normal on slow SD-card storage, where the cold
        # container create alone can take minutes. Not a failure; say so, and
        # print the actual unit state: 'activating' really is a slow start,
        # while 'inactive' means the updater answered 2xx but no start ever
        # reached systemd — worth the operator seeing rather than papering
        # over with "still starting".
        local state
        state=$(systemctl --user is-active signalk-server.service 2>/dev/null || true)
        echo "[i] Start issued; signalk-server is not 'active' yet (state: ${state:-unknown})."
        echo "    A cold start on slow storage can take a few minutes. Watch it with: signalk health"
        if (( rc == 3 )); then
            echo "    Auto-start at boot may not be re-armed (the updater was unreachable);"
            echo "    re-run 'signalk start' once it is back."
        fi
        return 0
    fi
    if (( rc == 3 )); then
        # Non-durable fallback (updater was unreachable): started now, but
        # boot-start may not be re-armed.
        echo "[OK] SignalK started NOW, but auto-start at boot may not be re-armed (the"
        echo "     updater was unreachable). Re-run 'signalk start' once it is back."
    else
        echo "[OK] SignalK started and will auto-start at boot. Check it with: signalk health"
    fi
}

# Restart signalk-server in place — the verb that completes start/stop (#222).
#
# Deliberately NOT routed through _signalk_lifecycle: that helper exists to
# drive the DURABLE pause/resume pair, whose whole point is rewriting the
# Quadlet's `[Install] WantedBy=` so a stop survives a reboot. A restart must
# leave boot-start exactly as it found it, so it uses the updater's plain
# /api/signalk/restart instead. That also means the "updater too old" refusal
# does not apply here: there is no durability to fail to deliver, so an old
# updater (or an unreachable one) can fall back to systemctl and still be
# completely correct.
#
# A restart of a STOPPED server would start it, silently undoing a durable
# `signalk stop` for this boot while leaving WantedBy= removed — an
# inconsistent state that is nobody's intent. Refuse and point at `start`.
cmd_restart() {
    if ! systemctl --user is-active --quiet signalk-server.service; then
        echo "[ERR] signalk-server is not running, so there is nothing to restart." >&2
        echo "      Start it with: signalk start" >&2
        exit 1
    fi
    echo "Restarting SignalK (signalk-server)..."
    local token_path="$HOME/.signalk-updater/token"
    local token="" http="000"
    [[ -f "$token_path" ]] && token=$(<"$token_path")
    if [[ -n "$token" ]]; then
        # `|| http="000"` OUTSIDE the substitution, not `|| echo "000"` inside
        # it: on a connection failure curl still prints its own "000" via -w AND
        # exits non-zero, so an inner `echo` APPENDS, yielding "000000" — which
        # matches no case arm below and lands in the catch-all error instead of
        # the systemctl fallback. That would break restart in exactly the
        # situation the fallback exists for.
        http=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 60 \
            -X POST -H "Authorization: Bearer $token" \
            "${UPDATER_URL}/api/signalk/restart" 2>/dev/null) || http="000"
    fi
    case "$http" in
        2??)
            echo "[OK] SignalK restarted. Check it with: signalk health"
            ;;
        000|404)
            # Unreachable or an updater predating the route. Unlike pause/resume
            # there is nothing durable to lose, so the direct unit restart is a
            # complete answer rather than a degraded one.
            echo "[i] Updater API unavailable; restarting the unit directly." >&2
            if systemctl --user restart signalk-server.service; then
                echo "[OK] SignalK restarted. Check it with: signalk health"
            else
                echo "[ERR] systemctl --user restart signalk-server.service failed." >&2
                exit 1
            fi
            ;;
        *)
            echo "[ERR] Updater returned HTTP $http for /api/signalk/restart." >&2
            exit 1
            ;;
    esac
}

cmd_uninstall() {
    echo "Stopping signalk-* units..."
    for u in "${UNITS[@]}"; do
        systemctl --user stop "${u}.service" 2>/dev/null || true
    done

    echo "Removing Quadlet files..."
    for u in "${UNITS[@]}"; do
        rm -f "$QUADLET_DIR/${u}.container"
    done

    echo "Removing podman containers..."
    for u in "${UNITS[@]}"; do
        if podman container exists "$u" 2>/dev/null; then
            podman rm -f "$u" 2>/dev/null || true
        fi
    done

    # The dbus proxy's socket volume holds no data worth preserving —
    # it only ever contains the proxy's unix socket.
    podman volume rm signalk-dbus-socket 2>/dev/null || true

    # Remove the legacy podman API service override. Older installers wrote
    # it (--time=0 keep-alive) carrying --log-level=info, which fans out
    # dpkg-query on every API burst and storms the load. The current stack
    # uses socket activation and doesn't need it; clearing it on uninstall
    # means an uninstall+reinstall ends up clean (the current installer
    # doesn't recreate it).
    rm -f "$HOME/.config/systemd/user/podman.service.d/override.conf" 2>/dev/null || true
    rmdir "$HOME/.config/systemd/user/podman.service.d" 2>/dev/null || true

    systemctl --user daemon-reload || true

    # The "Preserved / To purge" guidance below lists paths INSIDE this host
    # ($HOME/.signalk etc.). On Windows this command runs inside the Podman
    # machine VM via the Windows `signalk` shim, so those are VM-internal paths
    # the Windows user can't reach, and "~/.local/bin/signalk — This command" is
    # wrong (on Windows the command is the .cmd shim on the Windows side). The
    # shim also immediately offers to remove the whole VM, which wipes all of
    # this anyway. So when invoked from the Windows shim (it sets
    # SIGNALK_WINDOWS_SHIM=1), suppress this host-path block; the shim prints its
    # own Windows-accurate summary and prompt. Keyed on the dedicated shim flag,
    # NOT SIGNALK_PUBLIC_HOST (which a Linux/macOS user may set just for URL
    # display — they must still see the purge guidance).
    if [[ "${SIGNALK_WINDOWS_SHIM:-0}" == "1" ]]; then
        echo
        echo "Stack removed inside the Podman machine. Your SignalK data still"
        echo "exists in the machine until you remove it (the next prompt does that)."
        return 0
    fi

    echo
    echo "Preserved (intentional):"
    echo "  ~/.signalk/                — SignalK configs + plugins"
    echo "  ~/.signalk-updater/        — Tokens, hardware.json"
    echo "  ~/.signalk-doctor/         — Snapshots, last-good.json"
    echo "  ~/.signalk-backup/         — Backup repo (if present)"
    echo "  ~/.local/bin/signalk-recovery — Host recovery script"
    echo "  ~/.local/bin/signalk       — This command"
    echo
    echo "To purge ALL data, run:"
    echo "  rm -rf ~/.signalk ~/.signalk-updater ~/.signalk-doctor ~/.signalk-backup"
    echo "  rm -f  ~/.local/bin/signalk ~/.local/bin/signalk-recovery \\"
    echo "         ~/.local/bin/signalk-socketcan ~/.local/bin/signalk-bluetooth"
    echo "  sudo systemctl disable --now signalk-timesync.timer"
    echo "  sudo rm -f /usr/local/bin/signalk-timesync /etc/default/signalk-timesync \\"
    echo "         /etc/systemd/system/signalk-timesync.{service,timer}"
    echo "  sudo systemctl daemon-reload"
    echo "Done."
}

cmd_bug_report() {
    # Output directory for the final tarball. Defaults to /tmp (the
    # historical behavior), but the `--to <dir>` flag lets callers like
    # signalk-doctor-server's POST /api/bug-report point this at a
    # container-readable path (e.g. ~/.signalk-doctor/bug-reports/ which
    # is bind-mounted into the doctor at /data/bug-reports).
    local tarball_dir="/tmp"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --to)
                if [[ -z "${2:-}" ]]; then
                    echo "[ERR] --to requires a directory argument" >&2
                    return 1
                fi
                tarball_dir="$2"
                shift 2
                ;;
            --to=*)
                tarball_dir="${1#--to=}"
                shift
                ;;
            *)
                echo "[ERR] Unknown bug-report argument: $1" >&2
                return 1
                ;;
        esac
    done
    # `--` so a directory name starting with `-` (e.g. someone passing
    # `--to --help` by mistake, setting tarball_dir="--help") is treated
    # as an operand, not an option.
    if ! mkdir -p -- "$tarball_dir" 2>/dev/null; then
        echo "[ERR] cannot create output directory $tarball_dir" >&2
        return 1
    fi
    if [[ ! -w "$tarball_dir" ]]; then
        echo "[ERR] output directory $tarball_dir is not writable" >&2
        return 1
    fi

    local stamp
    stamp=$(date -u +%Y%m%dT%H%M%SZ)
    local outdir
    outdir=$(mktemp -d -t signalk-bug-report.XXXXXX)
    local bundle="$outdir/signalk-bug-report-$stamp"
    # Declared here so the assignment inside the `{ … } >hardware-raw.txt`
    # brace group below is a plain re-bind. Brace groups don't open a
    # subshell, but `local` inside a redirected block reads oddly.
    local cfgfile=""
    # Cap on every `podman logs` call in this command. The journald log driver
    # makes `podman logs --tail N` scan the whole journal regardless of N, so a
    # chatty container (QuestDB routinely hits 500k+ lines, ~15-20s) would
    # otherwise dominate the bundle. Declared at function scope so BOTH the
    # parallel per-container capture and the rootless-journal fallback below use
    # the same bound; empty when `timeout` is absent (run direct). timeout is
    # coreutils, already relied on at install.sh's `timeout 900 podman run`.
    local LOGS_TIMEOUT=10
    local timeout_cmd=""
    command -v timeout >/dev/null 2>&1 && timeout_cmd="timeout $LOGS_TIMEOUT"
    mkdir -p "$bundle"

    echo "[i] Collecting diagnostics into $bundle"

    # Pick a container runtime. On hosts where both CLIs are present we
    # cannot guess from PATH alone — a developer with both installed
    # commonly has signalk-* containers under only one of them, and
    # picking the wrong one captures an empty bundle. Probe each engine
    # for signalk-* containers and prefer whichever actually answers;
    # only when neither has any (or one CLI is absent) fall back to
    # podman > docker for parity with the rest of the installer. If
    # neither is on PATH, CTR_CMD stays empty and the per-container
    # block becomes a no-op rather than failing under `set -e`.
    local CTR_CMD=""
    local podman_ctrs="" docker_ctrs=""
    if command -v podman >/dev/null 2>&1; then
        podman_ctrs=$(podman ps -a --filter 'name=signalk-' --format '{{.Names}}' 2>/dev/null || true)
    fi
    if command -v docker >/dev/null 2>&1; then
        docker_ctrs=$(docker ps -a --filter 'name=signalk-' --format '{{.Names}}' 2>/dev/null || true)
    fi
    if [[ -n "$podman_ctrs" ]]; then
        CTR_CMD=podman
    elif [[ -n "$docker_ctrs" ]]; then
        CTR_CMD=docker
    elif command -v podman >/dev/null 2>&1; then
        CTR_CMD=podman
    elif command -v docker >/dev/null 2>&1; then
        CTR_CMD=docker
    fi

    # Host context.
    {
        echo "=== signalk version ==="
        echo "installer: $SK_VERSION"
        echo
        echo "=== uname -a ==="
        uname -a 2>&1 || true
        echo
        echo "=== /etc/os-release ==="
        cat /etc/os-release 2>&1 || true
        echo
        echo "=== date ==="
        date -u 2>&1 || true
        echo
        echo "=== uptime ==="
        uptime 2>&1 || true
    } >"$bundle/host.txt" 2>&1

    # Container runtime.
    {
        echo "=== podman --version ==="
        podman --version 2>&1 || true
        echo
        echo "=== podman info ==="
        podman info 2>&1 || true
        echo
        echo "=== podman ps -a (signalk-) ==="
        # CreatedAt and Command round out the summary: CreatedAt dates the
        # container so "did my image switch actually recreate it?" is
        # answerable at a glance, and Command shows the effective
        # entrypoint+args (a wrong override is a common "won't start"
        # cause). Both also live in each containers/<name>.inspect.json,
        # but surfacing them here saves opening per-container JSON for the
        # first triage pass. Command goes last — it is the longest, most
        # variable field, so it sits at the tail of the tab-delimited row.
        podman ps -a --filter 'name=signalk-' \
            --format '{{.Names}}\t{{.Status}}\t{{.Image}}\t{{.CreatedAt}}\t{{.Command}}' 2>&1 || true
        echo
        echo "=== podman images (signalk + dirkwa) ==="
        podman images --format '{{.Repository}}:{{.Tag}}\t{{.ID}}\t{{.Created}}' \
            2>&1 | grep -E 'signalk|dirkwa' || true
        echo
        # Image-store size, not just the signalk/dirkwa rows. A rootless store
        # bloated with hundreds of orphaned <none> layers (rolling tags re-pulled
        # across reinstalls) makes `podman pull` crawl on slow SD/eMMC — the
        # "Copying blob …" hang. The filtered list above hides that entirely:
        # dangling layers carry no repo/tag, so they never match the grep, and a
        # 200+-image store reads as "clean". Surface the totals so the bloat is
        # visible in first-pass triage; `podman system df` (with reclaimable
        # bytes) lives in storage-and-cgroup.txt for the full breakdown.
        echo "=== image-store totals ==="
        echo "all images (incl. <none>): $(podman images -aq 2>/dev/null | wc -l)"
        echo "dangling <none> layers:    $(podman images -f dangling=true -q 2>/dev/null | wc -l)"
        echo
        echo "=== docker --version (if shim) ==="
        docker --version 2>&1 || true
    } >"$bundle/runtime.txt" 2>&1

    # Per-container inspect + logs for every signalk-* container.
    # signalk-container spawns user-data containers (Grafana, InfluxDB,
    # MQTT, …) alongside the three engine containers. They share the
    # rootless idmap/cgroup/storage layer, so when "image switch" or
    # "container won't start" is reported the cause is often in the
    # HostConfig (Memory/PidsLimit), Mounts (UidMap/GidMap), or in the
    # container's own logs — not in the engine's view of the world.
    #
    # podman inspect includes the full Env list, which routinely holds
    # admin passwords for user containers (Grafana admin, InfluxDB
    # token, MQTT broker auth). Redact env values (keep keys so a
    # reviewer can see what the container expected); same model as
    # pipedProviders' options below. Mounts are kept verbatim — paths
    # are not secret and idmap settings (UidMap/GidMap) are the data we
    # are after.
    mkdir -p "$bundle/containers"
    if [[ -z "$CTR_CMD" ]]; then
        echo "(no container runtime on PATH — podman and docker both absent)" \
            >"$bundle/containers/INDEX.txt"
    else
        mapfile -t SIGNALK_CTRS < <(
            "$CTR_CMD" ps -a --filter 'name=signalk-' --format '{{.Names}}' 2>/dev/null || true
        )
        {
            echo "=== captured ${#SIGNALK_CTRS[@]} signalk-* container(s) via $CTR_CMD ==="
            printf '  %s\n' "${SIGNALK_CTRS[@]}"
        } >"$bundle/containers/INDEX.txt"
        # Capture each container concurrently and under the shared $timeout_cmd
        # bound (declared at function scope above). Fanning out is safe because
        # every job writes ONLY to its own files (${ctr}.inspect.json /
        # ${ctr}.log) — no shared output to interleave — so with the per-call
        # timeout in place the whole phase is capped at ~LOGS_TIMEOUT, not the
        # sum of every call. Each job is a subshell whose inner commands swallow
        # their own failures (|| true / || echo / captured rc), so one wedged
        # container can't fail the others; `wait || true` keeps a non-zero child
        # from tripping the dispatcher's `set -e`. No bare `wait` race: nothing
        # else in this command is backgrounded before this point.
        for ctr in "${SIGNALK_CTRS[@]}"; do
            [[ -n "$ctr" ]] || continue
            (
                if command -v jq >/dev/null 2>&1; then
                    # Env values are redacted EXCEPT, on the two engine
                    # containers only, the installer-owned health/base
                    # URLs — they are exactly what is needed to diagnose a
                    # broken container-to-host probe path (the 2026-07-12
                    # field report had them redacted and the updater's
                    # failing /signalk probe could not be traced to its
                    # target URL). The preserved values are still
                    # sanitized, not trusted by key name: only
                    # scheme://host[:port]/path survives; userinfo, query
                    # and fragment are stripped, and a value that is not
                    # URL-shaped falls back to full redaction (a
                    # hand-edited Quadlet could put credentials there).
                    # Other signalk-* containers (grafana, questdb,
                    # user-added) get the blanket redaction: a same-named
                    # key there is not installer-owned.
                    allow_urls=false
                    case "$ctr" in
                        signalk-updater-server|signalk-doctor-server) allow_urls=true ;;
                    esac
                    "$CTR_CMD" inspect "$ctr" 2>/dev/null \
                        | jq --argjson allow "$allow_urls" 'map(.Config.Env |= (
                                if . == null then null
                                else map(
                                    if $allow and test("^(SIGNALK_HEALTH_URL|SIGNALK_URL|SIGNALK_HTTPS_URL|DOCTOR_HEALTH_URL)=https?://([^/?#@]*@)?[^:/?#@]")
                                    then sub("^(?<k>[^=]+)=(?<sch>https?://)([^/?#]*@)?(?<hp>[^?#@]*).*$"; "\(.k)=\(.sch)\(.hp)")
                                    else sub("(?<k>^[^=]+)=.*"; "\(.k)=<redacted>")
                                    end)
                                end))' \
                        >"$bundle/containers/${ctr}.inspect.json" 2>&1 \
                        || echo "($CTR_CMD inspect or jq failed for $ctr)" \
                            >"$bundle/containers/${ctr}.inspect.json"
                else
                    # No jq → fall back to a clear marker, do not dump raw env.
                    echo "(jq not installed; skipping inspect dump to avoid leaking env values)" \
                        >"$bundle/containers/${ctr}.inspect.json"
                fi
                # Bounded logs — 500 lines is enough for a recent failure
                # signature without ballooning the bundle for chatty containers
                # (Grafana, QuestDB). $timeout_cmd is unquoted on purpose: it is
                # either empty (timeout absent → run direct) or two words.
                logs_rc=0
                # shellcheck disable=SC2086
                $timeout_cmd "$CTR_CMD" logs --tail 500 "$ctr" \
                    >"$bundle/containers/${ctr}.log" 2>&1 || logs_rc=$?
                # Only exit 124 means `timeout` fired — the file then holds
                # however much streamed before the cutoff, so flag it as a
                # truncated tail. Any other non-zero is an ordinary logs
                # failure (container gone, permission denied) whose own error
                # text is already in the file; do not mislabel it as truncated.
                if [[ "${logs_rc:-0}" -eq 124 ]]; then
                    echo "(log capture timed out after ${LOGS_TIMEOUT}s — truncated; this container is very chatty)" \
                        >>"$bundle/containers/${ctr}.log"
                fi
            ) &
        done
        wait || true
    fi

    # systemd-user state.
    {
        echo "=== systemctl --user list-unit-files signalk-* ==="
        systemctl --user list-unit-files 'signalk-*' 2>&1 || true
        echo
        echo "=== systemctl --user list-units signalk-* (incl. inactive) ==="
        systemctl --user list-units --all 'signalk-*' 2>&1 || true
        echo
        # Per-unit status with -l so long lines aren't truncated. The
        # restart-timing field 'Active: active (running) since ...' and
        # the recent journal slice 'systemd[778]: Scheduled restart job,
        # restart counter is at N' are the most useful pieces for
        # diagnosing "I clicked Restart but it didn't come back".
        for u in "${UNITS[@]}"; do
            echo "=== systemctl --user status -l ${u}.service ==="
            systemctl --user status -l --no-pager "${u}.service" 2>&1 || true
            echo
        done
        # Drop-ins under .service.d/ are operator overrides the Quadlet
        # itself doesn't show. They explain otherwise-surprising
        # behavior changes; capture path + contents.
        for u in "${UNITS[@]}"; do
            dropdir="$HOME/.config/systemd/user/${u}.service.d"
            if [[ -d "$dropdir" ]]; then
                echo "=== $dropdir contents ==="
                ls -la "$dropdir" 2>&1 || true
                for f in "$dropdir"/*.conf; do
                    [[ -f "$f" ]] || continue
                    echo "--- $f ---"
                    cat "$f" 2>&1 || true
                done
                echo
            fi
        done
        echo "=== systemd-analyze --user blame (top 15) ==="
        systemd-analyze --user blame 2>&1 | head -15 || true
        echo
        echo "=== systemctl --user list-jobs ==="
        # If a start/restart is stuck waiting on a dependency the
        # journal often hides, the job queue surfaces it.
        systemctl --user list-jobs 2>&1 || true
        echo
        echo "=== loginctl show-user (Linger) ==="
        loginctl show-user "$USER" -p Linger 2>&1 || true
    } >"$bundle/systemd.txt" 2>&1

    # Journal — last 24h per unit. -x adds systemd's explanation lines
    # (Subject:/Defined-By: blocks). Truncate aggressively; logs are
    # noisy but the explanation lines are essential for "why didn't
    # this unit start when it should have."
    #
    # On rootless-podman hosts `journalctl --user -u <quadlet-unit>` is usually
    # EMPTY ("No journal files were found") — conmon logs the container's
    # stdout/stderr under the CONTAINER identifier, not the systemd user unit.
    # The container's own output (the actual signalk-server startup, the thing
    # that matters when a start times out) is captured separately into
    # containers/<name>.log via `$CTR_CMD logs`. When the journal slice comes
    # back empty, append those container logs here too so journal-<unit>.log is
    # never a dead end, and point at the authoritative file.
    local out
    for u in "${UNITS[@]}"; do
        out="$bundle/journal-${u}.log"
        journalctl --user -xeu "${u}.service" --since '24 hours ago' --no-pager \
            >"$out" 2>&1 || true
        if ! grep -q . "$out" 2>/dev/null || grep -q 'No journal files were found' "$out" 2>/dev/null; then
            {
                echo "(no systemd user-journal entries — rootless podman logs the"
                echo " container under its own identifier; see containers/${u}.log)"
                if [ -n "$CTR_CMD" ]; then
                    echo
                    echo "=== $CTR_CMD logs --tail 200 ${u} ==="
                    # Same $timeout_cmd bound as the parallel capture above: a
                    # chatty engine container must not stall the fallback path
                    # either. Capture the rc rather than `|| true` so a real
                    # timeout (124) is marked incomplete here too — without it a
                    # timed-out fallback would read as a complete --tail 200.
                    # $timeout_cmd is empty or two words, hence unquoted.
                    fallback_rc=0
                    # shellcheck disable=SC2086
                    $timeout_cmd "$CTR_CMD" logs --tail 200 "$u" 2>&1 || fallback_rc=$?
                    if [[ "${fallback_rc:-0}" -eq 124 ]]; then
                        echo "(log capture timed out after ${LOGS_TIMEOUT}s — truncated; this container is very chatty)"
                    fi
                fi
            } >>"$out"
        fi
    done

    # Quadlet sources (config, not secrets).
    mkdir -p "$bundle/quadlets"
    for u in "${UNITS[@]}"; do
        if [[ -f "$QUADLET_DIR/${u}.container" ]]; then
            cp "$QUADLET_DIR/${u}.container" "$bundle/quadlets/${u}.container"
        fi
    done

    # Doctor snapshots index (file listing only — snapshot contents
    # could be large and contain the same Quadlets we already copied).
    {
        echo "=== last-good.json ==="
        cat "$HOME/.signalk-doctor/last-good.json" 2>&1 || true
        echo
        echo "=== snapshot file listing ==="
        ls -la "$HOME/.signalk-doctor/snapshots/" 2>&1 || true
    } >"$bundle/doctor-state.txt" 2>&1

    # Token presence — NEVER the value.
    {
        for f in "$HOME/.signalk-updater/token" "$HOME/.signalk-doctor/token"; do
            if [[ -f "$f" ]]; then
                local mode
                mode=$(stat -c '%a' "$f" 2>/dev/null || echo "?")
                printf '%s — present, mode %s\n' "$f" "$mode"
            else
                printf '%s — MISSING\n' "$f"
            fi
        done
    } >"$bundle/tokens.txt" 2>&1

    # Console health.
    {
        for entry in \
            "signalk-server  $SIGNALK_URL" \
            "updater (:3003) $UPDATER_URL/api/health" \
            "doctor (:3004)  $DOCTOR_URL/api/health"; do
            name=${entry% *}
            url=${entry##* }
            echo "--- $name ($url) ---"
            curl -fsS -m 5 "$url" 2>&1 || echo "(unreachable)"
            echo
        done
    } >"$bundle/console-health.txt" 2>&1

    # In-container reachability — probe the health URLs from INSIDE the
    # updater container. The updater reaches its siblings through pasta's
    # host.containers.internal mapping, a path that can be broken while
    # every host-side curl above succeeds (2026-07-12 field report: the
    # updater's /signalk probe hung on every /api/state poll and nothing
    # in the bundle could show it). NODE_TLS_REJECT_UNAUTHORIZED=0
    # mirrors the engine's own probe, which accepts signalk-server's
    # self-signed cert behind the SSL plugin's :80 -> :443 redirect.
    # The probes run concurrently, so the worst case (every URL
    # blackholed, plus node startup) is one 4s fetch timeout — well
    # under the shared $timeout_cmd bound of ${LOGS_TIMEOUT}s.
    if [[ -n "$CTR_CMD" ]] \
        && "$CTR_CMD" ps --format '{{.Names}}' 2>/dev/null | grep -qx 'signalk-updater-server'; then
        # SC2086: $timeout_cmd is empty or two words, unquoted on purpose.
        # SC2016: the ${...} inside the single-quoted -e script are JS
        # template literals evaluated by node, not shell expansions.
        # shellcheck disable=SC2086,SC2016
        $timeout_cmd "$CTR_CMD" exec -e NODE_TLS_REJECT_UNAUTHORIZED=0 \
            signalk-updater-server node -e '
            const urls = [
                ["SIGNALK_HEALTH_URL", process.env.SIGNALK_HEALTH_URL],
                ["DOCTOR_HEALTH_URL", process.env.DOCTOR_HEALTH_URL],
            ];
            // Never echo the raw value: a hand-edited Quadlet could carry
            // credentials or query tokens in these URLs. Keep only
            // scheme://host[:port]/path for the report, and only for
            // http(s) targets with a real host — anything else is shown
            // as a placeholder.
            const shown = (raw) => {
                try {
                    const u = new URL(raw);
                    if ((u.protocol !== "http:" && u.protocol !== "https:") || !u.hostname) {
                        return "(non-http URL)";
                    }
                    return `${u.origin}${u.pathname}`;
                } catch { return "(unparseable URL)"; }
            };
            const probe = async ([key, url]) => {
                if (!url) return `${key}: (not set)`;
                const label = shown(url);
                const started = Date.now();
                try {
                    const res = await fetch(url, { signal: AbortSignal.timeout(4000) });
                    return `${key}: ${label} -> HTTP ${res.status} in ${Date.now() - started}ms`;
                } catch (err) {
                    // errno codes and error names are stable, URL-free
                    // identifiers; never fall back to stringifying the
                    // error itself, which can embed the raw URL.
                    const code =
                        (err && err.cause && err.cause.code) ||
                        (err && err.code) || (err && err.name) || "unknown-error";
                    return `${key}: ${label} -> FAILED (${code}) after ${Date.now() - started}ms`;
                }
            };
            (async () => {
                // Concurrent, so N blackholed URLs cost one 4s timeout,
                // not N; results print in fixed order regardless of
                // completion order.
                const lines = await Promise.all(urls.map(probe));
                for (const line of lines) console.log(line);
            })();
        ' >"$bundle/in-container-probes.txt" 2>&1 \
            || echo "(exec probe failed; see any output above)" >>"$bundle/in-container-probes.txt"
    else
        echo "(signalk-updater-server not running; in-container probe skipped)" \
            >"$bundle/in-container-probes.txt"
    fi

    # Doctor + updater deep snapshots — the data needed to debug an
    # image switch (operator-intent tag vs. running tag vs. reported
    # version vs. last-known-good vs. snapshot inventory). Captured as
    # raw JSON so jq queries against the bundle work post-hoc. The
    # doctor's probes are unauthenticated by design; the updater's
    # read-only endpoints used here (/api/health, /api/state,
    # /api/hardware) are also unauthenticated. Mutating endpoints stay
    # untouched. Save each endpoint to its own file so a single
    # unreachable endpoint doesn't corrupt the rest, and so reviewers
    # can grep for a specific shape.
    mkdir -p "$bundle/doctor" "$bundle/updater"
    for entry in \
        "doctor/health           $DOCTOR_URL/api/health" \
        "doctor/probes           $DOCTOR_URL/api/probes" \
        "doctor/snapshots        $DOCTOR_URL/api/snapshots" \
        "doctor/last-good        $DOCTOR_URL/api/last-good" \
        "updater/health          $UPDATER_URL/api/health" \
        "updater/state           $UPDATER_URL/api/state" \
        "updater/hardware        $UPDATER_URL/api/hardware"; do
        rel=${entry%% *}
        url=${entry##* }
        out="$bundle/${rel}.json"
        if ! curl -fsS -m 10 -o "$out" "$url" 2>"${out}.err"; then
            # Move stderr next to the missing payload so the failure is
            # visible without cross-referencing.
            mv "${out}.err" "${out}" 2>/dev/null || true
            echo "(failed to fetch $url — see this file for curl error)" >>"$out"
        else
            rm -f "${out}.err" 2>/dev/null || true
        fi
    done

    # Hardware detection (non-secret).
    if [[ -f "$HOME/.signalk-updater/hardware.json" ]]; then
        cp "$HOME/.signalk-updater/hardware.json" "$bundle/hardware.json"
    fi

    # Installer run log — install.sh tees its console output here so a
    # failed install (esp. a pre-container failure: preflight, podman
    # setup, image pull, npm) leaves an on-disk trace to ship. The
    # installer prints no secrets; tokens are generated via podman/exec
    # and never echoed. Absent on installs from before this was added,
    # or when the operator set SIGNALK_NO_INSTALL_LOG.
    if [[ -f "$HOME/.signalk-updater/install.log" ]]; then
        cp "$HOME/.signalk-updater/install.log" "$bundle/install.log" 2>/dev/null || true
    fi

    # SignalK plugin state — metadata only, no configuration bodies.
    # Plugin configs in plugin-config-data/*.json routinely hold
    # secrets (MQTT passwords, cloud-sync API keys, OAuth tokens) and
    # there is no central registry of which fields are sensitive across
    # the whole plugin ecosystem. Limit the bundle to id + version +
    # enabled flag so the bug report shows which plugins are installed
    # and which are running, without leaking credentials. Operators who
    # need to share a specific plugin's config can attach it manually.
    SIGNALK_DIR="$HOME/.signalk"
    if [[ -d "$SIGNALK_DIR" ]] && command -v jq >/dev/null 2>&1; then
        cfg_dir="$SIGNALK_DIR/plugin-config-data"
        pkg="$SIGNALK_DIR/package.json"
        {
            echo "=== SignalK plugin state (metadata only) ==="
            echo "# Configuration bodies are intentionally NOT included."
            echo "# Plugin configs routinely contain credentials."
            echo
            count=0
            if [[ -d "$cfg_dir" ]]; then
                for f in "$cfg_dir"/*.json; do
                    [[ -f "$f" ]] || continue
                    plugin_id=$(basename "$f" .json)
                    enabled=$(jq -r '.enabled // "?"' "$f" 2>/dev/null || echo "?")
                    case "$enabled" in
                        true)  flag="on " ;;
                        false) flag="off" ;;
                        *)     flag="?  " ;;
                    esac
                    version=""
                    if [[ -f "$pkg" ]]; then
                        # Scoped packages: config file is unscoped
                        # (zones.json) but the dependency key is scoped
                        # (@signalk/zones). Try the literal id, then
                        # walk dependencies for any key ending in /<id>.
                        version=$(jq -r --arg id "$plugin_id" '
                            .dependencies[$id] //
                            (.dependencies | to_entries
                                | map(select(.key | endswith("/" + $id)))
                                | .[0].value) //
                            "(not in package.json)"
                        ' "$pkg" 2>/dev/null || echo "?")
                    else
                        version="(no package.json)"
                    fi
                    printf '  [%s] %-30s  %s\n' "$flag" "$plugin_id" "$version"
                    count=$((count + 1))
                done
            fi
            echo
            echo "$count plugin(s) with config files in plugin-config-data/."
        } >"$bundle/signalk-plugins.txt" 2>&1
    elif [[ -d "$SIGNALK_DIR" ]]; then
        echo "jq not installed; signalk-plugins.txt and signalk-settings.json skipped." \
            >"$bundle/signalk-plugins.txt"
    fi

    # SignalK server settings — connections, source priorities, security
    # strategy. settings.json is mostly safe but pipedProviders' .options
    # block sometimes holds passwords (ydwg auth, MQTT bridges). Redact
    # those values (keeping option keys so connection schema stays
    # visible); leave the rest of settings.json verbatim.
    if [[ -f "$SIGNALK_DIR/settings.json" ]] && command -v jq >/dev/null 2>&1; then
        # For each pipedProviders entry that has an .options object,
        # replace every option value with "<redacted>" (keeping the keys
        # so the connection schema stays visible). The outer guard is
        # load-bearing: `(.pipedProviders // []) |= map(...)` THROWS
        # "Invalid path expression with result []" whenever pipedProviders
        # is absent (jq can't assign back through the // default), which
        # used to make a perfectly valid settings.json look like it
        # "failed to parse". Gating on the array type makes the redaction
        # a no-op when there are no providers, instead of an error.
        if jq 'if (.pipedProviders | type) == "array"
                then .pipedProviders |= map(
                    if (.options | type) == "object"
                    then .options |= with_entries(.value = "<redacted>")
                    else . end)
                else . end' \
            "$SIGNALK_DIR/settings.json" >"$bundle/signalk-settings.json" 2>/dev/null; then
            : # redacted copy written
        elif jq -e . "$SIGNALK_DIR/settings.json" >/dev/null 2>&1; then
            # Valid JSON, but the redaction filter still failed (an
            # unexpected pipedProviders shape). Never copy verbatim — that
            # could leak connection passwords. Drop pipedProviders wholesale
            # and note it, so the rest of settings.json is still useful.
            if ! jq 'del(.pipedProviders)' "$SIGNALK_DIR/settings.json" \
                >"$bundle/signalk-settings.json" 2>/dev/null; then
                echo "# settings.json present but could not be safely redacted; omitted" \
                    >"$bundle/signalk-settings.json"
            fi
        else
            echo "# settings.json is not valid JSON (server reads it once at startup, so it may still be running fine)" \
                >"$bundle/signalk-settings.json"
        fi
    fi

    # Container storage state — surfaces ZFS/idmap hazards.
    {
        echo "=== rootless storage path ==="
        echo "${XDG_DATA_HOME:-$HOME/.local/share}/containers/storage"
        echo
        echo "=== stat -f -c %T ==="
        stat -f -c '%T' "${XDG_DATA_HOME:-$HOME/.local/share}/containers/storage" 2>&1 || true
        echo
        echo "=== ~/.config/containers/storage.conf ==="
        cat "${XDG_CONFIG_HOME:-$HOME/.config}/containers/storage.conf" 2>&1 || echo "(absent — using podman defaults)"
        echo
        echo "=== /proc/cmdline ==="
        cat /proc/cmdline 2>&1 || true
        echo
        echo "=== /sys/fs/cgroup/cgroup.controllers ==="
        cat /sys/fs/cgroup/cgroup.controllers 2>&1 || true
        echo
        # /etc/subuid + /etc/subgid drive the rootless idmap range
        # podman allocates per container. "newuidmap: write to uid_map
        # failed" or "no subuid ranges found for user X" failures land
        # here, not in any of the other files.
        echo "=== /etc/subuid ($USER row) ==="
        grep -E "^($USER|$(id -u)):" /etc/subuid 2>&1 || echo "(no entry — rootless containers will fail to map)"
        echo
        echo "=== /etc/subgid ($USER row) ==="
        grep -E "^($USER|$(id -u)):" /etc/subgid 2>&1 || echo "(no entry — rootless containers will fail to map)"
        echo
        # podman system info as JSON is much easier to grep post-hoc
        # than the colored, multi-section default output already captured
        # in runtime.txt. Skip silently if the runtime is docker.
        if [[ "$CTR_CMD" == "podman" ]]; then
            echo "=== podman system info --format json ==="
            podman system info --format json 2>&1 || true
            echo
            # Per-image sizes + reclaimable bytes. This is the decisive view for
            # the "Copying blob … hangs" report: a store carrying hundreds of
            # orphaned layers across reinstalls shows up here as a large
            # reclaimable figure, where runtime.txt's filtered list cannot.
            echo "=== podman system df -v ==="
            podman system df -v 2>&1 || true
            echo
            # Raw on-disk store size, independent of podman's accounting (catches
            # leftover/partial layer dirs an interrupted pull left behind).
            echo "=== du -sh of the rootless store ==="
            du -sh "${XDG_DATA_HOME:-$HOME/.local/share}/containers/storage" 2>&1 || true
        elif [[ "$CTR_CMD" == "docker" ]]; then
            echo "=== docker info --format '{{json .}}' ==="
            docker info --format '{{json .}}' 2>&1 || true
        fi
    } >"$bundle/storage-and-cgroup.txt" 2>&1

    # Raw hardware bus enumeration — the "why didn't detection see my
    # device" file. ~/.signalk-updater/hardware.json reports the post-
    # detection summary (`serial: []`, `can: []`, etc.). When that comes
    # back empty for a user who insists they have a CAN HAT / NMEA cable
    # plugged in, this file is what we'd ask them to paste anyway:
    #   - lsusb: vendor/product IDs even if no /dev/serial/by-id link
    #     (covers raw-USB N2K devices, unclassified cables).
    #   - /dev/serial/by-id + /dev/serial/by-path: what udev exposes,
    #     stable names.
    #   - ip -br link: every interface incl. can0 whether up or down;
    #     ethernet, podman bridges.
    #   - Pi config.txt dtoverlay/dtparam lines: answers "is the HAT
    #     wired into device-tree?" for socketcan + SPI hats.
    #   - Loaded kernel modules in the can/usb-serial families: tells
    #     us whether socketcan is registered even when no interface is
    #     up — distinguishes "module missing" from "interface down."
    # Privacy: lsusb shows vendor IDs (not secrets). `ip` calls show
    # IPs and MACs — same data any LAN-attached attacker could trivially
    # see; acceptable for an opt-in bug report.
    {
        echo "=== lsusb ==="
        if command -v lsusb >/dev/null 2>&1; then
            lsusb 2>&1 || true
        else
            echo "(lsusb not installed)"
        fi
        echo
        echo "=== /dev/serial/by-id ==="
        ls -la /dev/serial/by-id/ 2>&1 || echo "(absent — no USB serial enumerated)"
        echo
        echo "=== /dev/serial/by-path ==="
        ls -la /dev/serial/by-path/ 2>&1 || echo "(absent)"
        echo
        echo "=== /dev/ttyUSB* /dev/ttyACM* ==="
        # Capture once and branch on emptiness rather than
        # `ls … || echo "(no devices)"`. The naive form fires the
        # placeholder whenever ANY pattern is unmatched, even when the
        # other matched — e.g. a host with /dev/ttyUSB0 but no ttyACM
        # would show the device AND a misleading "(no … devices)" line
        # right below it.
        # `|| true` keeps `set -e` from aborting when neither glob
        # matches; the `[[ -n ]]` check below differentiates "no
        # devices" (empty capture) from "ls failed for some other
        # reason" (also empty — same UX as before, no need to fork).
        tty_list=$(ls -la /dev/ttyUSB* /dev/ttyACM* 2>/dev/null || true)
        if [[ -n "$tty_list" ]]; then
            printf '%s\n' "$tty_list"
        else
            echo "(no ttyUSB/ttyACM devices)"
        fi
        echo
        echo "=== ip -br link ==="
        ip -br link 2>&1 || true
        echo
        echo "=== ip -br addr ==="
        ip -br addr 2>&1 || true
        echo
        echo "=== loaded modules (can / usb-serial families) ==="
        # Use lsmod | awk so columns stay aligned. Module families chosen
        # for marine-hardware coverage: socketcan core (`can`, `can_raw`),
        # MCP251x SPI hats, Peak/Kvaser/Geschwister Schneider USB CAN,
        # SLCAN; FTDI/CH341/PL2303/CP210x USB-serial chips powering most
        # NMEA0183 + N2K USB gateways.
        if command -v lsmod >/dev/null 2>&1; then
            # Match $1 directly rather than `^(…)\b` because mawk (default
            # awk on Debian) doesn't understand `\b` and silently drops
            # every row, leaving just the header in the bundle. Trailing
            # `|| true` keeps the bug-report run from aborting under
            # `set -euo pipefail` if lsmod itself errors — every other
            # collector in this block is guarded the same way.
            lsmod 2>/dev/null \
                | awk 'NR==1 || $1 ~ /^(can|can_raw|can_dev|vcan|mcp251x|mcp251xfd|peak_usb|peak_pci|kvaser_usb|gs_usb|slcan|ftdi_sio|ch341|pl2303|cp210x|cdc_acm)$/' \
                || true
        else
            echo "(lsmod not installed)"
        fi
        echo
        # Pi-specific: device-tree model + config.txt overlay/param
        # lines + vcgencmd power/thermal state. Gated on /proc/device-tree
        # so we don't emit empty Pi sections on non-Pi hosts.
        if [[ -r /proc/device-tree/model ]] \
            && grep -qi 'raspberry pi' /proc/device-tree/model 2>/dev/null; then
            echo "=== /proc/device-tree/model ==="
            tr -d '\0' </proc/device-tree/model 2>&1 || true
            echo
            # /boot/firmware/cmdline.txt + config.txt are Pi OS's canonical
            # locations on bookworm+. Older Pi OS used /boot/. Try both.
            cfgfile=""
            for candidate in /boot/firmware/config.txt /boot/config.txt; do
                if [[ -r "$candidate" ]]; then
                    cfgfile="$candidate"
                    break
                fi
            done
            echo "=== ${cfgfile:-config.txt} dtoverlay / dtparam ==="
            if [[ -n "$cfgfile" ]]; then
                grep -E '^\s*(dtoverlay|dtparam)=' "$cfgfile" 2>&1 \
                    || echo "(no dtoverlay/dtparam lines)"
            else
                echo "(config.txt not readable at /boot/firmware or /boot)"
            fi
            echo
            echo "=== vcgencmd get_throttled ==="
            # 0x0 = clean. Bits 0/16 = currently/historically undervoltage,
            # 1/17 = arm-freq capped, 2/18 = throttled, 3/19 = soft temp
            # limit. One line answers "is your PSU healthy?"
            if command -v vcgencmd >/dev/null 2>&1; then
                vcgencmd get_throttled 2>&1 || true
                echo
                echo "=== vcgencmd measure_temp ==="
                vcgencmd measure_temp 2>&1 || true
            else
                echo "(vcgencmd not installed)"
            fi
        fi
    } >"$bundle/hardware-raw.txt" 2>&1

    # Host headroom + recent kernel events — the "is the host itself
    # healthy?" file. Separate from storage-and-cgroup.txt (rootless
    # podman plumbing) because these are general-host concerns that
    # explain seemingly-unrelated symptoms:
    #   - Disk full → containers fail to write, journald drops entries,
    #     signalk-server "randomly" stops.
    #   - Inodes exhausted (common on Pi OS SD cards) → same as above,
    #     but `df -h` looks fine.
    #   - dmesg warn/err → USB enumeration failures, undervoltage
    #     brownouts, OOM kills, EMMC corruption, MCP251x init errors.
    #   - Failed systemd-user units → e.g. dbus broker down → bluetooth
    #     probe will always say "missing" regardless of our config.
    #   - Listening sockets on signalk ports → confirms what bound where
    #     (signalk-server vs. a stray dev server on :3000).
    # dmesg can carry MAC addresses and filesystem paths. The bundle
    # README below already warns users to review before sharing; this
    # comment keeps the rationale next to the collection.
    {
        echo "=== df -hT ==="
        df -hT 2>&1 || true
        echo
        echo "=== df -i ==="
        df -i 2>&1 || true
        echo
        echo "=== systemctl --user --failed ==="
        systemctl --user --failed 2>&1 || true
        echo
        echo "=== systemd-analyze --user time ==="
        systemd-analyze --user time 2>&1 || true
        echo
        echo "=== ss -tln (signalk ports) ==="
        # Match the six ports the installer cares about: 80/443 standard,
        # 3000/3443 default signalk, 3003 updater, 3004 doctor. Awk
        # filters keep this short even on hosts with hundreds of listeners.
        if command -v ss >/dev/null 2>&1; then
            # `($|[^0-9])` rather than `\>` because the latter is a GNU
            # awk extension; mawk treats it as a literal `>` and the
            # filter would drop every row. The non-digit/end-anchor
            # form is POSIX and still rejects e.g. :8080 when we ask
            # for :80.
            ss -tln 2>&1 | awk 'NR==1 || /:(80|443|3000|3003|3004|3443)($|[^0-9])/' \
                || true
        else
            echo "(ss not installed)"
        fi
        echo
        echo "=== dmesg --level=err,warn (last 200) ==="
        # Filtered first: only warn+err, drops "USB device enumerated OK"
        # chatter while keeping every failure signal we care about.
        # Rootless dmesg is restricted to root since kernel.dmesg_restrict
        # = 1 on Debian; best-effort, fall through to the placeholder
        # when the kernel refuses.
        if dmesg --level=err,warn --notime 2>/dev/null | tail -200 >/dev/null 2>&1; then
            dmesg -T --level=err,warn 2>&1 | tail -200 || true
        else
            echo "(dmesg restricted to root on this host — try 'sudo dmesg' manually)"
        fi
        echo
        echo "=== dmesg (last 200, unfiltered tail for recent context) ==="
        # Unfiltered tail surfaces "what just happened" — useful when the
        # warn/err filter would miss a clean USB hot-plug event right
        # before the bug report ran.
        if dmesg --notime 2>/dev/null | tail -1 >/dev/null 2>&1; then
            dmesg -T 2>&1 | tail -200 || true
        else
            echo "(dmesg restricted to root on this host — try 'sudo dmesg' manually)"
        fi
        echo
        echo "=== signalk-timesync (host clock/timezone from GPS) ==="
        # Wrong boat time breaks TLS, log ordering, and track timestamps;
        # capture whether the host agent exists, ticks, and what its last
        # runs decided.
        if [[ -x /usr/local/bin/signalk-timesync ]]; then
            # status (not list-timers): a disabled timer disappears from
            # list-timers, and "disabled" vs "not installed" matters here.
            systemctl status --no-pager signalk-timesync.timer 2>&1 | sed -n '1,4p' || true
            timedatectl 2>&1 | sed -n '1,5p' || true
            journalctl -u signalk-timesync.service -n 10 --no-pager -o short-iso 2>/dev/null \
                || echo "(journal not readable as this user)"
        else
            echo "(signalk-timesync not installed)"
        fi
        echo
        echo "=== pasta / passt (rootless networking backend) ==="
        # podman >= 5 defaults rootless networking to pasta, but on Debian
        # passt is only a Recommends of podman and Armbian ships with APT
        # recommends off — podman looks healthy while every pasta-networked
        # container (updater, doctor) fails to start (2026-07 Orange Pi
        # field report).
        if command -v pasta >/dev/null 2>&1; then
            command -v pasta
            pasta --version 2>&1 | head -1 || true
        else
            echo "(pasta NOT found — pasta-networked containers cannot start)"
        fi
        echo
        echo "=== aardvark-dns (DNS on user-defined container networks) ==="
        # Same Recommends gap as passt, one layer down: netavark only
        # Recommends aardvark-dns, so on recommends-off hosts containers on
        # user-defined networks (grafana, questdb) get the bridge gateway
        # as nameserver with nothing listening on :53 — every lookup fails
        # with "connection refused" (2026-07 Orange Pi field report). Ask
        # podman where it resolved the helper (covers custom
        # helper_binaries_dir); not on PATH, so fall back to the packaged
        # locations.
        aardvark_bin=""
        if command -v podman >/dev/null 2>&1; then
            aardvark_bin="$(podman info --format '{{.Host.NetworkBackendInfo.DNS.Path}}' 2>/dev/null || true)"
        fi
        if [[ -z "$aardvark_bin" || ! -x "$aardvark_bin" ]]; then
            aardvark_bin=""
            for c in /usr/lib/podman/aardvark-dns /usr/libexec/podman/aardvark-dns; do
                if [[ -x "$c" ]]; then
                    aardvark_bin="$c"
                    break
                fi
            done
        fi
        if [[ -z "$aardvark_bin" ]]; then
            aardvark_bin="$(command -v aardvark-dns 2>/dev/null || true)"
        fi
        if [[ -n "$aardvark_bin" ]]; then
            echo "$aardvark_bin"
            "$aardvark_bin" --version 2>&1 | head -1 || true
        else
            echo "(aardvark-dns NOT found — DNS is dead on user-defined networks)"
        fi
        echo
        echo "=== nftables (netavark firewall backend) ==="
        # Third Recommends gap in the same family: netavark execs nft when
        # it wires a container network, but nftables is only a Recommends
        # of netavark — on recommends-off hosts (Armbian) every bridge-
        # networked container (grafana, questdb, backup) fails to start
        # with "netavark: unable to execute nft" (issue #171 field
        # report). nft lives in /usr/sbin, often not on user PATH.
        nft_bin="$(command -v nft 2>/dev/null || true)"
        if [[ -z "$nft_bin" ]]; then
            for c in /usr/sbin/nft /sbin/nft; do
                if [[ -x "$c" ]]; then
                    nft_bin="$c"
                    break
                fi
            done
        fi
        if [[ -n "$nft_bin" ]]; then
            echo "$nft_bin"
            "$nft_bin" --version 2>&1 | head -1 || true
        else
            echo "(nft NOT found — netavark cannot wire bridge networks)"
        fi
        echo
        echo "=== canboatjs native canSocket addon (server image) ==="
        # canbus-canboatjs needs canboatjs's compiled SocketCAN addon. Its
        # install script is `node-gyp rebuild || echo ...`, so a build skip
        # (npm >= 12 script-approval gate, 2026-07 images) is silent and
        # every host-side CAN check still passes. This probe separates
        # "CAN host config broken" from "server image broken".
        if [[ -n "$CTR_CMD" ]] \
            && "$CTR_CMD" ps --format '{{.Names}}' 2>/dev/null | grep -qx 'signalk-server'; then
            # Only exit status 1 proves the file is absent; any other
            # status is the exec/timeout failing and is reported as
            # inconclusive rather than MISSING.
            addon_rc=0
            # SC2086: $timeout_cmd is empty or two words, unquoted on purpose.
            # shellcheck disable=SC2086
            $timeout_cmd "$CTR_CMD" exec signalk-server test -f \
                /home/node/signalk/node_modules/@canboat/canboatjs/build/Release/canSocket.node \
                2>/dev/null || addon_rc=$?
            if [[ "$addon_rc" -eq 0 ]]; then
                echo "present"
            elif [[ "$addon_rc" -eq 1 ]]; then
                echo "MISSING — canbus-canboatjs connections cannot open can0"
            else
                echo "(probe inconclusive: exec exit ${addon_rc})"
            fi
        else
            echo "(signalk-server not running; probe skipped)"
        fi
    } >"$bundle/host-extra.txt" 2>&1

    # Tar it up.
    local tarball="$tarball_dir/signalk-bug-report-$stamp.tar.gz"
    tar -C "$outdir" -czf "$tarball" "signalk-bug-report-$stamp"
    rm -rf "$outdir"

    echo
    echo "[OK] Bundle ready:"
    echo "  $tarball"
    echo
    echo "Contents are limited to host metadata, container state, recent journals,"
    echo "doctor probes + snapshot index, updater state (image tags/digests/versions),"
    echo "per-container inspect + log tail for every signalk-* container, raw hardware"
    echo "bus enumeration (lsusb / serial / CAN / Pi config.txt overlays), and a host"
    echo "headroom snapshot (df + ss + dmesg warn/err tail). Auth tokens are reported"
    echo "as presence-only (mode + 'present') and their values are NEVER included."
    echo "SignalK plugin configuration bodies (which routinely hold secrets) are also"
    echo "NEVER included; settings.json is included with pipedProviders' options"
    echo "redacted. Container env values are redacted in inspect dumps (keys"
    echo "preserved; only the installer-owned SIGNALK_*URL / DOCTOR_HEALTH_URL"
    echo "probe targets on the updater/doctor containers keep a sanitized value —"
    echo "scheme/host/port/path only, with any userinfo, query string, or fragment"
    echo "stripped, and non-http(s) values fully redacted). The hardware"
    echo "enumeration (ip -br addr) and dmesg output may"
    echo "contain IP/MAC addresses and filesystem paths — review the tarball before"
    echo "sharing on a public issue tracker."

    # Optional upload + issue-opening. Two prompts because the privacy
    # tradeoff is real: filebin.net is unauthenticated public storage
    # (anyone with the bin URL can download), and although the bundle
    # has tokens/pipedProviders redacted, it still contains settings.json,
    # hardware.json, plugin versions, and 24h of journals. Operators on
    # shared boats or with custom plugins should know that before they
    # upload. Both defaults are Y — most operators running `signalk
    # bug-report` want to file an issue, and a default-N upload
    # silently produced "attach this file manually" bodies that surprised
    # users in practice. The explicit consent text above makes the
    # tradeoff visible; operators with concerns can type N.
    local issue_url_base="https://github.com/SignalK/signalk-server/issues/new"
    local tarball_url=""

    # Non-interactive callers (cron, CI, `signalk bug-report < /dev/null`)
    # would see `read` return immediately with an empty string, and the
    # issue-page prompt's default-Y would then silently spawn xdg-open.
    # Skip both prompts when stdin isn't a TTY and just print the manual
    # instructions.
    if [[ ! -t 0 ]]; then
        echo
        echo "Non-interactive shell — skipping upload and browser prompts."
        echo "Attach $tarball to a new issue at:"
        echo "  $issue_url_base"
        return
    fi

    echo
    echo "Upload the bundle to filebin.net so it can be linked from the issue?"
    echo "  - filebin.net is PUBLIC: anyone with the bin URL can download it."
    echo "  - The bundle has tokens and pipedProviders options redacted, but"
    echo "    still contains settings.json, hardware.json, plugin versions,"
    echo "    and 24 hours of journal output. Review the tarball first if"
    echo "    you are on a shared boat or run custom plugins."
    echo "  - filebin auto-expires bins after ~6 days."
    # Guard read against EOF — `set -e` would otherwise kill the script
    # before the default is applied (e.g. stdin closed after the first
    # prompt, broken pipe).
    if ! read -r -p "Upload now? [Y/n] " ans_upload; then
        ans_upload=""
    fi
    ans_upload=${ans_upload:-Y}
    if [[ "$ans_upload" =~ ^[Yy]$ ]]; then
        # Bin name mixes timestamp + $RANDOM so guessing the URL is
        # infeasible; this is the only access control filebin offers.
        local bin
        bin="signalk-$(date -u +%Y%m%d-%H%M%S)-$RANDOM"
        local fname
        fname=$(basename "$tarball")
        echo "[i] Uploading $tarball …"
        if curl -fsS --max-time 120 \
             -H "Content-Type: application/gzip" \
             --data-binary "@$tarball" \
             "https://filebin.net/$bin/$fname" >/dev/null; then
            tarball_url="https://filebin.net/$bin/$fname"
            echo "[OK] Uploaded:"
            echo "  $tarball_url"
        else
            echo "[WARN] Upload failed. Attach $tarball to the issue manually."
        fi
    fi

    echo
    if ! read -r -p "Open the GitHub issue page in your browser? [Y/n] " ans_issue; then
        ans_issue=""
    fi
    ans_issue=${ans_issue:-Y}
    if [[ "$ans_issue" =~ ^[Yy]$ ]]; then
        local body
        if [[ -n "$tarball_url" ]]; then
            body="**Bug report bundle:** $tarball_url"$'\n'"_(filebin link, auto-expires in ~6 days — please download soon)_"
        else
            body="**Bug report bundle:** attach \`$(basename "$tarball")\` from $(dirname "$tarball")/"
        fi
        body+=$'\n\n'"**What happened:**"$'\n\n'"**Expected:**"$'\n\n'"**Steps to reproduce:**"$'\n'
        # URL-encode the body for the query string. python3 is present
        # on every distro the installer targets; jq's @uri is the
        # fallback when python3 is unavailable.
        local encoded_body=""
        if command -v python3 >/dev/null 2>&1; then
            encoded_body=$(python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.stdin.read()))' <<<"$body")
        elif command -v jq >/dev/null 2>&1; then
            encoded_body=$(jq -rn --arg s "$body" '$s|@uri')
        fi
        local issue_url
        if [[ -n "$encoded_body" ]]; then
            issue_url="$issue_url_base?title=Bug%20report%20$stamp&body=$encoded_body"
        else
            issue_url="$issue_url_base"
            echo "[WARN] Could not URL-encode the issue body (no python3 or jq)."
            echo "       Paste this into the issue manually:"
            echo
            printf '%s\n' "$body"
            echo
        fi
        echo "[i] Opening:"
        echo "  $issue_url"
        if command -v xdg-open >/dev/null 2>&1; then
            # Detach so we don't block the shell on slow GUI startup.
            xdg-open "$issue_url" >/dev/null 2>&1 &
        else
            echo "(no xdg-open — copy the URL above into your browser)"
        fi
    else
        echo "Open this when you're ready:"
        echo "  $issue_url_base"
    fi
}

# ── signalk devpod ──────────────────────────────────────────────────────
# Zero-setup development environment on an installer-provisioned box:
# installs the pinned devpod CLI on first use, points its docker provider
# at podman where no docker exists, disables devpod's idle timeout (it
# kills the browser-IDE port forward mid-session), then delegates to the
# repo devcontainer with the browser IDE. Field notes and desktop
# alternatives: docs/devcontainer.md.
DEVPOD_VERSION="v0.6.15"
DEVPOD_OPENVSCODE_VERSION="v1.109.5"
# Workspaces track the 'release' BRANCH, which CI force-updates to every
# version tag, vX.Y.Z (.github/workflows/release-branch.yml) — master
# is where development happens and may break at any time without
# breaking `signalk devpod up`. A branch rather than a tag clone keeps
# the documented upgrade flow intact: `git pull` inside the workspace is
# never detached and lands on the latest release.
# Unreleased state (devcontainer development, verifying a fix):
#   SIGNALK_DEVPOD_REF=master signalk devpod up
DEVPOD_REF="${SIGNALK_DEVPOD_REF:-release}"
DEVPOD_REPO="github.com/dirkwa/signalk-universal-installer"
DEVPOD_SOURCE="${DEVPOD_REPO}@${DEVPOD_REF}"
DEVPOD_WORKSPACE="signalk-universal-installer"

devpod_bin() {
    if command -v devpod >/dev/null 2>&1; then
        command -v devpod
    else
        echo "${HOME}/.local/bin/devpod"
    fi
}

cmd_devpod() {
    local sub="${1:-up}"
    shift || true
    local bin arch
    bin="$(devpod_bin)"

    if [[ ! -x "$bin" ]]; then
        case "$(uname -m)" in
            x86_64)        arch="amd64" ;;
            aarch64|arm64) arch="arm64" ;;
            *)
                echo "[ERR] Unsupported architecture for devpod: $(uname -m)" >&2
                exit 1
                ;;
        esac
        echo "[i] Installing devpod ${DEVPOD_VERSION} to ${bin}"
        mkdir -p "$(dirname "$bin")"
        if ! curl -fsSL -o "$bin" \
            "https://github.com/loft-sh/devpod/releases/download/${DEVPOD_VERSION}/devpod-linux-${arch}"; then
            echo "[ERR] devpod download failed" >&2
            exit 1
        fi
        chmod +x "$bin"
    fi

    # Provider setup, fully automatic. When podman exists (every
    # installer-provisioned box), signalk workspaces run under a DEDICATED
    # named provider instance ("docker-podman" — devpod's docker provider
    # pointed at podman via DOCKER_PATH; no second runtime is installed).
    # A named instance means a user's own devpod setup for other projects
    # is never touched or repointed — boxes with a real-docker default
    # provider get podman for signalk workspaces anyway, which is also
    # what makes the host-networking default land on the REAL host
    # (rootless docker scopes it to rootlesskit). Podman-less dev boxes
    # fall back to a plain docker provider; a fresh devpod install
    # otherwise has NO provider at all and `up` dies with "no default
    # provider found".
    provider_args=()
    if command -v podman >/dev/null 2>&1; then
        "$bin" provider add docker --name docker-podman \
            -o DOCKER_PATH="$(command -v podman)" >/dev/null 2>&1 || true
        provider_args=(--provider docker-podman)
    elif command -v docker >/dev/null 2>&1; then
        "$bin" provider add docker >/dev/null 2>&1 || true
        "$bin" provider use docker >/dev/null 2>&1 || true
    fi
    # devpod exits after ~90 idle seconds by default, taking the browser
    # IDE's port forward with it — disable once; harmless if repeated.
    "$bin" context set-options -o EXIT_AFTER_TIMEOUT=false >/dev/null 2>&1 || true

    case "$sub" in
        up)
            # Fail-open bootstrap guard: until the first vX.Y.Z tag
            # after the channel shipped, the release branch does not
            # exist and a FRESH workspace would die in devpod with a
            # cryptic, locale-dependent git error. Refuse with a real
            # explanation only when all three hold: default channel, no
            # existing workspace (an existing one re-ups from its own
            # clone without consulting the source — verified), and a
            # definitive 404 from the GitHub API. Offline, rate-limited
            # or otherwise unsure: proceed and let devpod decide.
            if [[ "$DEVPOD_REF" == "release" ]] \
                && ! "$bin" list 2>/dev/null | grep -q "$DEVPOD_WORKSPACE" \
                && [[ "$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 \
                    "https://api.github.com/repos/${DEVPOD_REPO#github.com/}/branches/release" \
                    2>/dev/null)" == "404" ]]; then
                echo "[ERR] The 'release' channel branch does not exist (yet)." >&2
                echo "      It is created by the first vX.Y.Z tag once the release" >&2
                echo "      channel has shipped. Until then, development state works:" >&2
                echo "        SIGNALK_DEVPOD_REF=master signalk devpod up" >&2
                exit 1
            fi
            echo "[i] Browser IDE will serve on http://<this-box>:10800 (host networking),"
            echo "    dev server on :4000 — they keep running after this command returns."
            echo "    First run downloads the dev image (a few minutes)."
            echo "[i] Both are UNAUTHENTICATED and LAN-visible — this default is for"
            echo "    owner-controlled networks (docs/devcontainer.md)."
            # Webview extensions (the Claude Code panel, for one) need a
            # SECURE browser context; plain http://<ip> is not one — the
            # IDE loads but those panels stay blank (field report). With
            # tailscale on the box HTTPS is one command, so do it
            # automatically — but never touch an existing serve config:
            # it may already publish something else (SignalK itself,
            # for instance).
            if command -v tailscale >/dev/null 2>&1; then
                # The IDE's URL is the https host whose proxy entry
                # backs :10800 — never just the first URL in the status
                # output (a box can serve several hosts).
                ts_ide_url() {
                    # Match the handler that backs the IDE's local
                    # target — not any text containing 10800 (which
                    # could be a hostname or an unrelated rule).
                    tailscale serve status 2>/dev/null \
                        | awk '/^https:/{u=$1} /proxy http:\/\/(127\.0\.0\.1|localhost):10800$/{print u; exit}'
                }
                if ! ts_status="$(tailscale serve status 2>/dev/null)"; then
                    # Daemon down or logged out — a serve attempt now
                    # would only fail with a worse message.
                    echo "[i] tailscale is installed but not ready (daemon/login). Once it is,"
                    echo "    HTTPS for the Claude panel: tailscale serve --bg 10800"
                elif [[ -z "$ts_status" || "$ts_status" == *"No serve config"* ]]; then
                    if tailscale serve --bg 10800 >/dev/null 2>&1; then
                        ts_url="$(ts_ide_url || true)"
                        echo "[i] IDE over HTTPS (tailnet only): ${ts_url:-run 'tailscale serve status'}"
                        echo "    Secure context — the Claude Code panel works there."
                    else
                        echo "[i] tailscale is here but 'serve' needs privileges; for the Claude panel:"
                        echo "      sudo tailscale serve --bg 10800"
                    fi
                elif ts_url="$(ts_ide_url)" && [[ -n "$ts_url" ]]; then
                    echo "[i] IDE over HTTPS (tailnet only): ${ts_url}"
                else
                    echo "[i] tailscale serve already publishes something else — left untouched."
                    echo "    For the IDE add: sudo tailscale serve --bg --https=8443 10800"
                fi
            else
                echo "[i] Heads-up: the Claude Code panel stays blank over plain http://<ip>:10800"
                echo "    (browser secure-context rule; the rest of the IDE works). Use one of:"
                echo "      ssh -L 10800:localhost:10800 <this-box>   # then http://localhost:10800"
                echo "      chrome://flags/#unsafely-treat-insecure-origin-as-secure (allowlist the URL)"
            fi
            echo "[i] Workspace source: ${DEVPOD_SOURCE}"
            # FORWARD_PORTS=false: under host networking the ports are on
            # the host already; devpod's forwards would only collide with
            # them. Re-enable when reverting the workspace to bridge:
            #   signalk devpod up --ide-option FORWARD_PORTS=true
            # --id pins the workspace identity regardless of the source
            # ref, so switching channels never forks a second workspace
            # and ssh/stop/delete keep matching. The ref only matters at
            # creation — an existing workspace keeps its clone until
            # `signalk devpod delete` + `up`.
            # provider_args first, "$@" last: a user-supplied --provider
            # (or any repeated flag) wins over our defaults.
            exec "$bin" up "$DEVPOD_SOURCE" --id "$DEVPOD_WORKSPACE" \
                ${provider_args[@]+"${provider_args[@]}"} \
                --ide openvscode --ide-option VERSION="$DEVPOD_OPENVSCODE_VERSION" \
                --ide-option FORWARD_PORTS=false "$@"
            ;;
        ssh|stop|delete)
            exec "$bin" "$sub" "$DEVPOD_WORKSPACE" "$@"
            ;;
        list)
            exec "$bin" list "$@"
            ;;
        *)
            echo "[ERR] Unknown devpod subcommand: $sub (use up|ssh|stop|delete|list)" >&2
            exit 1
            ;;
    esac
}

case "${1:-help}" in
    health)     cmd_health ;;
    recover)    shift; cmd_recover "$@" ;;
    socketcan)  shift; cmd_socketcan "$@" ;;
    bluetooth)  shift; cmd_bluetooth "$@" ;;
    timesync)   shift; cmd_timesync "$@" ;;
    update)     shift; cmd_update "$@" ;;
    render-server) shift; cmd_render_server "$@" ;;
    resolv-watch) shift; cmd_resolv_watch "$@" ;;
    resetadmin) shift; cmd_resetadmin "$@" ;;
    bug-report) shift; cmd_bug_report "$@" ;;
    stop)       cmd_stop ;;
    start)      cmd_start ;;
    restart)    cmd_restart ;;
    devpod)     shift; cmd_devpod "$@" ;;
    uninstall)  cmd_uninstall ;;
    version|--version|-v) cmd_version ;;
    help|--help|-h) usage ;;
    *)
        echo "[ERR] Unknown command: $1" >&2
        usage
        exit 1
        ;;
esac
