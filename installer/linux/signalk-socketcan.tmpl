#!/usr/bin/env bash
# signalk-socketcan — host-resident Pi CAN-HAT detection & setup helper.
# Installed by signalk-universal-installer. Normally invoked via the
# dispatcher as `signalk socketcan`, but standalone-runnable.
#
# v1 scope: detect + advise only. Does NOT modify /boot/firmware/config.txt
# or anything that needs sudo; the operator runs the printed recipe
# themselves. The single mutation this script performs is updating its
# OWN file at ~/.signalk-updater/hardware.json with a `socketcanCandidate`
# field so the bug-report bundle (and, eventually, the updater UI) can
# see what HAT the operator picked.
#
# Why detect+advise instead of auto-edit: a wrong dtoverlay= line can
# prevent the Pi from booting. The sudo-+-diff-+-confirm pattern from
# preflight.sh is reusable, but the blast radius of config.txt mistakes
# is higher than cmdline.txt's (config.txt can mis-configure HDMI,
# memory split, GPIO pinmux); v2 may add auto-apply once we have a
# safety story.
#
# Usage:
#   signalk-socketcan           — interactive: detect, ask which HAT, print recipe
#   signalk-socketcan status    — terse summary; no prompts, no writes
#   signalk-socketcan help      — usage text

set -euo pipefail

UPDATER_DATA="${HOME}/.signalk-updater"
HARDWARE_JSON="${UPDATER_DATA}/hardware.json"
# GitHub source-view, not the Pages URL. Pages serves docs/*.md as
# raw text (no Jekyll), so the previous `socketcan.html` URL 404'd.
# GitHub's source-tree view renders markdown natively with the same
# anchor-link UX an operator expects.
DOC_URL="https://github.com/dirkwa/signalk-universal-installer/blob/master/docs/socketcan.md"

# ─── output helpers ────────────────────────────────────────────────────
# Mirrors installer/linux/lib/colors.sh exactly: same ANSI escapes,
# same `[[ -t 1 && -z "${NO_COLOR:-}" ]]` gate. We can't `source` the
# lib because this script is shipped standalone to ~/.local/bin/ (and
# the doctor's installer-refresh delivers it on its own). Inlining
# matches the lib byte-for-byte so behaviour stays aligned without
# the dependency. Same helper signatures (info/ok/warn/err/section).
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
    C_RED=$'\033[0;31m'
    C_GREEN=$'\033[0;32m'
    C_YELLOW=$'\033[0;33m'
    C_BLUE=$'\033[0;34m'
    C_BOLD=$'\033[1m'
    C_RESET=$'\033[0m'
else
    C_RED=''; C_GREEN=''; C_YELLOW=''; C_BLUE=''; C_BOLD=''; C_RESET=''
fi
info()    { printf '%s[i]%s %s\n' "$C_BLUE"   "$C_RESET" "$*"; }
ok()      { printf '%s[OK]%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
warn()    { printf '%s[!]%s %s\n' "$C_YELLOW" "$C_RESET" "$*" >&2; }
err()     { printf '%s[ERR]%s %s\n' "$C_RED"  "$C_RESET" "$*" >&2; }
section() { printf '\n%s== %s ==%s\n' "$C_BOLD" "$*" "$C_RESET"; }

usage() {
    cat <<EOF
signalk-socketcan — CAN-adapter detection & setup helper for SignalK.

Usage:
  signalk socketcan          Interactive: detect the adapter, print a
                             copy-pasteable recipe (Pi HAT: config.txt
                             overlay; USB-CAN: networkd file; SLCAN:
                             systemd service unit), record the chosen
                             adapter in hardware.json.
  signalk socketcan status   Terse summary of current state (no prompts).
  signalk socketcan help     This text.

Supported adapters:
  1. Waveshare 2-CH CAN HAT (dual MCP2515 on SPI)          [Pi only]
  2. Waveshare 2-CH CAN FD HAT (dual MCP2518FD on SPI)     [Pi only]
  3. PiCAN-M / PiCAN3 (MCP2515 on SPI; marine NMEA 2000)    [Pi only]
  4. Generic single-channel MCP2515 (PiCAN2, RS485-CAN-HAT) [Pi only]
  5. USB CAN — SocketCAN-native (gs_usb, Peak, Kvaser)      [any Linux]
  6. SLCAN (Lawicel CANUSB serial, CANable slcan firmware)  [any Linux]
  7. Custom dtoverlay (you supply the line)                 [Pi only]

Recipe persistence uses systemd-networkd's CAN BitRate= for Pi HATs and
SocketCAN-native USB adapters. The SLCAN recipe ships a systemd .service
unit that invokes slcand and brings can0 up — no networkd needed.

Bitrate is 250000 (NMEA 2000 standard). Other CAN buses (engine ECU,
J1939 industrial, classic 125k boats) use different bitrates; edit the
networkd file (or the SLCAN unit's -s code) if your bus is not NMEA 2000.

See: ${DOC_URL}
EOF
}

# ─── probes ────────────────────────────────────────────────────────────

# is_pi: reuses the gate from signalk.tmpl's bug-report Pi block.
# We don't source lib/distro.sh because that path isn't shipped to
# ~/.local/bin (and the doctor's installer-refresh wouldn't carry it).
is_pi() {
    [[ -r /proc/device-tree/model ]] && grep -qi 'raspberry pi' /proc/device-tree/model
}

# pi_model: human-readable Pi revision, e.g. "Raspberry Pi 5 Model B Rev 1.0".
pi_model() {
    tr -d '\0' </proc/device-tree/model 2>/dev/null || echo "unknown"
}

# config_txt_path: Pi OS bookworm+ moved /boot to /boot/firmware. Try both.
config_txt_path() {
    for p in /boot/firmware/config.txt /boot/config.txt; do
        if [[ -r "$p" ]]; then
            echo "$p"
            return 0
        fi
    done
    return 1
}

# existing_overlays: print any current dtoverlay= line that mentions a
# CAN driver, one per line. Empty output = nothing configured yet.
existing_overlays() {
    local cfg
    if ! cfg=$(config_txt_path); then
        return 0
    fi
    grep -E '^\s*dtoverlay=(mcp2515|mcp251xfd|spi)' "$cfg" 2>/dev/null || true
}

# loaded_can_modules: print loaded CAN/USB-CAN modules. Mirrors the
# mawk-compatible filter from signalk.tmpl's bug-report hardware-raw
# section so the two stay aligned.
loaded_can_modules() {
    if ! command -v lsmod >/dev/null 2>&1; then
        return 0
    fi
    lsmod 2>/dev/null \
        | awk '$1 ~ /^(mcp251x|mcp251xfd|can|can_raw|can_dev|vcan|gs_usb|peak_usb|peak_pci|kvaser_usb|slcan)$/ { print $1 }' \
        || true
}

# can_interfaces: print all SocketCAN interfaces, one per line.
can_interfaces() {
    if ! command -v ip >/dev/null 2>&1; then
        return 0
    fi
    ip -o link show type can 2>/dev/null | awk -F': ' '{print $2}' | sort -u || true
}

# can_bitrate <iface>: print current bitrate, or empty if not set / iface absent.
can_bitrate() {
    local iface=$1
    if ! command -v ip >/dev/null 2>&1; then
        return 0
    fi
    # `ip -d link show <iface>` includes a 'bitrate NNN' field when the
    # interface is configured as a CAN device with a bitrate.
    ip -d link show "$iface" 2>/dev/null \
        | awk '/bitrate/ { for (i=1;i<=NF;i++) if ($i=="bitrate") { print $(i+1); exit } }' \
        || true
}

# can_state <iface>: print interface oper state (UP/DOWN/UNKNOWN), empty if iface absent.
can_state() {
    local iface=$1
    if ! command -v ip >/dev/null 2>&1; then
        return 0
    fi
    ip -br link show "$iface" 2>/dev/null | awk '{print $2}' || true
}

# ─── HAT catalog ───────────────────────────────────────────────────────
# Single source of truth for the menu, the recipe, and the hardware.json
# field. Each `hat_<n>_*` group is one menu entry.

hat_1_id="waveshare-2ch-mcp2515"
hat_1_name="Waveshare 2-CH CAN HAT (dual MCP2515)"
# Interrupt pins are the FACTORY-SOLDER defaults documented in the
# Waveshare 2-CH CAN HAT wiki: INT_0=GPIO23, INT_1=GPIO25. Users with
# reworked 0-ohm jumpers can override via menu option 7 (custom).
# `dtparam=spi=on` is auto-enabled by mcp2515-can*; do NOT add it.
# `dtoverlay=spi-bcm2835-overlay` is not a real overlay — it was on
# Waveshare's wiki at one point and we copy-pasted it; the upstream
# Raspberry Pi overlays README has no entry by that name.
hat_1_overlays=(
    "dtoverlay=mcp2515-can0,oscillator=16000000,interrupt=23"
    "dtoverlay=mcp2515-can1,oscillator=16000000,interrupt=25"
)

# Waveshare 2-CH CAN *FD* HAT — the MCP2518FD-based sibling of hat_1.
# Different chip family (MCP251xFD, not MCP2515), different driver
# (mcp251xfd), and a fundamentally different SPI layout: each of the
# two FD controllers sits on its OWN SPI bus (spi0.0 and spi1.0), so
# the second bus must be enabled with `dtoverlay=spi1-3cs` before the
# can1 overlay can bind. Contrast hat_1's classic board, where both
# MCP2515s share spi0 via CE0/CE1 and no spi1 overlay is needed.
#
# No `oscillator=` parameter: the mcp251xfd device-tree default is the
# 40 MHz crystal Waveshare fits, confirmed on hardware by the driver's
# init log ("o:40.00MHz"). Adding oscillator= here would be wrong.
#
# Factory interrupt pins observed on a Pi 4 + this HAT: spi0-0 → GPIO25,
# spi1-0 → GPIO24. `dtparam=spi=on` is listed explicitly because, unlike
# the mcp2515-can* overlay, the bare `spi1-3cs` overlay does not imply
# the primary SPI controller is enabled.
hat_2_id="waveshare-2ch-mcp251xfd"
hat_2_name="Waveshare 2-CH CAN FD HAT (dual MCP2518FD)"
hat_2_overlays=(
    "dtparam=spi=on"
    "dtoverlay=spi1-3cs"
    "dtoverlay=mcp251xfd,spi0-0,interrupt=25"
    "dtoverlay=mcp251xfd,spi1-0,interrupt=24"
)

# PiCAN-M and PiCAN3 ship the MCP2515 (NOT MCP251xFD), per Copperhill's
# own driver-installation blog post. Earlier versions of this helper
# emitted `dtoverlay=mcp251xfd-spi0-0,oscillator=20000000,...` which
# is wrong for two reasons: (1) wrong chip family, (2) `mcp251xfd-spi0-0`
# is not a valid overlay name. Copperhill's own CAN-FD product ("PiCAN
# FD") would be a single-channel mcp251xfd board — close to one channel
# of hat_2; if requested it gets its own entry rather than overloading
# this MCP2515 one.
hat_3_id="picanm-mcp2515"
hat_3_name="PiCAN-M / PiCAN3 (MCP2515, marine NMEA 2000)"
hat_3_overlays=(
    "dtoverlay=mcp2515-can0,oscillator=16000000,interrupt=25"
)

hat_4_id="generic-mcp2515"
hat_4_name="Generic single-channel MCP2515 (PiCAN2, RS485-CAN-HAT, etc.)"
# Recipe is built at runtime: we ask the operator for the oscillator
# frequency (8 or 16 MHz — both are common on cheap clones) before
# emitting the single-overlay line.

# SocketCAN-native USB adapters: drivers in-tree, autoloaded via
# modalias on USB enumeration, expose canN as a netdev with no
# userspace daemon. gs_usb / candleLight / CANable-in-candleLight-mode,
# Peak PCAN-USB (peak_usb), Kvaser Leaf/USBcan (kvaser_usb).
hat_5_id="usb-can-native"
hat_5_name="USB CAN adapter — SocketCAN-native (gs_usb / Peak / Kvaser)"

# SLCAN adapters use a serial line discipline; the kernel needs
# `slcand` (from can-utils) to attach a tty to a can netdev before
# canN appears. Lawicel CANUSB in serial mode, CANable in slcan
# firmware, generic FTDI/ACM serial CAN bridges. Recipe emits an
# explicit slcand invocation plus a systemd unit to make it persist.
hat_6_id="slcan"
hat_6_name="SLCAN adapter (Lawicel CANUSB serial mode, CANable slcan firmware)"

hat_7_id="custom"
hat_7_name="Custom dtoverlay (you supply the line)"
# Operator's lines collected during the prompt; populated at runtime.

# ─── recipe rendering ──────────────────────────────────────────────────

# print_recipe <hat_id> <display_name> <bitrate> <overlay-1> [<overlay-2> ...]
# Emits a numbered, copy-pasteable recipe. The shape stays consistent
# across HATs so the operator can compare across models. USB-CAN skips
# the config.txt section.
print_recipe() {
    local hat_id=$1 display_name=$2 bitrate=$3
    shift 3
    local overlays=("$@")
    local cfg
    cfg=$(config_txt_path || echo "/boot/firmware/config.txt")

    section "Recipe for ${display_name}"
    echo

    local step=1
    if (( ${#overlays[@]} > 0 )); then
        echo "${step}. Add to ${cfg} (requires sudo + reboot):"
        echo
        local line
        for line in "${overlays[@]}"; do
            printf '     %s\n' "$line"
        done
        echo
        step=$((step + 1))

        echo "${step}. Reboot:"
        echo
        echo "     sudo reboot"
        echo
        step=$((step + 1))
    else
        # USB-CAN preamble — the driver auto-loads when the device is
        # plugged in (gs_usb, peak_usb, etc.); we still need bitrate
        # persistence below.
        echo "${step}. Plug in the USB CAN adapter (driver auto-loads)."
        echo "   Verify enumeration:  lsusb && dmesg | tail -20"
        echo
        step=$((step + 1))
    fi

    echo "${step}. After reboot/plug-in, persist the NMEA 2000 bitrate via systemd-networkd:"
    echo
    echo "     sudo tee /etc/systemd/network/80-signalk-can0.network > /dev/null <<'EOF'"
    echo "     [Match]"
    echo "     Name=can0"
    echo
    echo "     [CAN]"
    echo "     BitRate=${bitrate}"
    echo "     EOF"
    echo
    echo "     sudo systemctl enable --now systemd-networkd"
    echo
    echo "   NOTE: Pi OS Trixie defaults to NetworkManager; enabling systemd-networkd"
    echo "   for can0 is safe (NM ignores CAN interfaces) but is a permanent change."
    echo "   Alternative: a one-shot ip-link service unit — see ${DOC_URL}"
    echo
    step=$((step + 1))

    echo "${step}. Verify:"
    echo
    echo "     ip -br link show type can     # can0 should be UP"
    echo "     candump can0                  # NMEA 2000 traffic should appear"
    echo "                                   # (install: sudo apt install can-utils)"
    echo
    echo "After verifying, re-run 'signalk socketcan' (the interactive flow)"
    echo "to refresh hardware.json with the now-applied state."
    echo "('signalk socketcan status' is read-only — it shows current state but"
    echo " does not write to hardware.json.)"
    echo
    echo "Recipe id: ${hat_id}    Bitrate: ${bitrate}"
}

# ─── hardware.json writer ──────────────────────────────────────────────

# write_candidate <hat_id> <display_name> <bitrate> <configApplied> <ipLinkUp> <overlay-1> [<overlay-2> ...]
# Updates the operator's own ~/.signalk-updater/hardware.json with a
# `socketcanCandidate` field. Other fields (serial, can, bluetooth, gpio)
# are preserved. Uses jq when available; falls back to a verbatim
# rewrite of the field when not (we keep the file intact in that case
# and just print a notice, since hand-merging JSON is fragile).
write_candidate() {
    local hat_id=$1 display_name=$2 bitrate=$3 cfg_applied=$4 ip_up=$5
    shift 5
    local overlays=("$@")

    mkdir -p "$UPDATER_DATA"

    # If hardware.json doesn't exist yet, the bash installer hasn't run
    # detection. Seed an empty one so the candidate has somewhere to go.
    if [[ ! -f "$HARDWARE_JSON" ]]; then
        printf '{\n  "serial": [],\n  "can": [],\n  "bluetooth": {"dbusAvailable": false, "enabled": false},\n  "gpio": {"platform": "none", "enabled": false}\n}\n' \
            >"$HARDWARE_JSON"
        info "seeded ${HARDWARE_JSON} (next 'signalk' installer run will populate detected hardware)"
    fi

    if ! command -v jq >/dev/null 2>&1; then
        warn "jq not installed; skipping hardware.json update."
        warn "  Install jq and re-run 'signalk socketcan' to record the candidate."
        return 0
    fi

    # Build the overlays JSON array. Empty overlays (USB-CAN) → [].
    local overlays_json="[]"
    if (( ${#overlays[@]} > 0 )); then
        overlays_json=$(printf '%s\n' "${overlays[@]}" | jq -R . | jq -s .)
    fi

    local now
    now=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

    local tmp
    tmp=$(mktemp -t hardware.json.XXXXXX)
    if jq \
        --arg writtenAt "$now" \
        --arg hat "$hat_id" \
        --arg displayName "$display_name" \
        --argjson overlays "$overlays_json" \
        --argjson bitrate "$bitrate" \
        --argjson configApplied "$cfg_applied" \
        --argjson ipLinkUp "$ip_up" \
        '.socketcanCandidate = {
            writtenAt: $writtenAt,
            hat: $hat,
            displayName: $displayName,
            configTxtOverlays: $overlays,
            bitrate: $bitrate,
            configApplied: $configApplied,
            ipLinkUp: $ipLinkUp
        }' "$HARDWARE_JSON" >"$tmp"; then
        mv "$tmp" "$HARDWARE_JSON"
        ok "recorded socketcanCandidate in ${HARDWARE_JSON}"
    else
        rm -f "$tmp"
        warn "failed to update ${HARDWARE_JSON}; left untouched"
        return 1
    fi
}

# ─── status command ────────────────────────────────────────────────────

cmd_status() {
    # No Pi gate — USB-CAN and SLCAN paths work on any Linux. The
    # config.txt section below short-circuits cleanly on non-Pi.

    # Collect probe values once up front; downstream sections share them
    # AND the "Detected configuration" derivation needs all three at once.
    # `overlay_lines` (not `overlays`) so this newline-joined string
    # doesn't collide with the array-typed `overlays` used in
    # print_recipe / write_candidate above.
    local cfg=""
    cfg=$(config_txt_path 2>/dev/null || true)
    local overlay_lines=""
    overlay_lines=$(existing_overlays)
    local mods=""
    mods=$(loaded_can_modules)
    local ifaces=""
    ifaces=$(can_interfaces)

    section "Host"
    if is_pi; then
        info "Model:  $(pi_model)"
    else
        info "Model:  $(uname -m) (non-Pi — Pi-only menu options will refuse)"
    fi
    info "Kernel: $(uname -r 2>/dev/null || echo unknown)"

    section "config.txt"
    if [[ -n "$cfg" ]]; then
        info "Path: ${cfg}"
        if [[ -n "$overlay_lines" ]]; then
            ok "Existing CAN/SPI overlay(s):"
            # existing_overlays returns one overlay per line; printf with
            # a single quoted string would only indent the first row.
            # Walk line-by-line so multi-overlay HATs (Waveshare's two)
            # all get the indent.
            while IFS= read -r overlay_line; do
                [[ -n "$overlay_line" ]] || continue
                printf '    %s\n' "$overlay_line"
            done <<<"$overlay_lines"
        else
            warn "No CAN/SPI overlay configured."
        fi
    elif is_pi; then
        warn "config.txt not readable at /boot/firmware or /boot."
    else
        info "(non-Pi host — no config.txt to inspect; use USB-CAN paths)"
    fi

    section "Kernel modules"
    if [[ -n "$mods" ]]; then
        ok "Loaded CAN-related modules:"
        # loaded_can_modules emits one module per line; indent each.
        while IFS= read -r mod; do
            [[ -n "$mod" ]] || continue
            printf '    %s\n' "$mod"
        done <<<"$mods"
    else
        warn "No CAN-related modules loaded."
    fi

    section "Interfaces"
    if [[ -n "$ifaces" ]]; then
        local iface
        while IFS= read -r iface; do
            [[ -n "$iface" ]] || continue
            local state bitrate
            state=$(can_state "$iface")
            bitrate=$(can_bitrate "$iface")
            ok "${iface}: state=${state:-?} bitrate=${bitrate:-unconfigured}"
        done <<<"$ifaces"
    else
        warn "No CAN interface present."
    fi

    # A host-side-perfect CAN setup can still be dead in SignalK when the
    # server image shipped without canboatjs's compiled SocketCAN addon
    # (its install script is `node-gyp rebuild || echo ...` — a build
    # failure or an npm >= 12 script-approval skip is SILENT, and the
    # canbus-canboatjs connection then errors with "Failed to load native
    # canSocket module"). Probe the running container so `status` points
    # at the real culprit instead of leaving every host check green.
    section "Server container"
    if ! command -v podman >/dev/null 2>&1; then
        info "(podman not found — skipping in-container canboatjs check)"
    elif ! podman container exists signalk-server 2>/dev/null \
        || [[ "$(podman inspect --format '{{.State.Running}}' signalk-server 2>/dev/null)" != "true" ]]; then
        info "(signalk-server container not running — skipping in-container canboatjs check)"
    else
        # Only exit status 1 proves the file is absent — any other
        # status is the exec itself failing (container flapping,
        # podman error) and must not send the user chasing a rebuild.
        local addon_rc=0
        podman exec signalk-server test -f \
            /home/node/signalk/node_modules/@canboat/canboatjs/build/Release/canSocket.node \
            2>/dev/null || addon_rc=$?
        if [[ "$addon_rc" -eq 0 ]]; then
            ok "canboatjs native canSocket addon present in server image"
        elif [[ "$addon_rc" -eq 1 ]]; then
            err "canboatjs native canSocket addon MISSING in server image —"
            err "NMEA 2000 connections of type canbus-canboatjs cannot open"
            err "can0. Update to a fixed server image (signalk update), or as"
            err "a stopgap (lost on container re-create):"
            err "  podman exec signalk-server sh -c 'cd /home/node/signalk/node_modules/@canboat/canboatjs && npx node-gyp rebuild'"
        else
            warn "canboatjs addon probe inconclusive (podman exec exit ${addon_rc})"
        fi
    fi

    # ─── live-derived detected configuration ─────────────────────────
    # Identify which catalog HAT the live system most resembles. This
    # is computed fresh from config.txt + lsmod + ip link every run, so
    # it cannot go stale relative to the kernel state. The persisted
    # `socketcanCandidate` field in hardware.json is a separate concept
    # (the operator's last interactive intent, kept for future
    # auto-installer flows) and intentionally NOT shown here.
    section "Detected configuration"
    local detected
    detected=$(detect_configuration "$overlay_lines" "$mods" "$ifaces")
    printf '%s\n' "$detected"
}

# detect_configuration <overlay_lines> <mods> <ifaces>
# Pure function: returns a 1-2 line description of the most likely
# configuration. All input is the live-probe output from
# existing_overlays / loaded_can_modules / can_interfaces; no
# side-effects, no JSON read. `cfg_overlays` avoids the array-typed
# `overlays` name used by print_recipe / write_candidate above.
detect_configuration() {
    local cfg_overlays=$1 mods=$2 ifaces=$3

    # Helper to test for an overlay matching a regex anywhere in the
    # multi-line overlays string. Using grep so SC2076 stays away
    # from a `=~` literal-vs-regex confusion.
    has_overlay() {
        local pat=$1
        printf '%s\n' "$cfg_overlays" | grep -qE "$pat"
    }

    # Helper: is module $1 in the loaded list?
    has_module() {
        printf '%s\n' "$mods" | grep -qxE "$1"
    }

    # Helper: is interface $1 in the live list?
    has_iface() {
        printf '%s\n' "$ifaces" | grep -qxE "$1"
    }

    # MCP251xFD overlay(s) → CAN-FD chip family. The Waveshare 2-CH CAN
    # FD HAT puts two MCP2518FDs on separate SPI buses (spi0.0 + spi1.0),
    # so it shows up as TWO mcp251xfd overlays; a single overlay is a
    # one-channel board (Copperhill PiCAN FD, or one channel of the
    # Waveshare FD). Branch on the count so the dual-channel Waveshare —
    # menu option 2 — gets named specifically rather than lumped in with
    # the generic single-channel case.
    #
    # Anchor the chip token to a following comma or end-of-line so the
    # INVALID legacy string `dtoverlay=mcp251xfd-spi0-0,...` (the bogus
    # overlay name earlier helper versions emitted — see the hat_3
    # comment) does NOT get misread as a real FD config. The valid form
    # is always `dtoverlay=mcp251xfd,spi<n>-0,...`.
    if has_overlay '^[[:space:]]*dtoverlay=mcp251xfd([[:space:]]*(,|$))'; then
        local fd_count
        fd_count=$(printf '%s\n' "$cfg_overlays" \
            | grep -cE '^[[:space:]]*dtoverlay=mcp251xfd([[:space:]]*(,|$))')
        if (( fd_count >= 2 )); then
            # Two FD controllers → Waveshare 2-CH CAN FD HAT. Like the
            # dual-MCP2515 case below, read the interrupt pins to confirm
            # the factory wiring (spi0-0=GPIO25, spi1-0=GPIO24 → sorted
            # 24,25). Other pins mean reworked jumpers or a custom line.
            local fd_pins
            fd_pins=$(printf '%s\n' "$cfg_overlays" \
                | grep -oE 'interrupt=[0-9]+' \
                | sort -u | paste -sd ',' -)
            local fd_label="Waveshare 2-CH CAN FD HAT (dual MCP2518FD)"
            case "$fd_pins" in
                "interrupt=24,interrupt=25")
                    printf '[OK] %s — factory solder defaults (spi0-0=25, spi1-0=24).\n' "$fd_label"
                    ;;
                *)
                    printf '[OK] %s — non-default interrupt pins (%s); likely\n' "$fd_label" "${fd_pins:-none}"
                    printf '     reworked jumpers or a custom overlay. Verify by candump.\n'
                    ;;
            esac
            return 0
        fi
        # Single MCP251xFD overlay → one-channel CAN-FD board.
        printf '[OK] Single-channel CAN-FD adapter (MCP251xFD on SPI).\n'
        printf '     Matches a Copperhill PiCAN FD or one channel of the\n'
        printf '     Waveshare 2-CH CAN FD HAT (menu option 2). Config is correct\n'
        printf '     if can0 is UP at the right bitrate.\n'
        return 0
    fi

    # Two MCP2515 overlays (can0 + can1) → Waveshare 2-CH HAT.
    # Look at the interrupt pins to flag factory vs reworked vs the
    # earlier-buggy-recipe defaults.
    if has_overlay 'dtoverlay=mcp2515-can0' && has_overlay 'dtoverlay=mcp2515-can1'; then
        local pins
        # Pull every "interrupt=NN" value, sorted, comma-joined.
        pins=$(printf '%s\n' "$cfg_overlays" \
            | grep -oE 'interrupt=[0-9]+' \
            | sort -u | paste -sd ',' -)
        local label="Waveshare 2-CH CAN HAT (dual MCP2515)"
        case "$pins" in
            "interrupt=23,interrupt=25")
                printf '[OK] %s — factory solder defaults.\n' "$label"
                ;;
            "interrupt=24,interrupt=25")
                printf '[!]  %s — pins 24/25 match the EARLIER BUGGY default\n' "$label"
                printf '     emitted by signalk socketcan before its catalog fix. Real\n'
                printf '     Waveshare factory wiring is interrupt=23 + interrupt=25.\n'
                printf '     If can0 is UP and candump shows zero frames, this is why.\n'
                ;;
            *)
                printf '[OK] %s — non-default interrupt pins (%s); likely reworked\n' "$label" "$pins"
                printf '     jumpers. Verify by candump.\n'
                ;;
        esac
        return 0
    fi

    # Single MCP2515 overlay → PiCAN-M / PiCAN3 / generic single-chan.
    # Can't reliably distinguish PiCAN family from a generic board with
    # config.txt alone; report the chip + oscillator.
    if has_overlay 'dtoverlay=mcp2515-can0'; then
        local osc
        osc=$(printf '%s\n' "$cfg_overlays" \
            | grep -m1 -oE 'oscillator=[0-9]+' \
            | cut -d= -f2)
        printf '[OK] Single-channel MCP2515 on SPI (oscillator=%s).\n' "${osc:-?}"
        printf '     Matches PiCAN-M / PiCAN3 (marine NMEA 2000) or any generic\n'
        printf '     MCP2515 board. Cannot distinguish from config.txt alone.\n'
        return 0
    fi

    # No SPI overlay — fall back to module-based identification for
    # USB and SLCAN paths.
    if has_module 'gs_usb'; then
        printf '[OK] USB CAN adapter — gs_usb (candleLight / CANable in CL mode).\n'
        return 0
    fi
    if has_module 'peak_usb'; then
        printf '[OK] USB CAN adapter — Peak PCAN-USB.\n'
        return 0
    fi
    if has_module 'kvaser_usb'; then
        printf '[OK] USB CAN adapter — Kvaser Leaf / USBcan.\n'
        return 0
    fi
    if has_module 'slcan'; then
        # slcan is loaded but a can interface only appears once slcand
        # attaches a tty. Distinguish the two states.
        if [[ -n "$ifaces" ]] && has_iface 'can[0-9]+'; then
            printf '[OK] SLCAN adapter — slcand has attached the tty.\n'
        else
            printf '[!]  SLCAN driver loaded but no can interface present.\n'
            printf '     slcand must be running to attach a tty (see menu option 6).\n'
        fi
        return 0
    fi

    # No overlay, no relevant module, but a can interface exists →
    # likely vcan (test virtual CAN) or a USB driver we don't recognise.
    if [[ -n "$ifaces" ]]; then
        printf '[OK] CAN interface(s) present without a recognised SPI overlay\n'
        printf '     or USB driver — likely vcan (testing) or an exotic adapter.\n'
        return 0
    fi

    printf '[i]  No CAN configuration detected.\n'
    printf '     Run "signalk socketcan" interactively for a setup recipe.\n'
}

# ─── interactive command ───────────────────────────────────────────────

cmd_interactive() {
    # No early Pi gate — USB-CAN (option 5) and SLCAN (option 6) work
    # on any Linux. Pi-only menu options gate themselves below with a
    # clear message that points at the USB-CAN routes.
    section "Detecting"
    if is_pi; then
        info "Pi model:  $(pi_model)"
    else
        info "Host:      $(uname -m) (non-Pi — only USB-CAN and SLCAN paths apply)"
    fi

    local cfg overlays mods ifaces
    if cfg=$(config_txt_path); then
        info "config.txt: ${cfg}"
        overlays=$(existing_overlays)
        if [[ -n "$overlays" ]]; then
            ok "Existing CAN/SPI overlay(s) in config.txt:"
            while IFS= read -r overlay_line; do
                [[ -n "$overlay_line" ]] || continue
                printf '    %s\n' "$overlay_line"
            done <<<"$overlays"
        else
            info "No CAN/SPI overlay in config.txt yet."
        fi
    else
        # Non-Pi: there's no config.txt to inspect. Don't emit a warning
        # — that just adds noise on x86 hosts using USB-CAN.
        info "config.txt: (not a Pi-OS host — skipping overlay probe)"
    fi

    mods=$(loaded_can_modules)
    if [[ -n "$mods" ]]; then
        # paste joins lines with a separator (no trailing one), unlike
        # `tr '\n' ' '` which would leave a dangling space at end-of-line.
        ok "Loaded modules: $(echo "$mods" | paste -sd ' ' -)"
    else
        info "No CAN-related kernel modules loaded."
    fi

    ifaces=$(can_interfaces)
    if [[ -n "$ifaces" ]]; then
        ok "Existing CAN interface(s): $(echo "$ifaces" | paste -sd ' ' -)"
    else
        info "No CAN interface present."
    fi

    section "Which HAT do you have?"
    cat <<EOF
  1. ${hat_1_name}
  2. ${hat_2_name}
  3. ${hat_3_name}
  4. ${hat_4_name}
  5. ${hat_5_name}
  6. ${hat_6_name}
  7. ${hat_7_name}
  q. Quit without changes
EOF
    echo
    local choice=""
    # Guard read against EOF so a non-interactive stdin doesn't trip
    # set -e — same pattern the dispatcher uses for its upload prompt.
    if ! read -r -p "Choice [1-7/q]: " choice; then
        choice="q"
    fi
    echo

    # Pi-only menu options (1/2/3/4/7) all need /boot/firmware/config.txt
    # editable by the operator. On non-Pi hosts those options refuse
    # with a pointer at the USB-CAN routes; options 5 (SocketCAN-native
    # USB) and 6 (SLCAN) work on any Linux.
    require_pi() {
        if ! is_pi; then
            err "Menu option $1 needs a Raspberry Pi (it edits config.txt)."
            err "On non-Pi Linux use option 5 (USB SocketCAN-native) or"
            err "option 6 (SLCAN) instead — both work without device-tree."
            return 1
        fi
        return 0
    }

    case "$choice" in
        1)
            require_pi 1 || return 1
            handle_recipe "$hat_1_id" "$hat_1_name" "${hat_1_overlays[@]}"
            ;;
        2)
            require_pi 2 || return 1
            handle_recipe "$hat_2_id" "$hat_2_name" "${hat_2_overlays[@]}"
            ;;
        3)
            require_pi 3 || return 1
            handle_recipe "$hat_3_id" "$hat_3_name" "${hat_3_overlays[@]}"
            ;;
        4)
            require_pi 4 || return 1
            local osc=""
            if ! read -r -p "Oscillator frequency? [8000000/16000000, default 16000000]: " osc; then
                osc=""
            fi
            osc=${osc:-16000000}
            # The prompt advertises only the two common values; honor that
            # contract. Boards with unusual oscillators (12 MHz, 20 MHz on
            # some Chinese clones) belong on option 7 (custom dtoverlay)
            # where the operator types the whole line themselves.
            if [[ "$osc" != "8000000" && "$osc" != "16000000" ]]; then
                err "Oscillator must be 8000000 or 16000000 (Hz). Got: $osc"
                err "For other values, use menu option 7 (Custom dtoverlay)."
                return 1
            fi
            local generic_overlay="dtoverlay=mcp2515-can0,oscillator=${osc},interrupt=25"
            handle_recipe "$hat_4_id" "$hat_4_name" "$generic_overlay"
            ;;
        5)
            handle_recipe "$hat_5_id" "$hat_5_name"
            ;;
        6)
            # SLCAN flow: collect the tty path, then dispatch to a
            # specialised handler. `handle_slcan_recipe` is its own
            # function — the recipe shape is different (systemd unit
            # invoking slcand, not a config.txt edit).
            local slcan_tty=""
            local tty_default=""
            # If there's exactly one /dev/serial/by-id/* entry, suggest
            # it. Multiple → no default (operator picks). Zero → ask.
            local by_id_count=0
            if [[ -d /dev/serial/by-id ]]; then
                by_id_count=$(find /dev/serial/by-id -mindepth 1 -maxdepth 1 2>/dev/null | wc -l)
                if (( by_id_count == 1 )); then
                    tty_default=$(find /dev/serial/by-id -mindepth 1 -maxdepth 1 2>/dev/null | head -1)
                fi
            fi
            if [[ -n "$tty_default" ]]; then
                if ! read -r -p "SLCAN tty path [default: $tty_default]: " slcan_tty; then
                    slcan_tty=""
                fi
                slcan_tty=${slcan_tty:-$tty_default}
            else
                if (( by_id_count > 1 )); then
                    echo "Multiple /dev/serial/by-id/ entries — pick one and paste its full path."
                fi
                if ! read -r -p "SLCAN tty path (e.g. /dev/serial/by-id/usb-...): " slcan_tty; then
                    slcan_tty=""
                fi
            fi
            if [[ -z "$slcan_tty" ]]; then
                err "No tty path provided; aborting."
                return 1
            fi
            # Sanity-check the tty path before it lands in a systemd
            # unit. Real /dev/serial/by-id paths are limited to
            # [A-Za-z0-9._/-] by udev; anything outside that set is
            # an accidental paste (stray quote, dollar sign, backtick,
            # whitespace) and would either break the unit file or, if
            # the operator pastes the recipe block as-is, expand
            # unsafely in the operator's shell. Refuse hard rather
            # than emit a recipe that will silently produce a broken
            # service.
            if [[ ! "$slcan_tty" =~ ^[A-Za-z0-9._/-]+$ ]]; then
                err "tty path contains characters outside [A-Za-z0-9._/-]: $slcan_tty"
                err "Real /dev/serial/by-id paths never contain shell metacharacters."
                return 1
            fi
            handle_slcan_recipe "$hat_6_id" "$hat_6_name" "$slcan_tty"
            ;;
        7)
            require_pi 7 || return 1
            local custom=""
            local confirm=""
            echo "Enter your dtoverlay= / dtparam= line(s), one per line. Empty line to finish."
            local custom_overlays=()
            while true; do
                if ! read -r -p "> " custom; then
                    break
                fi
                [[ -z "$custom" ]] && break
                # Format guard: config.txt lines are conventionally
                # dtoverlay= or dtparam=. Anything else is almost
                # always a typo (e.g. operator pasted a bare overlay
                # name without the prefix, or a kernel cmdline flag).
                # Warn but allow override — there are obscure valid
                # forms (gpio=, hdmi_force_hotplug=, etc.) we'd hate
                # to block hard.
                if [[ ! "$custom" =~ ^(dtoverlay|dtparam)= ]]; then
                    warn "Line doesn't start with dtoverlay= or dtparam=: $custom"
                    if ! read -r -p "Use anyway? [y/N] " confirm; then
                        confirm=""
                    fi
                    [[ "$confirm" =~ ^[Yy]$ ]] || continue
                fi
                custom_overlays+=("$custom")
            done
            if (( ${#custom_overlays[@]} == 0 )); then
                err "No overlay lines entered; aborting."
                return 1
            fi
            handle_recipe "$hat_7_id" "$hat_7_name" "${custom_overlays[@]}"
            ;;
        q|Q|"")
            info "no changes; bye"
            return 0
            ;;
        *)
            err "Unknown choice: $choice"
            return 1
            ;;
    esac
}

# handle_recipe <hat_id> <display_name> [overlay-1 ...]
# Common path after the menu: print the recipe + record the candidate.
# configApplied / ipLinkUp are set from observed state so re-running
# after applying the recipe updates the flags.
handle_recipe() {
    local hat_id=$1 display_name=$2
    shift 2
    local overlays=("$@")
    local bitrate=250000

    # configApplied: any non-empty existing_overlays counts as "operator
    # already started." We deliberately don't try to match exact overlay
    # strings — operators tweak oscillator values and interrupt pins.
    local cfg_applied=false
    if [[ -n "$(existing_overlays)" ]]; then
        cfg_applied=true
    fi

    # ipLinkUp: target the specific interface the recipe configures
    # (can0 — every overlay in the catalog declares mcp2515-can0 →
    # can0, and the recipe's networkd file does `Match Name=can0`).
    # Three checks must all pass: interface exists, link is UP,
    # bitrate matches the recipe. Anything weaker treats a `vcan0`
    # test interface or a second-channel `can1` as success when the
    # actual recipe target is down.
    local ip_up=false
    local target_iface="can0"
    local target_state
    target_state=$(can_state "$target_iface")
    if [[ "$target_state" == "UP" || "$target_state" == "UNKNOWN" ]]; then
        # UNKNOWN is the normal state for CAN devices with no link-layer
        # carrier semantics; treat both as live. DOWN is the only state
        # that disqualifies.
        local target_br
        target_br=$(can_bitrate "$target_iface")
        if [[ "$target_br" == "$bitrate" ]]; then
            ip_up=true
        fi
    fi

    print_recipe "$hat_id" "$display_name" "$bitrate" "${overlays[@]}"
    write_candidate "$hat_id" "$display_name" "$bitrate" "$cfg_applied" "$ip_up" "${overlays[@]}"
}

# ─── SLCAN recipe path ────────────────────────────────────────────────
# SLCAN adapters are different: no config.txt edit, no kernel-autoload,
# no systemd-networkd config. Instead `slcand` from can-utils must be
# running on a serial tty to instantiate canX. We emit a systemd
# .service unit so the attachment is durable across reboots.

# print_slcan_recipe <hat_id> <display_name> <tty>
print_slcan_recipe() {
    local hat_id=$1 display_name=$2 tty=$3
    # slcand bitrate codes: 0=10k 1=20k 2=50k 3=100k 4=125k 5=250k
    # 6=500k 7=800k 8=1000k. NMEA 2000 is 250k → -s5.
    local bitrate_code=5

    section "Recipe for ${display_name}"
    echo
    echo "1. Install can-utils (provides slcand and candump). Use your distro's"
    echo "   package manager — the package is named 'can-utils' everywhere:"
    echo
    echo "     Debian / Ubuntu / Raspberry Pi OS:  sudo apt install -y can-utils"
    echo "     Fedora / RHEL / CentOS Stream:      sudo dnf install -y can-utils"
    echo "     Arch / Manjaro:                     sudo pacman -S can-utils"
    echo "     openSUSE:                           sudo zypper in can-utils"
    echo
    echo "2. Create a systemd unit that attaches the tty and brings can0 up:"
    echo
    # Use '<<'\''EOF'\''' so the operator's shell does NOT expand `$i` /
    # `$((i+1))` inside ExecStartPre when they paste the recipe block.
    # With unquoted <<EOF those would expand to empty/zero at paste-time
    # and the unit's wait loop becomes broken.
    echo "     sudo tee /etc/systemd/system/signalk-slcan-can0.service > /dev/null <<'EOF'"
    echo "     [Unit]"
    echo "     Description=SLCAN can0 (NMEA 2000 250 kbit/s)"
    echo
    echo "     [Service]"
    echo "     Type=simple"
    echo "     # Wait up to 30s for the USB-serial tty to enumerate (covers"
    echo "     # cold-boot races where the SLCAN adapter hasn't bound to its"
    echo "     # driver yet). Bounded so a missing adapter fails fast instead"
    echo "     # of waiting out systemd's DefaultTimeoutStartSec=90s silently."
    echo "     ExecStartPre=/bin/sh -c 'i=0; while [ ! -e ${tty} ] && [ \$i -lt 30 ]; do sleep 1; i=\$((i+1)); done; [ -e ${tty} ]'"
    echo "     # -F foreground / -o open / -c close-on-exit / -s5 250 kbit/s"
    echo "     ExecStart=/usr/bin/slcand -F -o -c -s${bitrate_code} ${tty} can0"
    # Bare `ip` (not /usr/sbin/ip): the path varies across distros
    # (Debian /usr/sbin, RHEL /sbin, Arch /usr/bin); systemd's
    # default $PATH for service units includes the standard sbin
    # dirs so resolution works portably.
    echo "     ExecStartPost=ip link set up can0"
    echo "     Restart=on-failure"
    echo "     RestartSec=5"
    echo
    echo "     [Install]"
    echo "     WantedBy=multi-user.target"
    echo "     EOF"
    echo
    echo "     sudo systemctl daemon-reload"
    echo "     sudo systemctl enable --now signalk-slcan-can0.service"
    echo
    echo "3. Verify:"
    echo
    echo "     systemctl status signalk-slcan-can0.service"
    echo "     ip -br link show type can     # can0 should be UP"
    echo "     candump can0                  # NMEA 2000 traffic should appear"
    echo
    echo "After verifying, re-run 'signalk socketcan' (the interactive flow)"
    echo "to refresh hardware.json with the now-applied state."
    echo "('signalk socketcan status' is read-only — it shows current state but"
    echo " does not write to hardware.json.)"
    echo
    echo "Recipe id: ${hat_id}    Bitrate: 250000    tty: ${tty}"
}

# handle_slcan_recipe <hat_id> <display_name> <tty>
handle_slcan_recipe() {
    local hat_id=$1 display_name=$2 tty=$3
    local bitrate=250000

    # configApplied for SLCAN: a signalk-slcan-* service unit exists.
    # Best-effort detection — false negatives are fine (operator may
    # have used a different unit name) but a true positive is
    # informative.
    local cfg_applied=false
    if systemctl list-unit-files 'signalk-slcan-*' 2>/dev/null \
        | grep -q '\.service'; then
        cfg_applied=true
    fi

    # ipLinkUp: same can0 + UP/UNKNOWN + bitrate gate as handle_recipe.
    local ip_up=false
    local target_state
    target_state=$(can_state "can0")
    if [[ "$target_state" == "UP" || "$target_state" == "UNKNOWN" ]]; then
        local target_br
        target_br=$(can_bitrate "can0")
        if [[ "$target_br" == "$bitrate" ]]; then
            ip_up=true
        fi
    fi

    print_slcan_recipe "$hat_id" "$display_name" "$tty"
    # write_candidate is shared — we pass no overlays (configTxtOverlays
    # stays []) since SLCAN doesn't use config.txt. The systemd unit
    # path lives in the recipe text only; hardware.json doesn't track it.
    write_candidate "$hat_id" "$display_name" "$bitrate" "$cfg_applied" "$ip_up"
}

# ─── dispatch ──────────────────────────────────────────────────────────

case "${1:-}" in
    ""|interactive)        cmd_interactive ;;
    status)                cmd_status ;;
    help|--help|-h)        usage ;;
    *)
        err "Unknown subcommand: $1"
        usage
        exit 1
        ;;
esac
